<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ shop.name }}</title>
  {{ content_for_header }}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700&family=Outfit:wght@400;600;700&display=swap" rel="stylesheet">
  {{ 'theme.css' | asset_url | stylesheet_tag }}
  <style>
    :root {
      --color-bg: {{ settings.color_bg }};
      --color-bg-deep: {{ settings.color_bg_deep }};
      --color-surface: {{ settings.color_surface }};
      --color-surface-2: {{ settings.color_surface_2 }};
      --color-fg: {{ settings.color_fg }};
      --color-muted: {{ settings.color_muted }};
      --color-neon: {{ settings.color_neon }};
      --color-violet: {{ settings.color_violet }};
      --color-teal: {{ settings.color_teal }};
      --color-foil: {{ settings.color_foil }};
      --color-ink: {{ settings.color_ink }};
      --color-border: {{ settings.color_border }};
      --color-primary: {{ settings.color_primary }};
      --color-primary-ink: {{ settings.color_primary_ink }};
      --radius-card: 0.9rem;
    }
  </style>
</head>
<body>
  <main id="MainContent">
    {{ content_for_layout }}
  </main>
</body>
</html>

{% render 'section-bg', section: section %}
<section class="section text-images" style="padding-top: {{ section.settings.pad_top }}px; padding-bottom: {{ section.settings.pad_bottom }}px;">
  <div class="wrap">
    <div class="canvas" style="--canvas-h: {{ section.settings.height }}px;">
      {% for block in section.blocks %}
        {% if block.type == 'image' %}
          {% liquid
            assign alt = block.settings.alt
            if alt == blank and block.settings.image != blank
              assign alt = block.settings.image.alt
            endif
            if alt == blank
              assign alt = shop.name
            endif
            assign ratio = block.settings.ratio
          %}
          <div class="canvas-item place-{{ block.settings.place }}{% if block.settings.ratio_lock == false %} is-unlocked{% endif %}{% if ratio != 'natural' %} has-ratio{% endif %}" style="--ix: {{ block.settings.x }}px; --iy: {{ block.settings.y }}px; --iw: {{ block.settings.width_px | default: 480 }}px; --ih: {{ block.settings.height_px | default: 480 }}px; --iz: {{ block.settings.z }}; --img-ratio: {{ ratio }}; --img-fit: {{ block.settings.fit }}; --img-pos: {{ block.settings.crop_x }} {{ block.settings.crop_y }};" {{ block.shopify_attributes }}>
            <div class="image-cell {% if block.settings.show_cell == false %}is-clear{% else %}fill-{{ block.settings.cell_fill }}{% endif %} depth-{{ block.settings.cell_depth }}" style="--cell-border: {{ block.settings.border_width }}px; --cell-border-color: {{ block.settings.border_color }}; --fill: {{ block.settings.cell_color }}; --fill-2: {{ block.settings.cell_color_2 }}; --fill-angle: {{ block.settings.cell_angle }}deg; --depth: {{ block.settings.cell_depth_amount }}px; --depth-color: {{ block.settings.cell_depth_color }};">
              {% if block.settings.image != blank %}
                {% if block.settings.link != blank %}
                  <a href="{{ block.settings.link }}">{{ block.settings.image | image_url: width: 1600 | image_tag: alt: alt, loading: 'lazy' }}</a>
                {% else %}
                  {{ block.settings.image | image_url: width: 1600 | image_tag: alt: alt, loading: 'lazy' }}
                {% endif %}
              {% else %}
                <div class="image-empty">Add an image</div>
              {% endif %}
            </div>
          </div>
        {% elsif block.type == 'text' %}
          <div class="canvas-text" style="--ix: {{ block.settings.x }}px; --iy: {{ block.settings.y }}px; --iw: {{ block.settings.width }}%; --iz: {{ block.settings.z }}; --th: {% if block.settings.box_h > 0 %}{{ block.settings.box_h }}px{% else %}auto{% endif %};" {{ block.shopify_attributes }}>
            <div class="rte keep-lead" style="{% render 'field-style', font: block.settings.font, bold: block.settings.bold, italic: block.settings.italic, align: block.settings.align, valign: block.settings.valign, fill: block.settings.fill, fill_2: block.settings.fill_2, color: block.settings.color, size: block.settings.size, depth: block.settings.depth, amount: block.settings.depth_amount, shadow: block.settings.depth_color %}">{{ block.settings.text }}</div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>


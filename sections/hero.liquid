<section class="hero-section">
  <div class="wrap hero">
    <div class="hero-copy">
      {% if section.settings.kicker != blank %}
        <p class="kicker" style="{% render 'field-style', font: section.settings.kicker_font, color: section.settings.kicker_color, size: section.settings.kicker_size, depth: section.settings.kicker_depth, amount: section.settings.kicker_depth_amount, shadow: section.settings.kicker_depth_color %}"><span class="live-dot"></span> {{ section.settings.kicker }}</p>
      {% endif %}
      <h1 class="display hero-title" style="{% render 'field-style', font: section.settings.heading_font, color: section.settings.heading_color, size: section.settings.heading_size, depth: section.settings.heading_depth, amount: section.settings.heading_depth_amount, shadow: section.settings.heading_depth_color %}">{{ section.settings.heading }}</h1>
      {% if section.settings.text != blank %}
        <p class="lede" style="{% render 'field-style', font: section.settings.text_font, color: section.settings.text_color, size: section.settings.text_size, depth: section.settings.text_depth, amount: section.settings.text_depth_amount, shadow: section.settings.text_depth_color %}">{{ section.settings.text }}</p>
      {% endif %}
      <div class="hero-actions">
        {% if section.settings.button_label != blank %}
          <a class="btn btn-primary" href="{{ section.settings.button_link }}" style="{% render 'field-style', font: section.settings.button_label_font, color: section.settings.button_label_color, size: section.settings.button_label_size, depth: section.settings.button_label_depth, amount: section.settings.button_label_depth_amount, shadow: section.settings.button_label_depth_color %}">{{ section.settings.button_label }}</a>
        {% endif %}
        {% if section.settings.button_2_label != blank %}
          <a class="btn btn-ghost" href="{{ section.settings.button_2_link }}" style="{% render 'field-style', font: section.settings.button_2_label_font, color: section.settings.button_2_label_color, size: section.settings.button_2_label_size, depth: section.settings.button_2_label_depth, amount: section.settings.button_2_label_depth_amount, shadow: section.settings.button_2_label_depth_color %}">{{ section.settings.button_2_label }}</a>
        {% endif %}
      </div>
      <ul class="hero-stats">
        <li><strong>Thu–Sat</strong><span>Show nights</span></li>
        <li><strong>9:30</strong><span>PM Eastern</span></li>
        <li><strong>Sealed</strong><span>Wax and spots</span></li>
      </ul>
    </div>
    <div
      class="stage stage-fit-{{ section.settings.stage_fit }}"
      aria-hidden="true"
      style="--stage-w: {{ section.settings.stage_width }}%; --stage-h: {{ section.settings.stage_height }}px; --stage-fit: {{ section.settings.stage_fit }}; --stage-x: {{ section.settings.stage_x }}; --stage-y: {{ section.settings.stage_y }}; --stage-pos: {% if section.settings.stage_x == 'start' %}left{% elsif section.settings.stage_x == 'end' %}right{% else %}center{% endif %} {% if section.settings.stage_y == 'start' %}top{% elsif section.settings.stage_y == 'end' %}bottom{% else %}center{% endif %};"
    >
      {% if section.settings.stage_image != blank %}
        {{ section.settings.stage_image | image_url: width: 1600 | image_tag: class: 'stage-photo', alt: section.settings.stage_label, widths: '400, 800, 1200, 1600' }}
      {% else %}
        {% capture stage_label_style %}{% render 'field-style', font: section.settings.stage_label_font, color: section.settings.stage_label_color, size: section.settings.stage_label_size, depth: section.settings.stage_label_depth, amount: section.settings.stage_label_depth_amount, shadow: section.settings.stage_label_depth_color %}{% endcapture %}
        {% render 'wax', style: 'crystal', label: section.settings.stage_label, label_style: stage_label_style %}
      {% endif %}
      <div class="stage-lower">
        <span class="live-dot"></span>
        <span style="{% render 'field-style', font: section.settings.lower_font, color: section.settings.lower_color, size: section.settings.lower_size, depth: section.settings.lower_depth, amount: section.settings.lower_depth_amount, shadow: section.settings.lower_depth_color %}">{{ section.settings.lower }}</span>
      </div>
    </div>
  </div>
</section>


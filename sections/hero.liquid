{% render 'section-bg', section: section %}
<section class="hero-section" style="padding-top: {{ section.settings.pad_top }}px; padding-bottom: {{ section.settings.pad_bottom }}px;">
  <div class="wrap hero">
    <div class="hero-copy">
      {% if section.settings.kicker != blank %}
        <p class="kicker" style="{% render 'field-style', font: section.settings.kicker_font, bold: section.settings.kicker_bold, italic: section.settings.kicker_italic, align: section.settings.kicker_align, valign: section.settings.kicker_valign, fill: section.settings.kicker_fill, fill_2: section.settings.kicker_fill_2, color: section.settings.kicker_color, size: section.settings.kicker_size, depth: section.settings.kicker_depth, amount: section.settings.kicker_depth_amount, shadow: section.settings.kicker_depth_color %}"><span class="live-dot"></span> {{ section.settings.kicker }}</p>
      {% endif %}
      <h1 class="display hero-title" style="{% render 'field-style', font: section.settings.heading_font, bold: section.settings.heading_bold, italic: section.settings.heading_italic, align: section.settings.heading_align, valign: section.settings.heading_valign, fill: section.settings.heading_fill, fill_2: section.settings.heading_fill_2, color: section.settings.heading_color, size: section.settings.heading_size, depth: section.settings.heading_depth, amount: section.settings.heading_depth_amount, shadow: section.settings.heading_depth_color %}">{{ section.settings.heading }}</h1>
      {% if section.settings.text != blank %}
        <p class="lede" style="{% render 'field-style', font: section.settings.text_font, bold: section.settings.text_bold, italic: section.settings.text_italic, align: section.settings.text_align, valign: section.settings.text_valign, fill: section.settings.text_fill, fill_2: section.settings.text_fill_2, color: section.settings.text_color, size: section.settings.text_size, depth: section.settings.text_depth, amount: section.settings.text_depth_amount, shadow: section.settings.text_depth_color %}">{{ section.settings.text }}</p>
      {% endif %}
      <div class="hero-actions">
        {% if section.settings.button_label != blank %}
          <a class="btn btn-primary" href="{{ section.settings.button_link }}" style="{% render 'field-style', font: section.settings.button_label_font, bold: section.settings.button_label_bold, italic: section.settings.button_label_italic, align: section.settings.button_label_align, valign: section.settings.button_label_valign, fill: section.settings.button_label_fill, fill_2: section.settings.button_label_fill_2, color: section.settings.button_label_color, size: section.settings.button_label_size, depth: section.settings.button_label_depth, amount: section.settings.button_label_depth_amount, shadow: section.settings.button_label_depth_color %}">{{ section.settings.button_label }}</a>
        {% endif %}
        {% if section.settings.button_2_label != blank %}
          <a class="btn btn-ghost" href="{{ section.settings.button_2_link }}" style="{% render 'field-style', font: section.settings.button_2_label_font, bold: section.settings.button_2_label_bold, italic: section.settings.button_2_label_italic, align: section.settings.button_2_label_align, valign: section.settings.button_2_label_valign, fill: section.settings.button_2_label_fill, fill_2: section.settings.button_2_label_fill_2, color: section.settings.button_2_label_color, size: section.settings.button_2_label_size, depth: section.settings.button_2_label_depth, amount: section.settings.button_2_label_depth_amount, shadow: section.settings.button_2_label_depth_color %}">{{ section.settings.button_2_label }}</a>
        {% endif %}
      </div>
      <ul class="hero-stats">
        <li><strong>Thu–Sat</strong><span>Show nights</span></li>
        <li><strong>9:30</strong><span>PM Eastern</span></li>
        <li><strong>Sealed</strong><span>Wax and spots</span></li>
      </ul>
    </div>
    {% liquid
      assign feed = section.settings.feed_url
      assign yid = ''
      assign twitch = ''
      if feed contains 'watch?v='
        assign yid = feed | split: 'watch?v=' | last | split: '&' | first
      elsif feed contains 'youtu.be/'
        assign yid = feed | split: 'youtu.be/' | last | split: '?' | first
      elsif feed contains 'youtube.com/live/'
        assign yid = feed | split: '/live/' | last | split: '?' | first
      elsif feed contains 'youtube.com/embed/'
        assign yid = feed | split: '/embed/' | last | split: '?' | first
      elsif feed contains 'twitch.tv/'
        assign twitch = feed | replace: 'https://www.twitch.tv/', '' | replace: 'http://www.twitch.tv/', '' | replace: '@', '' | split: '/' | first | split: '?' | first
      endif
      assign room = section.settings.whatnot_url | default: settings.whatnot_url
    %}
    <div class="stage-row" style="--stage-h: {{ section.settings.stage_height }}px;">
    <div
      class="stage stage-fit-{{ section.settings.stage_fit }}"
      aria-hidden="true"
      style="--stage-w: {{ section.settings.stage_width }}%; --stage-h: {{ section.settings.stage_height }}px; --stage-fit: {{ section.settings.stage_fit }}; --stage-x: {{ section.settings.stage_x }}; --stage-y: {{ section.settings.stage_y }}; --stage-pos: {% if section.settings.stage_x == 'start' %}left{% elsif section.settings.stage_x == 'end' %}right{% else %}center{% endif %} {% if section.settings.stage_y == 'start' %}top{% elsif section.settings.stage_y == 'end' %}bottom{% else %}center{% endif %};"
    >
      {% if section.settings.stage_image != blank %}
        {{ section.settings.stage_image | image_url: width: 1600 | image_tag: class: 'stage-photo', alt: section.settings.stage_label, widths: '400, 800, 1200, 1600' }}
      {% else %}
        {% capture stage_label_style %}{% render 'field-style', font: section.settings.stage_label_font, bold: section.settings.stage_label_bold, italic: section.settings.stage_label_italic, align: section.settings.stage_label_align, valign: section.settings.stage_label_valign, fill: section.settings.stage_label_fill, fill_2: section.settings.stage_label_fill_2, color: section.settings.stage_label_color, size: section.settings.stage_label_size, depth: section.settings.stage_label_depth, amount: section.settings.stage_label_depth_amount, shadow: section.settings.stage_label_depth_color %}{% endcapture %}
        {% render 'wax', style: 'crystal', label: section.settings.stage_label, label_style: stage_label_style %}
      {% endif %}
      <div class="stage-lower">
        <span class="live-dot"></span>
        <span style="{% render 'field-style', font: section.settings.lower_font, bold: section.settings.lower_bold, italic: section.settings.lower_italic, align: section.settings.lower_align, valign: section.settings.lower_valign, fill: section.settings.lower_fill, fill_2: section.settings.lower_fill_2, color: section.settings.lower_color, size: section.settings.lower_size, depth: section.settings.lower_depth, amount: section.settings.lower_depth_amount, shadow: section.settings.lower_depth_color %}">{{ section.settings.lower }}</span>
      </div>
    </div>
    <div class="stage stage-feed">
      {% if section.settings.show_live and yid != blank %}
        <iframe src="https://www.youtube.com/embed/{{ yid | escape }}?rel=0&autoplay=1" title="Live show" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>
      {% elsif section.settings.show_live and twitch != blank %}
        <iframe src="https://player.twitch.tv/?channel={{ twitch | url_encode }}&parent={{ request.host }}" title="Live show" allowfullscreen></iframe>
      {% elsif section.settings.show_live %}
        <div class="feed-card is-live">
          <span class="live-dot"></span>
          <p class="kicker">Live</p>
          <p>Whatnot is on. Their player cannot run inside this site.</p>
          {% if room != blank %}
            <a class="btn btn-primary" href="{{ room }}" target="_blank" rel="noreferrer">Watch the feed</a>
          {% endif %}
        </div>
      {% else %}
        <div class="feed-card">
          <span class="live-dot is-off"></span>
          <p class="kicker">Offline</p>
          <p>{{ section.settings.offline_label | default: 'Thu–Sat 9:30 PM ET' }}</p>
          {% if room != blank %}
            <a class="btn btn-ghost" href="{{ room }}" target="_blank" rel="noreferrer">Whatnot room</a>
          {% endif %}
        </div>
      {% endif %}
    </div>
    </div>
  </div>
</section>


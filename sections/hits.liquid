<section class="section">
  <div class="wrap">
    <header class="section-head">
      <div>
        {% if section.settings.kicker != blank %}<p class="kicker" style="{% render 'field-style', color: section.settings.kicker_color, size: section.settings.kicker_size, depth: section.settings.kicker_depth, amount: section.settings.kicker_depth_amount, shadow: section.settings.kicker_depth_color %}">{{ section.settings.kicker }}</p>{% endif %}
        <h2 class="display" style="{% render 'field-style', color: section.settings.heading_color, size: section.settings.heading_size, depth: section.settings.heading_depth, amount: section.settings.heading_depth_amount, shadow: section.settings.heading_depth_color %}">{{ section.settings.heading }}</h2>
      </div>
    </header>
    <ul class="hit-list">
      {% for block in section.blocks %}
        <li class="panel" style="padding:0.8rem 0.9rem" {{ block.shopify_attributes }}>
          <strong style="{% render 'field-style', color: block.settings.title_color, size: block.settings.title_size, depth: block.settings.title_depth, amount: block.settings.title_depth_amount, shadow: block.settings.title_depth_color %}">{{ block.settings.title }}</strong>
          {% if block.settings.detail != blank %}<p class="fine" style="{% render 'field-style', color: block.settings.detail_color, size: block.settings.detail_size, depth: block.settings.detail_depth, amount: block.settings.detail_depth_amount, shadow: block.settings.detail_depth_color %}">{{ block.settings.detail }}</p>{% endif %}
        </li>
      {% endfor %}
    </ul>
  </div>
</section>


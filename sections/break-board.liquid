<section class="section">
  <div class="wrap">
    <header class="section-head">
      <div>
        {% if section.settings.kicker != blank %}<p class="kicker" style="{% render 'field-style', font: section.settings.kicker_font, bold: section.settings.kicker_bold, italic: section.settings.kicker_italic, align: section.settings.kicker_align, valign: section.settings.kicker_valign, fill: section.settings.kicker_fill, fill_2: section.settings.kicker_fill_2, color: section.settings.kicker_color, size: section.settings.kicker_size, depth: section.settings.kicker_depth, amount: section.settings.kicker_depth_amount, shadow: section.settings.kicker_depth_color %}">{{ section.settings.kicker }}</p>{% endif %}
        <h2 class="display" style="{% render 'field-style', font: section.settings.heading_font, bold: section.settings.heading_bold, italic: section.settings.heading_italic, align: section.settings.heading_align, valign: section.settings.heading_valign, fill: section.settings.heading_fill, fill_2: section.settings.heading_fill_2, color: section.settings.heading_color, size: section.settings.heading_size, depth: section.settings.heading_depth, amount: section.settings.heading_depth_amount, shadow: section.settings.heading_depth_color %}">{{ section.settings.heading }}</h2>
      </div>
      {% if section.settings.product != blank %}
        <a class="nav-link" href="{{ section.settings.product.url }}">Open break</a>
      {% endif %}
    </header>

    {% capture board_title_style %}{% render 'field-style', font: section.settings.board_title_font, bold: section.settings.board_title_bold, italic: section.settings.board_title_italic, align: section.settings.board_title_align, valign: section.settings.board_title_valign, fill: section.settings.board_title_fill, fill_2: section.settings.board_title_fill_2, color: section.settings.board_title_color, size: section.settings.board_title_size, depth: section.settings.board_title_depth, amount: section.settings.board_title_depth_amount, shadow: section.settings.board_title_depth_color %}{% endcapture %}
    {% if section.settings.product != blank %}
      {% render 'spot-board',
        product: section.settings.product,
        title: section.settings.board_title,
        title_style: board_title_style,
        format: section.settings.format,
        show_prices: section.settings.show_prices,
        show_host: section.settings.show_host
      %}
    {% elsif section.settings.show_demo %}
      <div class="spot-board" data-wheel>
        <div class="spot-head">
          <span style="{{ board_title_style }}">{{ section.settings.board_title | default: 'Sample board' }}</span>
          <span>3 / 16 filled</span>
        </div>
        <div class="fillbar" aria-hidden="true"><span style="width:19%"></span></div>
        <div class="spot-grid">
          {% for i in (1..16) %}
            {% assign num = i %}
            {% if i < 10 %}{% assign num = i | prepend: '0' %}{% endif %}
            {% if i == 3 or i == 8 or i == 12 %}
              <div class="spot-cell is-sold"><strong>#{{ num }} Spot</strong><em>Sold</em></div>
            {% else %}
              <div class="spot-cell is-open"><strong>#{{ num }} Spot</strong><em>Empty</em></div>
            {% endif %}
          {% endfor %}
        </div>
        <p class="spot-note">
          {% if request.design_mode %}
            Sample board. Not for sale. Choose a break product in this section. Each variant is a spot, inventory 1, variant name is the team or slot. Tag the product break so its product page uses the same board.
          {% else %}
            Sample board. These spots are not for sale.
          {% endif %}
        </p>
        <div class="desk" data-desk {% unless section.settings.show_host %}hidden{% endunless %}>
          <p class="kicker">Break desk · this screen only</p>
          <div class="desk-row">
            <button class="btn btn-primary" type="button" data-spin>Spin open spots</button>
            <p class="muted" data-spin-result aria-live="polite"></p>
          </div>
          <form data-hit-form class="desk-row">
            <label class="fine" style="flex:1;min-width:12rem">
              Call a hit
              <input class="field" name="hit" placeholder="Team — player, parallel" autocomplete="off">
            </label>
            <button class="btn btn-ghost" type="submit">Show on this screen</button>
          </form>
          <ul class="hit-list" data-hit-list></ul>
          <p class="fine">Add <code>?desk=1</code> to the page URL in OBS. Shoppers do not see this desk.</p>
        </div>
      </div>
    {% endif %}
  </div>
</section>


<section class="section">
  <div class="wrap">
    <header class="section-head">
      <div>
        {% if section.settings.kicker != blank %}<p class="kicker" style="{% render 'field-style', color: section.settings.kicker_color, size: section.settings.kicker_size, depth: section.settings.kicker_depth, amount: section.settings.kicker_depth_amount, shadow: section.settings.kicker_depth_color %}">{{ section.settings.kicker }}</p>{% endif %}
        <h2 class="display" style="{% render 'field-style', color: section.settings.heading_color, size: section.settings.heading_size, depth: section.settings.heading_depth, amount: section.settings.heading_depth_amount, shadow: section.settings.heading_depth_color %}">{{ section.settings.heading }}</h2>
      </div>
    </header>
    <p class="muted" style="margin-bottom:1rem;{% render 'field-style', color: section.settings.note_color, size: section.settings.note_size, depth: section.settings.note_depth, amount: section.settings.note_depth_amount, shadow: section.settings.note_depth_color %}">{{ section.settings.note }}</p>
    <div class="grid-cards">
      {% if section.settings.collection != blank %}
        {% for product in section.settings.collection.products limit: 8 %}
          {% render 'auction-card', product: product %}
        {% endfor %}
      {% else %}
        {% assign shown = 0 %}
        {% for product in collections.all.products %}
          {% if shown < 8 and product.tags contains 'auction' %}
            {% render 'auction-card', product: product %}
            {% assign shown = shown | plus: 1 %}
          {% endif %}
        {% endfor %}
        {% if shown == 0 and request.design_mode %}
          <p class="muted">Tag lots <strong>auction</strong>, or pick a collection. Price is the current ask. Optional metafield <strong>custom.ends_at</strong> draws the countdown.</p>
        {% endif %}
      {% endif %}
    </div>

    <div class="panel" style="padding:1rem;margin-top:1rem">
      <p class="kicker">Send a bid</p>
      <p class="fine" style="margin:0.35rem 0 0.7rem">This emails the shop. It does not reserve the lot. Buy now above is the only hold.</p>
      {% form 'contact' %}
        {% if form.posted_successfully? %}
          <p>Bid sent. We’ll reply if the lot is still open.</p>
        {% else %}
          {{ form.errors | default_errors }}
          <div class="buy">
            <input class="field" type="email" name="contact[email]" placeholder="Email" aria-label="Email" required>
            <input class="field" type="text" name="contact[name]" placeholder="Lot and amount" aria-label="Lot and amount" required>
            <textarea class="field" name="contact[body]" rows="4" placeholder="Name, lot, bid" aria-label="Bid"></textarea>
            <button class="btn btn-ghost" type="submit">Send bid</button>
          </div>
        {% endif %}
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Auction lots",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "No sniping app"
    },
    {
      "type": "color",
      "id": "kicker_color",
      "label": "Kicker color",
      "default": "#00e5ff"
    },
    {
      "type": "range",
      "id": "kicker_size",
      "label": "Kicker size",
      "min": 10,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "select",
      "id": "kicker_depth",
      "label": "Kicker depth",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "soft",
          "label": "Soft shadow"
        },
        {
          "value": "hard",
          "label": "Hard offset"
        },
        {
          "value": "neon",
          "label": "Neon glow"
        }
      ]
    },
    {
      "type": "range",
      "id": "kicker_depth_amount",
      "label": "Kicker depth amount",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "color",
      "id": "kicker_depth_color",
      "label": "Kicker depth color",
      "default": "#00e5ff"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Auctions"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#f4fbff"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 10,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "select",
      "id": "heading_depth",
      "label": "Heading depth",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "soft",
          "label": "Soft shadow"
        },
        {
          "value": "hard",
          "label": "Hard offset"
        },
        {
          "value": "neon",
          "label": "Neon glow"
        }
      ]
    },
    {
      "type": "range",
      "id": "heading_depth_amount",
      "label": "Heading depth amount",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "color",
      "id": "heading_depth_color",
      "label": "Heading depth color",
      "default": "#00e5ff"
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Note",
      "default": "The price is the current ask. Change it on the product. A countdown appears when the product has metafield custom.ends_at. A theme cannot run a live bidding war by itself \u2014 Buy now checks out at that price. Send a bid emails the shop."
    },
    {
      "type": "color",
      "id": "note_color",
      "label": "Note color",
      "default": "#8eafbf"
    },
    {
      "type": "range",
      "id": "note_size",
      "label": "Note size",
      "min": 10,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "note_depth",
      "label": "Note depth",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "soft",
          "label": "Soft shadow"
        },
        {
          "value": "hard",

        },
        {
          "value": "neon",
          "label": "Neon glow"
        }
      ]
    },
    {
      "type": "range",
      "id": "note_depth_amount",
      "label": "Note depth amount",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "color",
      "id": "note_depth_color",
      "label": "Note depth color",
      "default": "#00e5ff"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Lots",
      "info": "Or tag products auction."
    }
  ],
  "presets": [
    {
      "name": "Auction lots"
    }
  ]
}
{% endschema %}

{% render 'section-bg', section: section %}
<section class="section" style="padding-top: {{ section.settings.pad_top }}px; padding-bottom: {{ section.settings.pad_bottom }}px;">
  <div class="wrap">
    <header class="section-head">
      <div>
        {% if section.settings.kicker != blank %}<p class="kicker" style="{% render 'field-style', font: section.settings.kicker_font, bold: section.settings.kicker_bold, italic: section.settings.kicker_italic, align: section.settings.kicker_align, valign: section.settings.kicker_valign, fill: section.settings.kicker_fill, fill_2: section.settings.kicker_fill_2, color: section.settings.kicker_color, size: section.settings.kicker_size, depth: section.settings.kicker_depth, amount: section.settings.kicker_depth_amount, shadow: section.settings.kicker_depth_color %}">{{ section.settings.kicker }}</p>{% endif %}
        <h2 class="display" style="{% render 'field-style', font: section.settings.heading_font, bold: section.settings.heading_bold, italic: section.settings.heading_italic, align: section.settings.heading_align, valign: section.settings.heading_valign, fill: section.settings.heading_fill, fill_2: section.settings.heading_fill_2, color: section.settings.heading_color, size: section.settings.heading_size, depth: section.settings.heading_depth, amount: section.settings.heading_depth_amount, shadow: section.settings.heading_depth_color %}">{{ section.settings.heading }}</h2>
      </div>
    </header>
    <p class="muted" style="margin-bottom:1rem;{% render 'field-style', font: section.settings.note_font, bold: section.settings.note_bold, italic: section.settings.note_italic, align: section.settings.note_align, valign: section.settings.note_valign, fill: section.settings.note_fill, fill_2: section.settings.note_fill_2, color: section.settings.note_color, size: section.settings.note_size, depth: section.settings.note_depth, amount: section.settings.note_depth_amount, shadow: section.settings.note_depth_color %}">{{ section.settings.note }}</p>
    <div class="grid-cards">
      {% if section.settings.collection != blank %}
        {% for product in section.settings.collection.products limit: 8 %}
          {% render 'auction-card', product: product %}
        {% endfor %}
      {% else %}
        {% assign shown = 0 %}
        {% for product in collections.all.products %}
          {% if shown < 8 and product.tags contains 'auction' %}
            {% render 'auction-card', product: product %}
            {% assign shown = shown | plus: 1 %}
          {% endif %}
        {% endfor %}
        {% if shown == 0 and request.design_mode %}
          <p class="muted">Tag lots <strong>auction</strong>, or pick a collection. Price is the current ask. Optional metafield <strong>custom.ends_at</strong> draws the countdown.</p>
        {% endif %}
      {% endif %}
    </div>

    <div class="panel" style="padding:1rem;margin-top:1rem">
      <p class="kicker">Send a bid</p>
      <p class="fine" style="margin:0.35rem 0 0.7rem">This emails the shop. It does not reserve the lot. Buy now above is the only hold.</p>
      {% form 'contact' %}
        {% if form.posted_successfully? %}
          <p>Bid sent. We’ll reply if the lot is still open.</p>
        {% else %}
          {{ form.errors | default_errors }}
          <div class="buy">
            <input class="field" type="email" name="contact[email]" placeholder="Email" aria-label="Email" required>
            <input class="field" type="text" name="contact[name]" placeholder="Lot and amount" aria-label="Lot and amount" required>
            <textarea class="field" name="contact[body]" rows="4" placeholder="Name, lot, bid" aria-label="Bid"></textarea>
            <button class="btn btn-ghost" type="submit">Send bid</button>
          </div>
        {% endif %}
      {% endform %}
    </div>
  </div>
</section>


<section class="section">
  <div class="wrap">
    <header class="section-head">
      <div>
        {% if section.settings.kicker != blank %}<p class="kicker">{{ section.settings.kicker }}</p>{% endif %}
        <h2 class="display">{{ section.settings.heading }}</h2>
      </div>
    </header>
    <p class="muted" style="margin-bottom:1rem">{{ section.settings.note }}</p>
    <div class="grid-cards">
      {% if section.settings.collection != blank %}
        {% for product in section.settings.collection.products limit: 8 %}
          {% render 'auction-card', product: product %}
        {% endfor %}
      {% else %}
        {% assign shown = 0 %}
        {% for product in collections.all.products %}
          {% if shown < 8 and product.tags contains 'auction' %}
            {% render 'auction-card', product: product %}
            {% assign shown = shown | plus: 1 %}
          {% endif %}
        {% endfor %}
        {% if shown == 0 and request.design_mode %}
          <p class="muted">Tag lots <strong>auction</strong>, or pick a collection. Price is the current ask. Optional metafield <strong>custom.ends_at</strong> draws the countdown.</p>
        {% endif %}
      {% endif %}
    </div>

    <div class="panel" style="padding:1rem;margin-top:1rem">
      <p class="kicker">Send a bid</p>
      <p class="fine" style="margin:0.35rem 0 0.7rem">This emails the shop. It does not reserve the lot. Buy now above is the only hold.</p>
      {% form 'contact' %}
        {% if form.posted_successfully? %}
          <p>Bid sent. We’ll reply if the lot is still open.</p>
        {% else %}
          {{ form.errors | default_errors }}
          <div class="buy">
            <input class="field" type="email" name="contact[email]" placeholder="Email" aria-label="Email" required>
            <input class="field" type="text" name="contact[name]" placeholder="Lot and amount" aria-label="Lot and amount" required>
            <textarea class="field" name="contact[body]" rows="4" placeholder="Name, lot, bid" aria-label="Bid"></textarea>
            <button class="btn btn-ghost" type="submit">Send bid</button>
          </div>
        {% endif %}
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Auction lots",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "No sniping app" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Auctions" },
    { "type": "textarea", "id": "note", "label": "Note", "default": "The price is the current ask. Change it on the product. A countdown appears when the product has metafield custom.ends_at. A theme cannot run a live bidding war by itself — Buy now checks out at that price. Send a bid emails the shop." },
    { "type": "collection", "id": "collection", "label": "Lots", "info": "Or tag products auction." }
  ],
  "presets": [{ "name": "Auction lots" }]
}
{% endschema %}

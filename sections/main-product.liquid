{% render 'section-bg', section: section %}
{% liquid
  assign is_break = false
  if product.tags contains 'break' or product.tags contains 'pack-wars'
    assign is_break = true
  endif
  assign format = 'teams'
  if product.tags contains 'pack-wars'
    assign format = 'packs'
  endif
%}
<section class="section" style="padding-top: {{ section.settings.pad_top }}px; padding-bottom: {{ section.settings.pad_bottom }}px;">
  <div class="wrap product-layout">
    <div>
      {% if product.media.size > 0 %}
        {% for media in product.media limit: 5 %}
          {% if media.media_type == 'image' %}
            <div class="panel product-photo">
              {% assign photo_alt = media.alt | default: product.title %}
              {{ media | image_url: width: 1400 | image_tag: loading: 'lazy', alt: photo_alt }}
            </div>
          {% endif %}
        {% endfor %}
      {% else %}
        {% assign wax_label = product.type | default: 'Wax' %}
        <div class="panel">{% render 'wax', style: 'ice', label: wax_label %}</div>
      {% endif %}
    </div>
    <div>
      {% if product.type != blank %}<p class="kicker">{{ product.type }}</p>{% endif %}
      <h1 class="display">{{ product.title }}</h1>
      <p class="price" style="margin-top:0.45rem">
        {% if product.price_varies %}From {% endif %}{{ product.price | money }}
      </p>
      {% if is_break %}
        <div style="margin-top:1rem">
          {% render 'spot-board', product: product, title: product.title, format: format, show_prices: section.settings.show_prices, show_host: section.settings.show_host %}
        </div>
      {% else %}
        {% form 'product', product, class: 'js-cart' %}
          <div class="buy">
            {% if product.variants.size > 1 %}
              <label class="fine" for="Variant-{{ section.id }}">Option</label>
              <select class="field" id="Variant-{{ section.id }}" name="id">
                {% for variant in product.variants %}
                  <option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %}>
                    {{ variant.title }} — {{ variant.price | money }}{% unless variant.available %} (Sold out){% endunless %}
                  </option>
                {% endfor %}
              </select>
            {% else %}
              <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
            {% endif %}
            <div class="qty">
              <input class="field" type="number" name="quantity" value="1" min="1" aria-label="Quantity">
              <button class="btn btn-primary" type="submit" {% unless product.available %}disabled{% endunless %}>
                {% if product.available %}Add to cart{% else %}Sold out{% endif %}
              </button>
            </div>
            <p class="fine" data-form-note></p>
            {{ form | payment_button }}
          </div>
        {% endform %}
      {% endif %}
      {% if product.description != blank %}
        <div class="rte" style="margin-top:1.2rem">{{ product.description }}</div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product",
  "settings": [
    {
      "type": "select",
      "id": "edit_group",
      "label": "Edit",
      "default": "content",
      "options": [
        {
          "value": "content",
          "label": "Content"
        },
        {
          "value": "background",
          "label": "Background"
        },
        {
          "value": "section_space",
          "label": "Section space"
        }
      ],
      "info": "Opens that group. Pick another title to switch."
    },
    {
      "type": "checkbox",
      "id": "show_prices",
      "label": "Show a price on each break spot",
      "default": false,
      "visible_if": "{{ section.settings.edit_group == 'content' }}"
    },
    {
      "type": "checkbox",
      "id": "show_host",
      "label": "Show the break desk to everyone",
      "default": false,
      "info": "Leave off. Add ?desk=1 in OBS to spin and call hits on a product tagged break or pack-wars.",
      "visible_if": "{{ section.settings.edit_group == 'content' }}"
    },
    {
      "type": "header",
      "content": "Background",
      "visible_if": "{{ section.settings.edit_group == 'background' }}"
    },
    {
      "type": "select",
      "id": "sec_fill",
      "label": "Fill",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "tide",
          "label": "Tide"
        },
        {
          "value": "violet",
          "label": "Violet night"
        },
        {
          "value": "foil",
          "label": "Foil sweep"
        },
        {
          "value": "sunset",
          "label": "Sunset"
        },
        {
          "value": "aurora",
          "label": "Aurora"
        },
        {
          "value": "pulse",
          "label": "Neon pulse"
        },
        {
          "value": "lava",
          "label": "Lava"
        },
        {
          "value": "chrome",
          "label": "Chrome"
        },
        {
          "value": "prism",
          "label": "Prism"
        },
        {
          "value": "electric",
          "label": "Electric"
        },
        {
          "value": "holo",
          "label": "Hologram"
        },
        {
          "value": "wave",
          "label": "Wave"
        },
        {
          "value": "goldrush",
          "label": "Gold rush"
        },
        {
          "value": "current",
          "label": "Current"
        },
        {
          "value": "ember",
          "label": "Ember"
        },
        {
          "value": "sheen",
          "label": "Sheen"
        },
        {
          "value": "glass",
          "label": "Glass"
        },
        {
          "value": "mesh",
          "label": "Mesh glow"
        },
        {
          "value": "custom",
          "label": "Custom gradient"
        }
      ],
      "info": "Foil, Aurora, Neon pulse, and the fills after Neon pulse animate.",
      "visible_if": "{{ section.settings.edit_group == 'background' }}"
    },
    {
      "type": "range",
      "id": "sec_fill_speed",
      "label": "Fill speed",
      "min": 1,
      "max": 8,
      "step": 1,
      "default": 1,
      "info": "1 is that fill's normal pace. 8 is eight times faster. Only animated fills use this.",
      "visible_if": "{{ section.settings.edit_group == 'background' }}"
    },
    {
      "type": "range",
      "id": "sec_fill_duration",
      "label": "Fill duration",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "s",
      "default": 0,
      "info": "0 keeps that fill's own timing. Any other number is how long one sweep takes, before speed.",
      "visible_if": "{{ section.settings.edit_group == 'background' }}"
    },
    {
      "type": "range",
      "id": "sec_fill_power",
      "label": "Fill intensity",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 5,
      "info": "How wide the sweep is. 5 matches the original. Higher is stronger.",
      "visible_if": "{{ section.settings.edit_group == 'background' }}"
    },
    {
      "type": "color",
      "id": "sec_fill_color",
      "label": "Fill color",
      "default": "#0E1C28",
      "info": "Solid, glass, mesh, and custom gradient.",
      "visible_if": "{{ section.settings.edit_group == 'background' }}"
    },
    {
      "type": "color",
      "id": "sec_fill_color_2",
      "label": "Second color",

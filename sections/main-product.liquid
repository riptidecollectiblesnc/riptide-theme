        {
          "value": "deep-tide",
          "label": "Deep tide"
        },
        {
          "value": "horizon",
          "label": "Neon horizon"
        },
        {
          "value": "foil-sweep",
          "label": "Foil sweep"
        },
        {
          "value": "nebula",
          "label": "Violet nebula"
        },
        {
          "value": "grid",
          "label": "Night grid"
        },
        {
          "value": "bubbles",
          "label": "Bubble field"
        },
        {
          "value": "aurora-sheet",
          "label": "Aurora sheet"
        },
        {
          "value": "slab",
          "label": "Slab glow"
        },
        {
          "value": "storm",
          "label": "Storm glass"
        }
      ],

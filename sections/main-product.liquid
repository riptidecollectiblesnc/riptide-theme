      "label": "Image motion",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "ken",
          "label": "Ken Burns"
        },
        {
          "value": "drift",
          "label": "Drift"
        },
        {
          "value": "rise",
          "label": "Rise"
        },
        {
          "value": "breathe",
          "label": "Breathe"
        },
        {
          "value": "float",
          "label": "Float"
        },
        {
          "value": "sheen",
          "label": "Sheen"
        },
        {
          "value": "tide",
          "label": "Tide glow"
        },
        {
          "value": "spotlight",
          "label": "Spotlight"
        },
        {
          "value": "holo",
          "label": "Holo shift"
        }
      ],

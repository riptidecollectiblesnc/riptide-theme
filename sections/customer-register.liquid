{% render 'section-bg', section: section %}
<section class="section" style="padding-top: {{ section.settings.pad_top }}px; padding-bottom: {{ section.settings.pad_bottom }}px;">
  <div class="wrap" style="max-width:440px">
    <h1 class="display">Create account</h1>
    {% form 'create_customer' %}
      <div class="buy">
        {{ form.errors | default_errors }}
        <input class="field" type="text" name="customer[first_name]" placeholder="First name" aria-label="First name" autocomplete="given-name">
        <input class="field" type="text" name="customer[last_name]" placeholder="Last name" aria-label="Last name" autocomplete="family-name">
        <input class="field" type="email" name="customer[email]" placeholder="Email" aria-label="Email" autocomplete="email" required>
        <input class="field" type="password" name="customer[password]" placeholder="Password" aria-label="Password" autocomplete="new-password" required>
        <button class="btn btn-primary" type="submit">Create</button>
        <a class="nav-link" href="{{ routes.account_login_url }}">Already have an account</a>
      </div>
    {% endform %}
  </div>
</section>


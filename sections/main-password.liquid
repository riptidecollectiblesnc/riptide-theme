<section class="section">
  <div class="wrap" style="max-width:460px;padding-top:8vh">
    <span class="mark" aria-hidden="true"></span>
    <h1 class="display" style="font-size:3rem;margin-top:0.8rem">{{ shop.name }}</h1>
    <p class="muted" style="margin-top:0.6rem">{{ shop.password_message | default: 'The shop is closed while we set the new floor.' }}</p>
    {% form 'storefront_password' %}
      <div class="buy" style="margin-top:1rem">
        {{ form.errors | default_errors }}
        <label class="fine" for="Password">Password</label>
        <input class="field" type="password" name="password" id="Password" autocomplete="current-password">
        <button class="btn btn-primary" type="submit">Enter</button>
      </div>
    {% endform %}
  </div>
</section>

{% schema %}
{ "name": "Password", "settings": [] }
{% endschema %}

<section class="section" style="padding-top: {{ section.settings.pad_top }}px; padding-bottom: {{ section.settings.pad_bottom }}px;">
  <div class="wrap" style="max-width:460px;padding-top:8vh">
    <span class="mark" aria-hidden="true"></span>
    <h1 class="display" style="font-size:3rem;margin-top:0.8rem">{{ shop.name }}</h1>
    <p class="muted" style="margin-top:0.6rem">{{ shop.password_message | default: 'The shop is closed while we set the new floor.' }}</p>
    {% form 'storefront_password' %}
      <div class="buy" style="margin-top:1rem">
        {{ form.errors | default_errors }}
        <label class="fine" for="Password">Password</label>
        <input class="field" type="password" name="password" id="Password" autocomplete="current-password">
        <button class="btn btn-primary" type="submit">Enter</button>
      </div>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Password",
  "settings": [
    {
      "type": "header",
      "content": "Section space"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Top space",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 52,
      "info": "Space above and below this section."
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Bottom space",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 52,
      "info": "Space above and below this section."
    }
  ]
}
{% endschema %}

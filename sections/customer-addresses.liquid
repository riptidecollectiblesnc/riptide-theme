{% render 'section-bg', section: section %}
<section class="section" style="padding-top: {{ section.settings.pad_top }}px; padding-bottom: {{ section.settings.pad_bottom }}px;">
  <div class="wrap" style="max-width:640px">
    <header class="section-head">
      <h1 class="display">Addresses</h1>
      <a class="nav-link" href="{{ routes.account_url }}">Account</a>
    </header>
    {% for address in customer.addresses %}
      <div class="panel" style="padding:0.9rem;margin-bottom:0.7rem">
        {{ address | format_address }}
        {% form 'customer_address', address %}
          <div class="buy" style="margin-top:0.6rem">
            {{ form.errors | default_errors }}
            <input class="field" name="address[first_name]" value="{{ form.first_name }}" aria-label="First name">
            <input class="field" name="address[last_name]" value="{{ form.last_name }}" aria-label="Last name">
            <input class="field" name="address[address1]" value="{{ form.address1 }}" aria-label="Address">
            <input class="field" name="address[address2]" value="{{ form.address2 }}" aria-label="Apartment">
            <input class="field" name="address[city]" value="{{ form.city }}" aria-label="City">
            <input class="field" name="address[zip]" value="{{ form.zip }}" aria-label="ZIP">
            <input class="field" name="address[phone]" value="{{ form.phone }}" aria-label="Phone">
            <select class="field" name="address[country]" aria-label="Country" data-default="{{ form.country }}">{{ all_country_option_tags }}</select>
            <button class="btn btn-primary" type="submit">Save</button>
          </div>
        {% endform %}
        <form method="post" action="{{ routes.account_addresses_url }}/{{ address.id }}" style="margin-top:0.4rem">
          <input type="hidden" name="_method" value="delete">
          <button class="btn btn-ghost" type="submit">Delete</button>
        </form>
      </div>
    {% endfor %}
    <h2 class="display" style="font-size:1.8rem;margin-top:1rem">New address</h2>
    {% form 'customer_address', customer.new_address %}
      <div class="buy">
        {{ form.errors | default_errors }}
        <input class="field" name="address[first_name]" placeholder="First name" aria-label="First name">
        <input class="field" name="address[last_name]" placeholder="Last name" aria-label="Last name">
        <input class="field" name="address[address1]" placeholder="Address" aria-label="Address">
        <input class="field" name="address[city]" placeholder="City" aria-label="City">
        <input class="field" name="address[zip]" placeholder="ZIP" aria-label="ZIP">
        <select class="field" name="address[country]" aria-label="Country">{{ all_country_option_tags }}</select>
        <button class="btn btn-primary" type="submit">Add address</button>
      </div>
    {% endform %}
  </div>
</section>

{% schema %}
{
  "name": "Addresses",
  "settings": [
    {
      "type": "select",
      "id": "edit_group",
      "label": "Edit",
      "default": "background",
      "options": [
        {
          "value": "background",
          "label": "Background"
        },
        {
          "value": "section_space",
          "label": "Section space"
        }
      ],
      "info": "Opens that group. Pick another title to switch."
    },
    {
      "type": "header",
      "content": "Background",
      "visible_if": "{{ section.settings.edit_group == 'background' }}"
    },
    {
      "type": "select",
      "id": "sec_fill",
      "label": "Fill",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "tide",
          "label": "Tide"
        },
        {
          "value": "violet",
          "label": "Violet night"
        },
        {
          "value": "foil",
          "label": "Foil sweep"
        },
        {
          "value": "sunset",
          "label": "Sunset"
        },
        {
          "value": "aurora",
          "label": "Aurora"
        },
        {
          "value": "pulse",
          "label": "Neon pulse"
        },
        {
          "value": "glass",
          "label": "Glass"
        },
        {
          "value": "mesh",
          "label": "Mesh glow"
        },
        {
          "value": "custom",
          "label": "Custom gradient"
        }
      ],
      "info": "None leaves the section as it is. Foil, Aurora, and Neon pulse animate.",
      "visible_if": "{{ section.settings.edit_group == 'background' }}"
    },
    {
      "type": "color",
      "id": "sec_fill_color",
      "label": "Fill color",
      "default": "#0E1C28",
      "info": "Solid, glass, mesh, and custom gradient.",
      "visible_if": "{{ section.settings.edit_group == 'background' }}"
    },
    {
      "type": "color",
      "id": "sec_fill_color_2",
      "label": "Second color",
      "default": "#00E5FF",
      "info": "Used by Custom gradient.",
      "visible_if": "{{ section.settings.edit_group == 'background' }}"
    },
    {
      "type": "range",
      "id": "sec_angle",
      "label": "Gradient angle",
      "min": 0,
      "max": 360,
      "step": 15,
      "unit": "deg",
      "default": 90,
      "info": "Used by Custom gradient.",
      "visible_if": "{{ section.settings.edit_group == 'background' }}"
    },
    {
      "type": "select",
      "id": "sec_preset",
      "label": "Image preset",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "deep-tide",
          "label": "Deep tide"
        },
        {
          "value": "horizon",
          "label": "Neon horizon"
        },
        {
          "value": "foil-sweep",
          "label": "Foil sweep"
        },
        {
          "value": "nebula",
          "label": "Violet nebula"
        },
        {
          "value": "grid",
          "label": "Night grid"
        },
        {
          "value": "bubbles",
          "label": "Bubble field"
        },
        {
          "value": "aurora-sheet",
          "label": "Aurora sheet"
        },
        {
          "value": "slab",
          "label": "Slab glow"
        },
        {
          "value": "storm",
          "label": "Storm glass"
        }
      ],
      "info": "Painted art behind the section. Foil sweep and Aurora sheet animate.",
      "visible_if": "{{ section.settings.edit_group == 'background' }}"
    },
    {
      "type": "image_picker",
      "id": "sec_image",
      "label": "Background image",
      "info": "Optional photo. Sits on top of the fill and preset.",
      "visible_if": "{{ section.settings.edit_group == 'background' }}"
    },
    {
      "type": "header",
      "content": "Section space",
      "visible_if": "{{ section.settings.edit_group == 'section_space' }}"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Top space",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 52,
      "info": "Space above and below this section.",
      "visible_if": "{{ section.settings.edit_group == 'section_space' }}"
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Bottom space",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 52,
      "info": "Space above and below this section.",
      "visible_if": "{{ section.settings.edit_group == 'section_space' }}"
    }
  ]
}
{% endschema %}

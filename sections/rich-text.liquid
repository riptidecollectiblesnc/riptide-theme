<section class="section rich-section" style="padding-top: {{ section.settings.pad_top }}px; padding-bottom: {{ section.settings.pad_bottom }}px;">
  <div class="wrap" style="max-width: {{ section.settings.width }}px;">
    {% if section.settings.heading != blank %}
      <h2 class="display keep-lead" style="{% render 'field-style', font: section.settings.heading_font, bold: section.settings.heading_bold, italic: section.settings.heading_italic, align: section.settings.heading_align, valign: section.settings.heading_valign, fill: section.settings.heading_fill, fill_2: section.settings.heading_fill_2, color: section.settings.heading_color, size: section.settings.heading_size, depth: section.settings.heading_depth, amount: section.settings.heading_depth_amount, shadow: section.settings.heading_depth_color %}">{% render 'keep-space', text: section.settings.heading %}</h2>
    {% endif %}
    {% if section.settings.body != blank %}
      <div class="rte keep-lead" style="{% render 'field-style', font: section.settings.body_font, bold: section.settings.body_bold, italic: section.settings.body_italic, align: section.settings.body_align, valign: section.settings.body_valign, fill: section.settings.body_fill, fill_2: section.settings.body_fill_2, color: section.settings.body_color, size: section.settings.body_size, depth: section.settings.body_depth, amount: section.settings.body_depth_amount, shadow: section.settings.body_depth_color %}">{{ section.settings.body }}</div>
    {% endif %}
  </div>
</section>


{% render 'section-bg', section: section %}
<section class="section" style="padding-top: {{ section.settings.pad_top }}px; padding-bottom: {{ section.settings.pad_bottom }}px;">
  <div class="wrap" style="max-width:440px">
    <h1 class="display">Login</h1>
    {% form 'customer_login' %}
      <div class="buy">
        {{ form.errors | default_errors }}
        <label class="fine" for="CustomerEmail">Email</label>
        <input class="field" type="email" name="customer[email]" id="CustomerEmail" autocomplete="email" required>
        <label class="fine" for="CustomerPassword">Password</label>
        <input class="field" type="password" name="customer[password]" id="CustomerPassword" autocomplete="current-password">
        <button class="btn btn-primary" type="submit">Sign in</button>
        <a class="nav-link" href="{{ routes.account_register_url }}">Create account</a>
        <a class="nav-link" href="#recover">Forgot password</a>
      </div>
    {% endform %}
    <div id="recover" style="margin-top:1.5rem">
      <h2 class="display" style="font-size:1.8rem">Reset password</h2>
      {% form 'recover_customer_password' %}
        <div class="buy">
          {{ form.errors | default_errors }}
          {% if form.posted_successfully? %}<p>Check your email for a reset link.</p>{% endif %}
          <input class="field" type="email" name="email" aria-label="Email" autocomplete="email" required>
          <button class="btn btn-ghost" type="submit">Email reset link</button>
        </div>
      {% endform %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Login",
  "settings": [
    {
      "type": "select",
      "id": "edit_group",
      "label": "Edit",
      "default": "background",
      "options": [
        {
          "value": "background",
          "label": "Background"
        },
        {
          "value": "section_space",
          "label": "Section space"
        }
      ],
      "info": "Opens that group. Pick another title to switch."
    },
    {
      "type": "header",
      "content": "Background",
      "visible_if": "{{ section.settings.edit_group == 'background' }}"
    },
    {
      "type": "select",
      "id": "sec_fill",
      "label": "Fill",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "tide",
          "label": "Tide"
        },
        {
          "value": "violet",
          "label": "Violet night"
        },
        {
          "value": "foil",
          "label": "Foil sweep"
        },
        {
          "value": "sunset",
          "label": "Sunset"
        },
        {
          "value": "aurora",
          "label": "Aurora"
        },
        {
          "value": "pulse",
          "label": "Neon pulse"
        },
        {
          "value": "glass",
          "label": "Glass"
        },
        {
          "value": "mesh",
          "label": "Mesh glow"
        },
        {
          "value": "custom",
          "label": "Custom gradient"
        }
      ],
      "info": "None leaves the section as it is. Foil, Aurora, and Neon pulse animate.",
      "visible_if": "{{ section.settings.edit_group == 'background' }}"
    },
    {
      "type": "color",
      "id": "sec_fill_color",
      "label": "Fill color",
      "default": "#0E1C28",
      "info": "Solid, glass, mesh, and custom gradient.",
      "visible_if": "{{ section.settings.edit_group == 'background' }}"
    },
    {
      "type": "color",
      "id": "sec_fill_color_2",
      "label": "Second color",
      "default": "#00E5FF",
      "info": "Used by Custom gradient.",
      "visible_if": "{{ section.settings.edit_group == 'background' }}"
    },
    {
      "type": "range",
      "id": "sec_angle",
      "label": "Gradient angle",
      "min": 0,
      "max": 360,
      "step": 15,
      "unit": "deg",
      "default": 90,
      "info": "Used by Custom gradient.",
      "visible_if": "{{ section.settings.edit_group == 'background' }}"
    },
    {
      "type": "select",
      "id": "sec_preset",
      "label": "Image preset",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "deep-tide",
          "label": "Deep tide"
        },
        {
          "value": "horizon",
          "label": "Neon horizon"
        },
        {
          "value": "foil-sweep",
          "label": "Foil sweep"
        },
        {
          "value": "nebula",
          "label": "Violet nebula"
        },
        {
          "value": "grid",
          "label": "Night grid"
        },
        {
          "value": "bubbles",
          "label": "Bubble field"
        },
        {
          "value": "aurora-sheet",
          "label": "Aurora sheet"
        },
        {
          "value": "slab",
          "label": "Slab glow"
        },
        {
          "value": "storm",
          "label": "Storm glass"
        }
      ],
      "info": "Painted art behind the section. Foil sweep and Aurora sheet animate.",
      "visible_if": "{{ section.settings.edit_group == 'background' }}"
    },
    {
      "type": "image_picker",
      "id": "sec_image",
      "label": "Background image",
      "info": "Optional photo. Sits on top of the fill and preset.",
      "visible_if": "{{ section.settings.edit_group == 'background' }}"
    },
    {
      "type": "header",
      "content": "Section space",
      "visible_if": "{{ section.settings.edit_group == 'section_space' }}"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Top space",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 52,
      "info": "Space above and below this section.",
      "visible_if": "{{ section.settings.edit_group == 'section_space' }}"
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Bottom space",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 52,
      "info": "Space above and below this section.",
      "visible_if": "{{ section.settings.edit_group == 'section_space' }}"
    }
  ]
}
{% endschema %}

{% liquid
  assign logo_w = section.settings.logo_width | default: 160
  assign logo_h = section.settings.logo_height | default: 56
  assign logo_w_m = section.settings.logo_width_mobile | default: 120
  assign logo_h_m = section.settings.logo_height_mobile | default: 44
%}
{% capture menu_style %}{% render 'field-style', font: section.settings.menu_font, bold: section.settings.menu_bold, italic: section.settings.menu_italic, fill: section.settings.menu_fill, size: section.settings.menu_size, depth: section.settings.menu_depth, amount: section.settings.menu_depth_amount %}{% endcapture %}
<header class="site-header{% if section.settings.sticky %} is-sticky{% endif %}" style="--bar-h: {{ section.settings.bar_height }}px; --logo-w: {{ logo_w }}px; --logo-h: {{ logo_h }}px; --logo-w-m: {{ logo_w_m }}px; --logo-h-m: {{ logo_h_m }}px;">
  <div class="wrap bar{% if section.settings.logo_align == 'center' %} is-center{% endif %}">
    <button class="icon-btn menu-btn" type="button" data-menu-open aria-label="Open menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
    <a class="brand" href="{{ routes.root_url }}">
      <span class="logo-frame">
        {% if section.settings.logo != blank %}
          <img
            class="logo"
            src="{{ section.settings.logo | image_url: width: 800 }}"
            alt="{{ shop.name | escape }}"
            width="{{ logo_w }}"
            height="{{ logo_h }}"
          >
        {% else %}
          <span class="mark" aria-hidden="true"></span>
        {% endif %}
      </span>
      {% if section.settings.show_name %}
        <span class="shop-name">{{ shop.name }}</span>
      {% endif %}
    </a>
    <nav class="desk-nav" aria-label="Primary">
      {% if section.settings.menu != blank %}
        {% for link in section.settings.menu.links %}
          <a class="nav-link{% if link.current %} is-on{% endif %}" style="{{ menu_style }}" href="{{ link.url }}">{{ link.title }}</a>
        {% endfor %}
      {% else %}
        <a class="nav-link" style="{{ menu_style }}" href="{{ routes.all_products_collection_url }}">Shop</a>
        <a class="nav-link" style="{{ menu_style }}" href="{{ routes.root_url }}#shopify-section-breaks">Breaks</a>
        <a class="nav-link" style="{{ menu_style }}" href="{{ routes.root_url }}#shopify-section-live">Live</a>
        <a class="nav-link" style="{{ menu_style }}" href="{{ routes.root_url }}#shopify-section-auctions">Auctions</a>
        <a class="nav-link" style="{{ menu_style }}" href="{{ routes.root_url }}#shopify-section-hits">Hits</a>
        <a class="nav-link" style="{{ menu_style }}" href="{{ routes.root_url }}#shopify-section-whatnot">Whatnot</a>
      {% endif %}
    </nav>
    <form class="search" action="{{ routes.search_url }}" method="get" role="search">
      <input class="field" type="search" name="q" placeholder="Search wax" aria-label="Search">
      <input type="hidden" name="type" value="product">
    </form>
    {% if shop.customer_accounts_enabled %}
      <a class="icon-btn" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" aria-label="Account">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="8" r="3.2"/><path d="M5 19c1.4-3 3.8-4.5 7-4.5S17.6 16 19 19"/></svg>
      </a>
    {% endif %}
    <a class="icon-btn cart-link" href="{{ routes.cart_url }}" aria-label="Cart">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 7h12l-1 13H7L6 7z"/><path d="M9 7a3 3 0 0 1 6 0"/></svg>
      <span class="count" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
    </a>
  </div>
</header>

<div class="mobile-menu" data-menu hidden>
  <div class="sheet panel">
    <div class="sheet-top">
      <p class="display" style="font-size:1.8rem">Menu</p>
      <button class="icon-btn" type="button" data-menu-close aria-label="Close menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    <form action="{{ routes.search_url }}" method="get" role="search">
      <input class="field" type="search" name="q" placeholder="Search wax and breaks" aria-label="Search">
      <input type="hidden" name="type" value="product">
    </form>
    {% if section.settings.menu != blank %}
      {% for link in section.settings.menu.links %}
        <a class="nav-link" style="{{ menu_style }}" href="{{ link.url }}">{{ link.title }}</a>
      {% endfor %}
    {% else %}
      <a class="nav-link" href="{{ routes.all_products_collection_url }}">Shop</a>
      <a class="nav-link" href="{{ routes.root_url }}#shopify-section-breaks">Breaks</a>
      <a class="nav-link" href="{{ routes.root_url }}#shopify-section-live">Live</a>
      <a class="nav-link" href="{{ routes.root_url }}#shopify-section-auctions">Auctions</a>
      <a class="nav-link" href="{{ routes.root_url }}#shopify-section-hits">Hits</a>
      <a class="nav-link" href="{{ routes.root_url }}#shopify-section-whatnot">Whatnot</a>
    {% endif %}
    <a class="nav-link" style="{{ menu_style }}" href="{{ routes.cart_url }}">Cart</a>
  </div>
</div>

<nav class="bottom-nav" aria-label="Mobile">
  <a href="{{ routes.all_products_collection_url }}">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16v12H4z"/><path d="M8 7V5a4 4 0 0 1 8 0v2"/></svg>
    <span style="{{ menu_style }}">Shop</span>
  </a>
  <a href="{{ routes.root_url }}#shopify-section-breaks">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="4" y="4" width="6" height="6"/><rect x="14" y="4" width="6" height="6"/><rect x="4" y="14" width="6" height="6"/><rect x="14" y="14" width="6" height="6"/></svg>
    <span style="{{ menu_style }}">Breaks</span>
  </a>
  <a href="{{ routes.root_url }}#shopify-section-live">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M6 12a6 6 0 0 1 0-1M18 12a6 6 0 0 0 0-1"/></svg>
    <span style="{{ menu_style }}">Live</span>
  </a>
  <a href="{{ routes.root_url }}#shopify-section-auctions">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 14l6-6 4 4 6-7"/><path d="M14 5h6v6"/></svg>
    <span style="{{ menu_style }}">Bids</span>
  </a>
  <a href="{{ routes.cart_url }}">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 7h12l-1 13H7L6 7z"/><path d="M9 7a3 3 0 0 1 6 0"/></svg>
    <span style="{{ menu_style }}">Cart</span>
  </a>
</nav>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "header",
      "content": "Menu text"
    },
    {
      "type": "select",
      "id": "menu_font",
      "label": "Menu font",
      "default": "inherit",
      "options": [
        {
          "value": "inherit",
          "label": "Theme default"
        },
        {
          "value": "Unbounded, sans-serif",
          "label": "Unbounded"
        },
        {
          "value": "Outfit, sans-serif",
          "label": "Outfit"
        },
        {
          "value": "\"Barlow Condensed\", sans-serif",
          "label": "Barlow Condensed"
        },
        {
          "value": "\"Bebas Neue\", sans-serif",
          "label": "Bebas Neue"
        },
        {
          "value": "Oswald, sans-serif",
          "label": "Oswald"
        },
        {
          "value": "Anton, sans-serif",
          "label": "Anton"
        },
        {
          "value": "Archivo, sans-serif",
          "label": "Archivo"
        },
        {
          "value": "Inter, sans-serif",
          "label": "Inter"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "menu_bold",
      "label": "Menu bold",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "menu_italic",
      "label": "Menu italic",
      "default": false
    },
    {
      "type": "range",
      "id": "menu_size",
      "label": "Menu size",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "menu_fill",
      "label": "Menu fill",
      "default": "solid",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "tide",
          "label": "Tide"
        },
        {
          "value": "violet",
          "label": "Violet"
        },
        {
          "value": "foil",
          "label": "Foil"
        },
        {
          "value": "sunset",
          "label": "Sunset"
        },
        {
          "value": "aurora",
          "label": "Aurora"
        },
        {
          "value": "pulse",
          "label": "Neon pulse"
        },
        {
          "value": "custom",
          "label": "Custom gradient"
        }
      ],
      "info": "Gradient is painted on the letters. Solid uses the menu color."
    },
    {
      "type": "select",
      "id": "menu_depth",
      "label": "Menu depth",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "soft",
          "label": "Soft shadow"
        },
        {
          "value": "hard",
          "label": "Hard offset"
        },
        {
          "value": "lift",
          "label": "Lift"
        },
        {
          "value": "long",
          "label": "Long shadow"
        },
        {
          "value": "echo",
          "label": "Echo"
        },
        {
          "value": "press",
          "label": "Letterpress"
        },
        {
          "value": "emboss",
          "label": "Emboss"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "neon",
          "label": "Neon glow"
        },
        {
          "value": "double",
          "label": "Double glow"
        },
        {
          "value": "foil",
          "label": "Foil"
        }
      ]
    },
    {
      "type": "range",
      "id": "menu_depth_amount",
      "label": "Menu depth amount",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "sticky",
      "label": "Sticky header",
      "default": true,
      "info": "The bar stays full width. The logo and menu sit in the center 90%."
    },
    {
      "type": "range",
      "id": "bar_height",
      "label": "Bar height",
      "min": 48,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 64,
      "info": "Makes the bar taller. The logo still uses its own size, so the bar will not get shorter than the logo."
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 40,
      "max": 444,
      "step": 4,
      "unit": "px",
      "default": 160,
      "info": "This is the size you see in the theme editor."
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height",
      "min": 24,
      "max": 226,
      "step": 2,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "logo_width_mobile",
      "label": "Phone logo width",
      "min": 40,
      "max": 280,
      "step": 4,
      "unit": "px",
      "default": 140,
      "info": "Only applies on screens under 480px. The theme editor uses Logo width and Logo height."
    },
    {
      "type": "range",
      "id": "logo_height_mobile",
      "label": "Logo height on mobile",
      "min": 24,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "select",
      "id": "logo_align",
      "label": "Logo position",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centered"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_name",
      "label": "Show shop name next to the logo",
      "default": true
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "info": "Leave empty to use Shop, Breaks, Live, Auctions, Hits, and Whatnot."
    }
  ]
}
{% endschema %}

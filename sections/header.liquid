        <a class="nav-link" href="{{ routes.root_url }}#shopify-section-hits"><span style="{{ menu_style }}">Hits</span></a>
        <a class="nav-link" href="{{ routes.root_url }}#shopify-section-whatnot"><span style="{{ menu_style }}">Whatnot</span></a>
      {% endif %}
    </nav>
    <form class="search" action="{{ routes.search_url }}" method="get" role="search">
      <input class="field" type="search" name="q" placeholder="Search Website" aria-label="Search">
      <input type="hidden" name="type" value="product">
    </form>
    {% if shop.customer_accounts_enabled %}
      <a class="icon-btn account-link{% if section.settings.account_label != blank %} has-label{% endif %} align-{{ section.settings.account_align | default: 'center' }} valign-{{ section.settings.account_valign | default: 'middle' }}" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" aria-label="{{ section.settings.account_label | default: 'Account' | escape }}">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="8" r="3.2"/><path d="M5 19c1.4-3 3.8-4.5 7-4.5S17.6 16 19 19"/></svg>
        {% if section.settings.account_label != blank %}<span class="btn-label" style="{{ account_style }}">{{ section.settings.account_label }}</span>{% endif %}
      </a>
    {% endif %}
    <a class="icon-btn cart-link{% if section.settings.cart_label != blank %} has-label{% endif %} align-{{ section.settings.cart_align | default: 'center' }} valign-{{ section.settings.cart_valign | default: 'middle' }}" href="{{ routes.cart_url }}" aria-label="{{ section.settings.cart_label | default: 'Cart' | escape }}">

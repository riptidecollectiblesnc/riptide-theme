{% render 'section-bg', section: section %}
{% liquid
  assign logo_w = section.settings.logo_width | default: 160
  assign logo_h = section.settings.logo_height | default: 56
  assign logo_w_m = section.settings.logo_width_mobile | default: 120
  assign logo_h_m = section.settings.logo_height_mobile | default: 44
  assign logo_x = section.settings.logo_x | default: 0
  assign logo_y = section.settings.logo_y | default: 0
  assign logo_x_m = section.settings.logo_x_mobile | default: 0
  assign logo_y_m = section.settings.logo_y_mobile | default: 0
  case section.settings.menu_align_h
    when 'left'
      assign menu_h = 'flex-start'
    when 'right'
      assign menu_h = 'flex-end'
    else
      assign menu_h = 'center'
  endcase
  case section.settings.menu_align_v
    when 'top'
      assign menu_v = 'flex-start'
    when 'bottom'
      assign menu_v = 'flex-end'
    else
      assign menu_v = 'center'
  endcase
  case section.settings.top_align_h
    when 'left'
      assign top_h = 'flex-start'
    when 'right'
      assign top_h = 'flex-end'
    else
      assign top_h = 'center'
  endcase
  case section.settings.top_align_v
    when 'top'
      assign top_v = 'flex-start'
    when 'bottom'
      assign top_v = 'flex-end'
    else
      assign top_v = 'center'
  endcase
  assign top_is_bold = false
  assign top_is_italic = false
  if section.settings.top_bold or section.settings.top_font_style == 'bold' or section.settings.top_font_style == 'bold_italic'
    assign top_is_bold = true
  endif
  if section.settings.top_italic or section.settings.top_font_style == 'italic' or section.settings.top_font_style == 'bold_italic'
    assign top_is_italic = true
  endif
%}
{% capture menu_style %}{% render 'field-style', font: section.settings.menu_font, bold: section.settings.menu_bold, italic: section.settings.menu_italic, fill: section.settings.menu_fill, fill_2: section.settings.menu_fill_2, color: section.settings.menu_color, size: section.settings.menu_size, depth: section.settings.menu_depth, amount: section.settings.menu_depth_amount, shadow: section.settings.menu_depth_color %}{% endcapture %}
{% capture top_style %}{% render 'field-style', font: section.settings.top_font, bold: top_is_bold, italic: top_is_italic, fill: section.settings.top_fill, fill_2: section.settings.top_fill_2, color: section.settings.top_color, size: section.settings.top_size, depth: section.settings.top_depth, amount: section.settings.top_depth_amount, shadow: section.settings.top_depth_color %}{% endcapture %}
{% capture account_style %}{% render 'field-style', font: section.settings.account_font, bold: section.settings.account_bold, italic: section.settings.account_italic, align: section.settings.account_align, valign: section.settings.account_valign, fill: section.settings.account_fill, fill_2: section.settings.account_fill_2, color: section.settings.account_color, size: section.settings.account_size, depth: section.settings.account_depth, amount: section.settings.account_depth_amount, shadow: section.settings.account_depth_color %}{% endcapture %}
{% capture cart_style %}{% render 'field-style', font: section.settings.cart_font, bold: section.settings.cart_bold, italic: section.settings.cart_italic, align: section.settings.cart_align, valign: section.settings.cart_valign, fill: section.settings.cart_fill, fill_2: section.settings.cart_fill_2, color: section.settings.cart_color, size: section.settings.cart_size, depth: section.settings.cart_depth, amount: section.settings.cart_depth_amount, shadow: section.settings.cart_depth_color %}{% endcapture %}
{% style %}
  {% if section.settings.sticky %}
    #shopify-section-group-header-group,
    .shopify-section-group-header-group:has(#shopify-section-{{ section.id }} .is-sticky) {
      position: sticky;
      top: 0;
      z-index: 80;
      background: var(--color-bg);
    }
  {% endif %}
  #shopify-section-{{ section.id }} .top-menu,
  #shopify-section-{{ section.id }} .top-menu .nav-link,
  #shopify-section-{{ section.id }} .nav-link.is-top,
  #shopify-section-{{ section.id }} .nav-link.is-top > span {
    {% if section.settings.top_font != blank and section.settings.top_font != 'inherit' %}font-family: {{ section.settings.top_font | replace: '"', "'" }} !important;{% endif %}
    {% if section.settings.top_size > 0 %}font-size: {{ section.settings.top_size }}px !important;{% endif %}
    line-height: 1 !important;
    {% if top_is_bold %}font-weight: 700 !important;{% endif %}
    {% if top_is_italic %}font-style: italic !important;{% endif %}
  }
  #shopify-section-{{ section.id }} .desk-nav:not(.top-menu) {
    gap: {{ section.settings.menu_gap }}px;
    transform: translate({{ section.settings.menu_x }}px, {{ section.settings.menu_y }}px);
  }
  #shopify-section-{{ section.id }} .sheet .nav-link {
    margin: {{ section.settings.menu_gap | divided_by: 2 }}px 0;
  }
  #shopify-section-{{ section.id }} .desk-nav:not(.top-menu) .nav-link,
  #shopify-section-{{ section.id }} .sheet .nav-link:not(.is-top) {
    border: {{ section.settings.menu_border }}px solid {{ section.settings.menu_border_color }};
    border-radius: 10px;
    padding: {{ section.settings.menu_pad_top }}px {{ section.settings.menu_pad_x }}px {{ section.settings.menu_pad_bottom }}px {{ section.settings.menu_pad_x }}px;
    display: inline-flex;
    justify-content: {{ menu_h }};
    align-items: {{ menu_v }};
    {% if section.settings.menu_cell_height > 0 %}min-height: {{ section.settings.menu_cell_height }}px;{% endif %}
    {% if section.settings.menu_cell_width > 0 %}width: {{ section.settings.menu_cell_width }}px;{% endif %}
    {% case section.settings.menu_cell_fill %}
      {% when 'solid' %}background: {{ section.settings.menu_cell_color }};
      {% when 'tide' %}background-image: linear-gradient(90deg, #042028, #00e5ff 42%, #7af6ff 50%, #00e5ff 58%, #042028);
      {% when 'violet' %}background-image: linear-gradient(100deg, #12061f, #6d1ecc 46%, #00e5ff);
      {% when 'foil' %}background-image: linear-gradient(110deg, #3a2a10, #e4c06a 40%, #fff6d0 50%, #e4c06a 60%, #3a2a10); background-size: 220% 100%;
      {% when 'sunset' %}background-image: linear-gradient(90deg, #3a1020, #ff5a7a 35%, #e4c06a 68%, #6d1ecc);
      {% when 'aurora' %}background-image: linear-gradient(100deg, #042028, #00e5ff, #6d1ecc, #00e5ff); background-size: 220% 100%;
      {% when 'pulse' %}background-image: linear-gradient(90deg, #042028, #00e5ff 50%, #042028); background-size: 220% 100%;
      {% when 'glass' %}background: color-mix(in srgb, {{ section.settings.menu_cell_color }} 28%, transparent);
      {% when 'custom' %}background-image: linear-gradient(90deg, {{ section.settings.menu_cell_color }}, {{ section.settings.menu_cell_color_2 }});
    {% endcase %}
    {% case section.settings.menu_cell_depth %}
      {% when 'soft' %}box-shadow: 0 {{ section.settings.menu_cell_depth_amount }}px {{ section.settings.menu_cell_depth_amount | times: 2 }}px {{ section.settings.menu_cell_depth_color }};
      {% when 'hard' %}box-shadow: {{ section.settings.menu_cell_depth_amount | divided_by: 2 }}px {{ section.settings.menu_cell_depth_amount | divided_by: 2 }}px 0 {{ section.settings.menu_cell_depth_color }};
      {% when 'lift' %}box-shadow: 0 {{ section.settings.menu_cell_depth_amount }}px {{ section.settings.menu_cell_depth_amount | times: 2 }}px {{ section.settings.menu_cell_depth_color }};
      {% when 'neon' %}box-shadow: 0 0 {{ section.settings.menu_cell_depth_amount }}px {{ section.settings.menu_cell_depth_color }};
      {% when 'press' %}box-shadow: inset 0 2px 8px {{ section.settings.menu_cell_depth_color }};
    {% endcase %}
  }
  #shopify-section-{{ section.id }},
  #shopify-section-{{ section.id }} .site-header,
  #shopify-section-{{ section.id }} .bar,
  #shopify-section-{{ section.id }} .desk-nav,
  #shopify-section-{{ section.id }} .nav-item {
    overflow: visible;
  }
  #shopify-section-{{ section.id }} .desk-nav:not(.top-menu):hover {
    position: relative;
    z-index: 40;
  }
  #shopify-section-{{ section.id }} .desk-nav:not(.top-menu) .nav-link:hover,
  #shopify-section-{{ section.id }} .desk-nav:not(.top-menu) .nav-item:hover > .nav-link,
  #shopify-section-{{ section.id }} .desk-nav:not(.top-menu) .nav-item:focus-within > .nav-link {
    {% case section.settings.menu_hover_fill %}
      {% when 'solid' %}background: {{ section.settings.menu_hover_color }};
      {% when 'tide' %}background-image: linear-gradient(90deg, #042028, #00e5ff 42%, #7af6ff 50%, #00e5ff 58%, #042028);
      {% when 'violet' %}background-image: linear-gradient(100deg, #12061f, #6d1ecc 46%, #00e5ff);
      {% when 'foil' %}background-image: linear-gradient(110deg, #3a2a10, #e4c06a 40%, #fff6d0 50%, #e4c06a 60%, #3a2a10); background-size: 220% 100%;
      {% when 'sunset' %}background-image: linear-gradient(90deg, #3a1020, #ff5a7a 35%, #e4c06a 68%, #6d1ecc);
      {% when 'aurora' %}background-image: linear-gradient(100deg, #042028, #00e5ff, #6d1ecc, #00e5ff); background-size: 220% 100%;
      {% when 'pulse' %}background-image: linear-gradient(90deg, #042028, #00e5ff 50%, #042028); background-size: 220% 100%;
      {% when 'glass' %}background: color-mix(in srgb, {{ section.settings.menu_hover_color }} 28%, transparent);
      {% when 'custom' %}background-image: linear-gradient(90deg, {{ section.settings.menu_hover_color }}, {{ section.settings.menu_hover_color_2 }});
      {% else %}background: color-mix(in srgb, {{ section.settings.menu_hover_color }} 28%, transparent);
    {% endcase %}
    {% case section.settings.menu_hover_depth %}
      {% when 'soft' %}box-shadow: 0 {{ section.settings.menu_hover_depth_amount }}px {{ section.settings.menu_hover_depth_amount | times: 2 }}px {{ section.settings.menu_hover_depth_color }};
      {% when 'hard' %}box-shadow: {{ section.settings.menu_hover_depth_amount | divided_by: 2 }}px {{ section.settings.menu_hover_depth_amount | divided_by: 2 }}px 0 {{ section.settings.menu_hover_depth_color }};
      {% when 'lift' %}box-shadow: 0 {{ section.settings.menu_hover_depth_amount }}px {{ section.settings.menu_hover_depth_amount | times: 2 }}px {{ section.settings.menu_hover_depth_color }};
      {% when 'neon' %}box-shadow: 0 0 {{ section.settings.menu_hover_depth_amount }}px {{ section.settings.menu_hover_depth_color }}, 0 0 {{ section.settings.menu_hover_depth_amount | times: 2 }}px {{ section.settings.menu_hover_depth_color }};
      {% when 'press' %}box-shadow: inset 0 2px 8px {{ section.settings.menu_hover_depth_color }};
      {% else %}box-shadow: 0 0 14px {{ section.settings.menu_hover_depth_color }};
    {% endcase %}
  }
  #shopify-section-{{ section.id }} .desk-nav:not(.top-menu) .nav-link:hover > span,
  #shopify-section-{{ section.id }} .desk-nav:not(.top-menu) .nav-item:hover > .nav-link > span,
  #shopify-section-{{ section.id }} .desk-nav:not(.top-menu) .nav-item:focus-within > .nav-link > span {
    color: {{ section.settings.menu_hover_text }} !important;
    -webkit-text-fill-color: {{ section.settings.menu_hover_text }} !important;
    background-image: none !important;
  }
  .section .rte a:hover,
  .section .collection-all:hover,
  .section .lede a:hover,
  .section .muted a:hover,
  .section .fine a:hover {
    color: {{ section.settings.link_hover_color }} !important;
    -webkit-text-fill-color: {{ section.settings.link_hover_color }} !important;
    background-image: none !important;
    {% case section.settings.link_hover_depth %}
      {% when 'soft' %}text-shadow: 0 {{ section.settings.link_hover_amount }}px {{ section.settings.link_hover_amount | times: 2 }}px {{ section.settings.link_hover_depth_color }};
      {% when 'neon' %}text-shadow: 0 0 {{ section.settings.link_hover_amount }}px {{ section.settings.link_hover_depth_color }}, 0 0 {{ section.settings.link_hover_amount | times: 2 }}px {{ section.settings.link_hover_depth_color }};
      {% when 'hard' %}text-shadow: {{ section.settings.link_hover_amount | divided_by: 2 }}px {{ section.settings.link_hover_amount | divided_by: 2 }}px 0 {{ section.settings.link_hover_depth_color }};
      {% else %}text-shadow: none;
    {% endcase %}
  }
  #shopify-section-{{ section.id }} .desk-nav:not(.top-menu) .nav-link > span,
  #shopify-section-{{ section.id }} .sheet .nav-link:not(.is-top) > span {
    width: 100%;
    text-align: {{ section.settings.menu_align_h }};
  }
  #shopify-section-{{ section.id }} .top-menu {
    gap: {{ section.settings.top_gap }}px;
    margin-bottom: {{ section.settings.top_gap }}px;
    {% if section.settings.top_cells %}padding-top: {{ section.settings.top_pad_top }}px;{% endif %}
    transform: translate({{ section.settings.top_x }}px, {{ section.settings.top_y }}px);
  }
  #shopify-section-{{ section.id }} .top-menu .nav-link,
  #shopify-section-{{ section.id }} .sheet .nav-link.is-top {
    {% if section.settings.top_cells %}
      border: {{ section.settings.top_border }}px solid {{ section.settings.top_border_color }};
      border-radius: 10px;
      padding: {{ section.settings.top_pad_top }}px {{ section.settings.top_pad_x }}px {{ section.settings.top_pad_bottom }}px {{ section.settings.top_pad_x }}px;
      display: inline-flex;
      justify-content: {{ top_h }};
      align-items: {{ top_v }};
      min-height: {{ section.settings.top_cell_height }}px;
      {% if section.settings.top_cell_width > 0 %}width: {{ section.settings.top_cell_width }}px;{% endif %}
      {% case section.settings.top_cell_fill %}
        {% when 'solid' %}background: {{ section.settings.top_cell_color }};
        {% when 'tide' %}background-image: linear-gradient(90deg, #042028, #00e5ff 42%, #7af6ff 50%, #00e5ff 58%, #042028);
        {% when 'violet' %}background-image: linear-gradient(100deg, #12061f, #6d1ecc 46%, #00e5ff);
        {% when 'foil' %}background-image: linear-gradient(110deg, #3a2a10, #e4c06a 40%, #fff6d0 50%, #e4c06a 60%, #3a2a10); background-size: 220% 100%;
        {% when 'sunset' %}background-image: linear-gradient(90deg, #3a1020, #ff5a7a 35%, #e4c06a 68%, #6d1ecc);
        {% when 'aurora' %}background-image: linear-gradient(100deg, #042028, #00e5ff, #6d1ecc, #00e5ff); background-size: 220% 100%;
        {% when 'pulse' %}background-image: linear-gradient(90deg, #042028, #00e5ff 50%, #042028); background-size: 220% 100%;
        {% when 'glass' %}background: color-mix(in srgb, {{ section.settings.top_cell_color }} 28%, transparent);
        {% when 'custom' %}background-image: linear-gradient(90deg, {{ section.settings.top_cell_color }}, {{ section.settings.top_cell_color_2 }});
        {% else %}background: none;
      {% endcase %}
      {% case section.settings.top_cell_depth %}
        {% when 'soft' %}box-shadow: 0 {{ section.settings.top_cell_depth_amount }}px {{ section.settings.top_cell_depth_amount | times: 2 }}px {{ section.settings.top_cell_depth_color }};
        {% when 'hard' %}box-shadow: {{ section.settings.top_cell_depth_amount | divided_by: 2 }}px {{ section.settings.top_cell_depth_amount | divided_by: 2 }}px 0 {{ section.settings.top_cell_depth_color }};
        {% when 'lift' %}box-shadow: 0 {{ section.settings.top_cell_depth_amount }}px {{ section.settings.top_cell_depth_amount | times: 2 }}px {{ section.settings.top_cell_depth_color }};
        {% when 'neon' %}box-shadow: 0 0 {{ section.settings.top_cell_depth_amount }}px {{ section.settings.top_cell_depth_color }};
        {% when 'press' %}box-shadow: inset 0 2px 8px {{ section.settings.top_cell_depth_color }};
        {% else %}box-shadow: none;
      {% endcase %}
    {% else %}
      border: 0;
      background: none;
      box-shadow: none;
      padding: 0;
      min-height: 0;
      width: auto;
      border-radius: 0;
    {% endif %}
  }
  #shopify-section-{{ section.id }} .top-menu .nav-link > span,
  #shopify-section-{{ section.id }} .sheet .nav-link.is-top > span {
    width: 100%;
    text-align: {{ section.settings.top_align_h }};
  }
  #shopify-section-{{ section.id }} .nav-item {
    position: relative;
    overflow: visible;
    z-index: 2;
  }
  #shopify-section-{{ section.id }} .nav-item:hover,
  #shopify-section-{{ section.id }} .nav-item:focus-within { z-index: 50; }
  #shopify-section-{{ section.id }} .nav-drop {
    display: none;
    position: absolute;
    top: calc(100% - 2px);
    left: 0;
    min-width: 220px;
    z-index: 80;
    padding: 0.45rem;
    background: #050814;
    background-image: none;
    border: 1px solid #1a2836;
    border-radius: 12px;
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.55);
  }
  #shopify-section-{{ section.id }} .nav-drop::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: -16px;
    height: 16px;
  }
  #shopify-section-{{ section.id }} .nav-item:hover > .nav-drop,
  #shopify-section-{{ section.id }} .nav-item:focus-within > .nav-drop { display: grid; }
  #shopify-section-{{ section.id }} .nav-drop-link {
    display: block;
    padding: 0.55rem 0.75rem;
    border-radius: 8px;
    color: #f3f7fb;
    background: #050814;
    box-shadow: none;
    text-decoration: none;
  }
  #shopify-section-{{ section.id }} .nav-drop-link:hover,
  #shopify-section-{{ section.id }} .nav-drop-link.is-on {
    background: #050814;
    color: #00e5ff;
    box-shadow: none;
  }
  #shopify-section-{{ section.id }} .nav-drop-link.is-sub {
    padding-left: 1.35rem;
    color: var(--color-muted);
    font-size: 0.92em;
  }
  #shopify-section-{{ section.id }} .sheet .nav-link.is-child { padding-left: 1.4rem; }
  #shopify-section-{{ section.id }} .logo-frame {
    transform: translate({{ logo_x }}px, {{ logo_y }}px);
  }
  @media (max-width: 480px) {
    #shopify-section-{{ section.id }} .logo-frame {
      transform: translate({{ logo_x_m }}px, {{ logo_y_m }}px);
    }
  }
  #shopify-section-{{ section.id }} .search {
    width: {{ section.settings.search_width | default: 176 }}px;
    min-width: {{ section.settings.search_width | default: 176 }}px;
    flex: 0 0 auto;
    transform: translate({{ section.settings.search_x | default: 0 }}px, {{ section.settings.search_y | default: 0 }}px);
  }
  #shopify-section-{{ section.id }} .search .field {
    width: 100%;
  }
  #shopify-section-{{ section.id }} .account-link {
    transform: translate({{ section.settings.account_x | default: 0 }}px, {{ section.settings.account_y | default: 0 }}px);
  }
  #shopify-section-{{ section.id }} .cart-link {
    transform: translate({{ section.settings.cart_x | default: 0 }}px, {{ section.settings.cart_y | default: 0 }}px);
  }
  #shopify-section-{{ section.id }} .account-link.has-label,
  #shopify-section-{{ section.id }} .cart-link.has-label {
    width: auto;
    height: auto;
    min-height: 44px;
    padding: 0 0.7rem;
    gap: 0.4rem;
  }
  #shopify-section-{{ section.id }} .account-link.align-left,
  #shopify-section-{{ section.id }} .cart-link.align-left { justify-content: flex-start; }
  #shopify-section-{{ section.id }} .account-link.align-center,
  #shopify-section-{{ section.id }} .cart-link.align-center { justify-content: center; }
  #shopify-section-{{ section.id }} .account-link.align-right,
  #shopify-section-{{ section.id }} .cart-link.align-right { justify-content: flex-end; }
  #shopify-section-{{ section.id }} .account-link.valign-top,
  #shopify-section-{{ section.id }} .cart-link.valign-top { align-items: flex-start; }
  #shopify-section-{{ section.id }} .account-link.valign-middle,
  #shopify-section-{{ section.id }} .cart-link.valign-middle { align-items: center; }
  #shopify-section-{{ section.id }} .account-link.valign-bottom,
  #shopify-section-{{ section.id }} .cart-link.valign-bottom { align-items: flex-end; }
  #shopify-section-{{ section.id }} .btn-label { line-height: 1; white-space: nowrap; }
{% endstyle %}
<header class="site-header{% if section.settings.sticky %} is-sticky{% endif %}" style="--bar-h: {{ section.settings.bar_height }}px; --logo-w: {{ logo_w }}px; --logo-h: {{ logo_h }}px; --logo-w-m: {{ logo_w_m }}px; --logo-h-m: {{ logo_h_m }}px; --logo-x: {{ logo_x }}px; --logo-y: {{ logo_y }}px; --logo-x-m: {{ logo_x_m }}px; --logo-y-m: {{ logo_y_m }}px; padding-top: {{ section.settings.pad_top | default: 0 }}px; padding-bottom: {{ section.settings.pad_bottom | default: 0 }}px;">
  {% if section.settings.tagline != blank %}
    <div class="tagline-hold image-cell {% if section.settings.tagline_show_cell == false %}is-clear{% else %}fill-{{ section.settings.tagline_fill | default: 'none' }}{% endif %} depth-{{ section.settings.tagline_depth | default: 'soft' }}" style="--tag-w: {{ section.settings.tagline_width | default: 220 }}px; --tag-h: {{ section.settings.tagline_height | default: 48 }}px; --tag-x: {{ section.settings.tagline_x | default: 0 }}px; --tag-y: {{ section.settings.tagline_y | default: 0 }}px; --tag-w-m: {{ section.settings.tagline_width_mobile | default: 160 }}px; --tag-h-m: {{ section.settings.tagline_height_mobile | default: 36 }}px; --tag-x-m: {{ section.settings.tagline_x_mobile | default: 0 }}px; --tag-y-m: {{ section.settings.tagline_y_mobile | default: 0 }}px; --cell-border: {{ section.settings.tagline_border | default: 0 }}px; --cell-border-color: {{ section.settings.tagline_border_color | default: '#00EAFF' }}; --fill: {{ section.settings.tagline_color | default: '#0E1C28' }}; --fill-2: {{ section.settings.tagline_color_2 | default: '#00E5FF' }}; --fill-angle: {{ section.settings.tagline_angle | default: 90 }}deg; --depth: {{ section.settings.tagline_depth_amount | default: 6 }}px; --depth-color: {{ section.settings.tagline_depth_color | default: '#00E5FF' }};">
      {% if section.settings.tagline_link != blank %}<a href="{{ section.settings.tagline_link }}">{% endif %}
      <img src="{{ section.settings.tagline | image_url: width: 1400 }}" alt="{{ section.settings.tagline_alt | default: shop.name | escape }}" width="{{ section.settings.tagline_width | default: 220 }}" height="{{ section.settings.tagline_height | default: 48 }}">
      {% if section.settings.tagline_link != blank %}</a>{% endif %}
    </div>
  {% endif %}
  {% if section.settings.menu_top != blank %}
    <nav class="wrap desk-nav top-menu" aria-label="Top">
      {% for link in section.settings.menu_top.links %}
        <a class="nav-link is-top{% if link.current %} is-on{% endif %}" href="{{ link.url }}"><span style="{{ top_style }}">{{ link.title }}</span></a>
      {% endfor %}
    </nav>
  {% endif %}
  <div class="wrap bar{% if section.settings.logo_align == 'center' %} is-center{% endif %}">
    <button class="icon-btn menu-btn" type="button" data-menu-open aria-label="Open menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
    <a class="brand" href="{{ routes.root_url }}">
      <span class="logo-frame">
        {% if section.settings.logo != blank %}
          <img
            class="logo"
            src="{{ section.settings.logo | image_url: width: 800 }}"
            alt="{{ shop.name | escape }}"

{% if section.settings.sticky %}
<script>
  (function () {
    var section = document.getElementById('shopify-section-{{ section.id }}');
    if (!section || section.dataset.stickyBound) return;
    section.dataset.stickyBound = '1';
    var group = section.closest('.shopify-section-group-header-group') || section;
    var spacer = document.createElement('div');
    spacer.hidden = true;
    group.after(spacer);
    var mark = 0;
    function place() {
      var y = window.scrollY || document.documentElement.scrollTop || 0;
      if (!group.dataset.stuck) mark = group.getBoundingClientRect().top + y;
      if (y > mark + 1) {
        if (!group.dataset.stuck) {
          spacer.style.height = group.offsetHeight + 'px';
          spacer.hidden = false;
          group.dataset.stuck = '1';
          group.style.position = 'fixed';
          group.style.top = '0';
          group.style.left = '0';
          group.style.right = '0';
          group.style.width = '100%';
          group.style.zIndex = '80';
          group.style.background = 'var(--color-bg)';
        }
      } else if (group.dataset.stuck) {
        group.dataset.stuck = '';
        group.style.position = '';
        group.style.top = '';
        group.style.left = '';
        group.style.right = '';
        group.style.width = '';
        group.style.zIndex = '';
        group.style.background = '';
        spacer.hidden = true;
      }
    }
    document.addEventListener('scroll', place, true);
    window.addEventListener('resize', place);
    place();
  })();
</script>
{% endif %}


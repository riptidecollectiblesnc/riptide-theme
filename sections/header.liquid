{% liquid
  assign logo_w = section.settings.logo_width | default: 160
  assign logo_h = section.settings.logo_height | default: 56
  assign logo_w_m = section.settings.logo_width_mobile | default: 120
  assign logo_h_m = section.settings.logo_height_mobile | default: 44
  case section.settings.menu_align_h
    when 'left'
      assign menu_h = 'flex-start'
    when 'right'
      assign menu_h = 'flex-end'
    else
      assign menu_h = 'center'
  endcase
  case section.settings.menu_align_v
    when 'top'
      assign menu_v = 'flex-start'
    when 'bottom'
      assign menu_v = 'flex-end'
    else
      assign menu_v = 'center'
  endcase
  case section.settings.top_align_h
    when 'left'
      assign top_h = 'flex-start'
    when 'right'
      assign top_h = 'flex-end'
    else
      assign top_h = 'center'
  endcase
  case section.settings.top_align_v
    when 'top'
      assign top_v = 'flex-start'
    when 'bottom'
      assign top_v = 'flex-end'
    else
      assign top_v = 'center'
  endcase
%}
{% capture menu_style %}{% render 'field-style', font: section.settings.menu_font, bold: section.settings.menu_bold, italic: section.settings.menu_italic, fill: section.settings.menu_fill, fill_2: section.settings.menu_fill_2, color: section.settings.menu_color, size: section.settings.menu_size, depth: section.settings.menu_depth, amount: section.settings.menu_depth_amount, shadow: section.settings.menu_depth_color %}{% endcapture %}
{% capture top_style %}{% render 'field-style', font: section.settings.top_font, bold: section.settings.top_bold, italic: section.settings.top_italic, fill: section.settings.top_fill, fill_2: section.settings.top_fill_2, color: section.settings.top_color, size: section.settings.top_size, depth: section.settings.top_depth, amount: section.settings.top_depth_amount, shadow: section.settings.top_depth_color %}{% endcapture %}
{% style %}
  {% if section.settings.sticky %}
    .shopify-section-group-header-group:has(#shopify-section-{{ section.id }} .is-sticky) {
      position: sticky;
      top: 0;
      z-index: 50;
      background: var(--color-bg);
    }
  {% endif %}
  #shopify-section-{{ section.id }} .desk-nav {
    gap: {{ section.settings.menu_gap }}px;
  }
  #shopify-section-{{ section.id }} .sheet .nav-link {
    margin: {{ section.settings.menu_gap | divided_by: 2 }}px 0;
  }
  #shopify-section-{{ section.id }} .desk-nav .nav-link,
  #shopify-section-{{ section.id }} .sheet .nav-link {
    border: {{ section.settings.menu_border }}px solid {{ section.settings.menu_border_color }};
    border-radius: 10px;
    padding: {{ section.settings.menu_pad_top }}px {{ section.settings.menu_pad_x }}px {{ section.settings.menu_pad_bottom }}px {{ section.settings.menu_pad_x }}px;
    display: inline-flex;
    justify-content: {{ menu_h }};
    align-items: {{ menu_v }};
    {% if section.settings.menu_cell_height > 0 %}min-height: {{ section.settings.menu_cell_height }}px;{% endif %}
    {% if section.settings.menu_cell_width > 0 %}width: {{ section.settings.menu_cell_width }}px;{% endif %}
    {% case section.settings.menu_cell_fill %}
      {% when 'solid' %}background: {{ section.settings.menu_cell_color }};
      {% when 'tide' %}background-image: linear-gradient(90deg, #042028, #00e5ff 42%, #7af6ff 50%, #00e5ff 58%, #042028);
      {% when 'violet' %}background-image: linear-gradient(100deg, #12061f, #6d1ecc 46%, #00e5ff);
      {% when 'foil' %}background-image: linear-gradient(110deg, #3a2a10, #e4c06a 40%, #fff6d0 50%, #e4c06a 60%, #3a2a10); background-size: 220% 100%;
      {% when 'sunset' %}background-image: linear-gradient(90deg, #3a1020, #ff5a7a 35%, #e4c06a 68%, #6d1ecc);
      {% when 'aurora' %}background-image: linear-gradient(100deg, #042028, #00e5ff, #6d1ecc, #00e5ff); background-size: 220% 100%;
      {% when 'pulse' %}background-image: linear-gradient(90deg, #042028, #00e5ff 50%, #042028); background-size: 220% 100%;
      {% when 'glass' %}background: color-mix(in srgb, {{ section.settings.menu_cell_color }} 28%, transparent);
      {% when 'custom' %}background-image: linear-gradient(90deg, {{ section.settings.menu_cell_color }}, {{ section.settings.menu_cell_color_2 }});
    {% endcase %}
    {% case section.settings.menu_cell_depth %}
      {% when 'soft' %}box-shadow: 0 {{ section.settings.menu_cell_depth_amount }}px {{ section.settings.menu_cell_depth_amount | times: 2 }}px {{ section.settings.menu_cell_depth_color }};
      {% when 'hard' %}box-shadow: {{ section.settings.menu_cell_depth_amount | divided_by: 2 }}px {{ section.settings.menu_cell_depth_amount | divided_by: 2 }}px 0 {{ section.settings.menu_cell_depth_color }};
      {% when 'lift' %}box-shadow: 0 {{ section.settings.menu_cell_depth_amount }}px {{ section.settings.menu_cell_depth_amount | times: 2 }}px {{ section.settings.menu_cell_depth_color }};
      {% when 'neon' %}box-shadow: 0 0 {{ section.settings.menu_cell_depth_amount }}px {{ section.settings.menu_cell_depth_color }};
      {% when 'press' %}box-shadow: inset 0 2px 8px {{ section.settings.menu_cell_depth_color }};
    {% endcase %}
  }
  #shopify-section-{{ section.id }} .desk-nav .nav-link > span,
  #shopify-section-{{ section.id }} .sheet .nav-link > span {
    width: 100%;
    text-align: {{ section.settings.menu_align_h }};
  }
  #shopify-section-{{ section.id }} .top-menu {
    gap: {{ section.settings.top_gap }}px;
    margin-bottom: {{ section.settings.top_gap }}px;
    padding-top: {{ section.settings.top_pad_top }}px;
  }
  #shopify-section-{{ section.id }} .top-menu .nav-link,
  #shopify-section-{{ section.id }} .sheet .nav-link.is-top {
    border: {{ section.settings.top_border }}px solid {{ section.settings.top_border_color }};
    border-radius: 10px;
    padding: {{ section.settings.top_pad_top }}px {{ section.settings.top_pad_x }}px {{ section.settings.top_pad_bottom }}px {{ section.settings.top_pad_x }}px;
    display: inline-flex;
    justify-content: {{ top_h }};
    align-items: {{ top_v }};
    {% if section.settings.top_cell_height > 0 %}min-height: {{ section.settings.top_cell_height }}px;{% endif %}
    {% if section.settings.top_cell_width > 0 %}width: {{ section.settings.top_cell_width }}px;{% endif %}
    {% case section.settings.top_cell_fill %}
      {% when 'solid' %}background: {{ section.settings.top_cell_color }};
      {% when 'tide' %}background-image: linear-gradient(90deg, #042028, #00e5ff 42%, #7af6ff 50%, #00e5ff 58%, #042028);
      {% when 'violet' %}background-image: linear-gradient(100deg, #12061f, #6d1ecc 46%, #00e5ff);
      {% when 'foil' %}background-image: linear-gradient(110deg, #3a2a10, #e4c06a 40%, #fff6d0 50%, #e4c06a 60%, #3a2a10); background-size: 220% 100%;
      {% when 'sunset' %}background-image: linear-gradient(90deg, #3a1020, #ff5a7a 35%, #e4c06a 68%, #6d1ecc);
      {% when 'aurora' %}background-image: linear-gradient(100deg, #042028, #00e5ff, #6d1ecc, #00e5ff); background-size: 220% 100%;
      {% when 'pulse' %}background-image: linear-gradient(90deg, #042028, #00e5ff 50%, #042028); background-size: 220% 100%;
      {% when 'glass' %}background: color-mix(in srgb, {{ section.settings.top_cell_color }} 28%, transparent);
      {% when 'custom' %}background-image: linear-gradient(90deg, {{ section.settings.top_cell_color }}, {{ section.settings.top_cell_color_2 }});
    {% endcase %}
    {% case section.settings.top_cell_depth %}
      {% when 'soft' %}box-shadow: 0 {{ section.settings.top_cell_depth_amount }}px {{ section.settings.top_cell_depth_amount | times: 2 }}px {{ section.settings.top_cell_depth_color }};
      {% when 'hard' %}box-shadow: {{ section.settings.top_cell_depth_amount | divided_by: 2 }}px {{ section.settings.top_cell_depth_amount | divided_by: 2 }}px 0 {{ section.settings.top_cell_depth_color }};
      {% when 'lift' %}box-shadow: 0 {{ section.settings.top_cell_depth_amount }}px {{ section.settings.top_cell_depth_amount | times: 2 }}px {{ section.settings.top_cell_depth_color }};
      {% when 'neon' %}box-shadow: 0 0 {{ section.settings.top_cell_depth_amount }}px {{ section.settings.top_cell_depth_color }};
      {% when 'press' %}box-shadow: inset 0 2px 8px {{ section.settings.top_cell_depth_color }};
    {% endcase %}
  }
  #shopify-section-{{ section.id }} .top-menu .nav-link > span,
  #shopify-section-{{ section.id }} .sheet .nav-link.is-top > span {
    width: 100%;
    text-align: {{ section.settings.top_align_h }};
  }
  #shopify-section-{{ section.id }} .nav-item { position: relative; }
  #shopify-section-{{ section.id }} .nav-drop {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 220px;
    z-index: 70;
    padding: 0.45rem;
    background: var(--color-bg);
    border: 1px solid color-mix(in srgb, var(--color-neon) 35%, var(--color-border));
    border-radius: 12px;
    box-shadow: 0 18px 40px color-mix(in srgb, black 45%, transparent);
  }
  #shopify-section-{{ section.id }} .nav-drop::before {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: -14px;
    height: 14px;
  }
  #shopify-section-{{ section.id }} .nav-item:hover .nav-drop,
  #shopify-section-{{ section.id }} .nav-item:focus-within .nav-drop { display: grid; }
  #shopify-section-{{ section.id }} .nav-drop-link {
    display: block;
    padding: 0.55rem 0.75rem;
    border-radius: 8px;
    color: var(--color-fg);
    text-decoration: none;
  }
  #shopify-section-{{ section.id }} .nav-drop-link:hover,
  #shopify-section-{{ section.id }} .nav-drop-link.is-on {
    background: color-mix(in srgb, var(--color-neon) 16%, transparent);
    color: var(--color-primary);
  }
  #shopify-section-{{ section.id }} .nav-drop-link.is-sub {
    padding-left: 1.35rem;
    color: var(--color-muted);
    font-size: 0.92em;
  }
  #shopify-section-{{ section.id }} .sheet .nav-link.is-child { padding-left: 1.4rem; }
{% endstyle %}
<header class="site-header{% if section.settings.sticky %} is-sticky{% endif %}" style="--bar-h: {{ section.settings.bar_height }}px; --logo-w: {{ logo_w }}px; --logo-h: {{ logo_h }}px; --logo-w-m: {{ logo_w_m }}px; --logo-h-m: {{ logo_h_m }}px;">
  {% if section.settings.menu_top != blank %}
    <nav class="wrap desk-nav top-menu" aria-label="Top">
      {% for link in section.settings.menu_top.links %}
        <a class="nav-link is-top{% if link.current %} is-on{% endif %}" href="{{ link.url }}"><span style="{{ top_style }}">{{ link.title }}</span></a>
      {% endfor %}
    </nav>
  {% endif %}
  <div class="wrap bar{% if section.settings.logo_align == 'center' %} is-center{% endif %}">
    <button class="icon-btn menu-btn" type="button" data-menu-open aria-label="Open menu">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
    </button>
    <a class="brand" href="{{ routes.root_url }}">
      <span class="logo-frame">
        {% if section.settings.logo != blank %}
          <img
            class="logo"
            src="{{ section.settings.logo | image_url: width: 800 }}"
            alt="{{ shop.name | escape }}"
            width="{{ logo_w }}"
            height="{{ logo_h }}"
          >
        {% else %}
          <span class="mark" aria-hidden="true"></span>
        {% endif %}
      </span>
      {% if section.settings.show_name %}
        <span class="shop-name">{{ shop.name }}</span>
      {% endif %}
    </a>
    <nav class="desk-nav" aria-label="Primary">
      {% if section.settings.menu != blank %}
        {% for link in section.settings.menu.links %}
          {% if link.links != blank %}
            <div class="nav-item">
              <a class="nav-link{% if link.current %} is-on{% endif %}" href="{{ link.url }}"><span style="{{ menu_style }}">{{ link.title }}</span></a>
              <div class="nav-drop">
                {% for child in link.links %}
                  <a class="nav-drop-link{% if child.current %} is-on{% endif %}" href="{{ child.url }}">{{ child.title }}</a>
                  {% for grand in child.links %}
                    <a class="nav-drop-link is-sub{% if grand.current %} is-on{% endif %}" href="{{ grand.url }}">{{ grand.title }}</a>
                  {% endfor %}
                {% endfor %}
              </div>
            </div>
          {% else %}
            <a class="nav-link{% if link.current %} is-on{% endif %}" href="{{ link.url }}"><span style="{{ menu_style }}">{{ link.title }}</span></a>
          {% endif %}
        {% endfor %}
      {% else %}
        <a class="nav-link" href="{{ routes.all_products_collection_url }}"><span style="{{ menu_style }}">Shop</span></a>
        <a class="nav-link" href="{{ routes.root_url }}#shopify-section-breaks"><span style="{{ menu_style }}">Breaks</span></a>
        <a class="nav-link" href="{{ routes.root_url }}#shopify-section-live"><span style="{{ menu_style }}">Live</span></a>
        <a class="nav-link" href="{{ routes.root_url }}#shopify-section-auctions"><span style="{{ menu_style }}">Auctions</span></a>
        <a class="nav-link" href="{{ routes.root_url }}#shopify-section-hits"><span style="{{ menu_style }}">Hits</span></a>
        <a class="nav-link" href="{{ routes.root_url }}#shopify-section-whatnot"><span style="{{ menu_style }}">Whatnot</span></a>
      {% endif %}
    </nav>
    <form class="search" action="{{ routes.search_url }}" method="get" role="search">
      <input class="field" type="search" name="q" placeholder="Search wax" aria-label="Search">
      <input type="hidden" name="type" value="product">
    </form>
    {% if shop.customer_accounts_enabled %}
      <a class="icon-btn" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" aria-label="Account">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="8" r="3.2"/><path d="M5 19c1.4-3 3.8-4.5 7-4.5S17.6 16 19 19"/></svg>
      </a>
    {% endif %}
    <a class="icon-btn cart-link" href="{{ routes.cart_url }}" aria-label="Cart">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 7h12l-1 13H7L6 7z"/><path d="M9 7a3 3 0 0 1 6 0"/></svg>
      <span class="count" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>{{ cart.item_count }}</span>
    </a>
  </div>
</header>

<div class="mobile-menu" data-menu hidden>
  <div class="sheet panel">
    <div class="sheet-top">
      <p class="display" style="font-size:1.8rem">Menu</p>
      <button class="icon-btn" type="button" data-menu-close aria-label="Close menu">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
    </div>
    <form action="{{ routes.search_url }}" method="get" role="search">
      <input class="field" type="search" name="q" placeholder="Search wax and breaks" aria-label="Search">
      <input type="hidden" name="type" value="product">
    </form>
    {% if section.settings.menu_top != blank %}
      {% for link in section.settings.menu_top.links %}
        <a class="nav-link is-top{% if link.current %} is-on{% endif %}" href="{{ link.url }}"><span style="{{ top_style }}">{{ link.title }}</span></a>
      {% endfor %}
    {% endif %}
    {% if section.settings.menu != blank %}
      {% for link in section.settings.menu.links %}
        <a class="nav-link" href="{{ link.url }}"><span style="{{ menu_style }}">{{ link.title }}</span></a>
        {% for child in link.links %}
          <a class="nav-link is-child" href="{{ child.url }}"><span style="{{ menu_style }}">{{ child.title }}</span></a>
          {% for grand in child.links %}
            <a class="nav-link is-child" href="{{ grand.url }}"><span style="{{ menu_style }}">{{ grand.title }}</span></a>
          {% endfor %}
        {% endfor %}
      {% endfor %}
    {% else %}
      <a class="nav-link" href="{{ routes.all_products_collection_url }}"><span style="{{ menu_style }}">Shop</span></a>
      <a class="nav-link" href="{{ routes.root_url }}#shopify-section-breaks"><span style="{{ menu_style }}">Breaks</span></a>
      <a class="nav-link" href="{{ routes.root_url }}#shopify-section-live"><span style="{{ menu_style }}">Live</span></a>
      <a class="nav-link" href="{{ routes.root_url }}#shopify-section-auctions"><span style="{{ menu_style }}">Auctions</span></a>
      <a class="nav-link" href="{{ routes.root_url }}#shopify-section-hits"><span style="{{ menu_style }}">Hits</span></a>
      <a class="nav-link" href="{{ routes.root_url }}#shopify-section-whatnot"><span style="{{ menu_style }}">Whatnot</span></a>
    {% endif %}
    <a class="nav-link" href="{{ routes.cart_url }}"><span style="{{ menu_style }}">Cart</span></a>
  </div>
</div>

<nav class="bottom-nav" aria-label="Mobile">
  <a href="{{ routes.all_products_collection_url }}">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 7h16v12H4z"/><path d="M8 7V5a4 4 0 0 1 8 0v2"/></svg>
    <span style="{{ menu_style }}">Shop</span>
  </a>
  <a href="{{ routes.root_url }}#shopify-section-breaks">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="4" y="4" width="6" height="6"/><rect x="14" y="4" width="6" height="6"/><rect x="4" y="14" width="6" height="6"/><rect x="14" y="14" width="6" height="6"/></svg>
    <span style="{{ menu_style }}">Breaks</span>
  </a>
  <a href="{{ routes.root_url }}#shopify-section-live">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M6 12a6 6 0 0 1 0-1M18 12a6 6 0 0 0 0-1"/></svg>
    <span style="{{ menu_style }}">Live</span>
  </a>
  <a href="{{ routes.root_url }}#shopify-section-auctions">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 14l6-6 4 4 6-7"/><path d="M14 5h6v6"/></svg>
    <span style="{{ menu_style }}">Bids</span>
  </a>
  <a href="{{ routes.cart_url }}">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 7h12l-1 13H7L6 7z"/><path d="M9 7a3 3 0 0 1 6 0"/></svg>
    <span style="{{ menu_style }}">Cart</span>
  </a>
</nav>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "header",
      "content": "Menu text"
    },
    {
      "type": "select",
      "id": "menu_font",
      "label": "Menu font",
      "default": "inherit",
      "options": [
        {
          "value": "inherit",
          "label": "Theme default"
        },
        {
          "value": "Unbounded, sans-serif",
          "label": "Unbounded"
        },
        {
          "value": "Outfit, sans-serif",
          "label": "Outfit"
        },
        {
          "value": "\"Barlow Condensed\", sans-serif",
          "label": "Barlow Condensed"
        },
        {
          "value": "\"Bebas Neue\", sans-serif",
          "label": "Bebas Neue"
        },
        {
          "value": "Oswald, sans-serif",
          "label": "Oswald"
        },
        {
          "value": "Anton, sans-serif",
          "label": "Anton"
        },
        {
          "value": "Archivo, sans-serif",
          "label": "Archivo"
        },
        {
          "value": "Inter, sans-serif",
          "label": "Inter"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "menu_bold",
      "label": "Menu bold",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "menu_italic",
      "label": "Menu italic",
      "default": false
    },
    {
      "type": "range",
      "id": "menu_size",
      "label": "Menu size",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "color",
      "id": "menu_color",
      "label": "Menu color",
      "default": "#8eafbf"
    },
    {
      "type": "select",
      "id": "menu_fill",
      "label": "Menu fill",
      "default": "solid",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "tide",
          "label": "Tide"
        },
        {
          "value": "violet",
          "label": "Violet"
        },
        {
          "value": "foil",
          "label": "Foil"
        },
        {
          "value": "sunset",
          "label": "Sunset"
        },
        {
          "value": "aurora",
          "label": "Aurora"
        },
        {
          "value": "pulse",
          "label": "Neon pulse"
        },
        {
          "value": "custom",
          "label": "Custom gradient"
        }
      ],
      "info": "Gradient is painted on the letters. Solid uses the menu color."
    },
    {
      "type": "color",
      "id": "menu_fill_2",
      "label": "Menu second color",
      "default": "#00e5ff",
      "info": "Second color for Custom gradient."
    },
    {
      "type": "select",
      "id": "menu_depth",
      "label": "Menu depth",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "soft",
          "label": "Soft shadow"
        },
        {
          "value": "hard",
          "label": "Hard offset"
        },
        {
          "value": "lift",
          "label": "Lift"
        },
        {
          "value": "long",
          "label": "Long shadow"
        },
        {
          "value": "echo",
          "label": "Echo"
        },
        {
          "value": "press",
          "label": "Letterpress"
        },
        {
          "value": "emboss",
          "label": "Emboss"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "neon",
          "label": "Neon glow"
        },
        {
          "value": "double",
          "label": "Double glow"
        },
        {
          "value": "foil",
          "label": "Foil"
        }
      ]
    },
    {
      "type": "range",
      "id": "menu_depth_amount",
      "label": "Menu depth amount",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "color",
      "id": "menu_depth_color",
      "label": "Menu depth color",
      "default": "#00e5ff"
    },
    {
      "type": "header",
      "content": "Menu cells"
    },
    {
      "type": "range",
      "id": "menu_gap",
      "label": "Space between items",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 10
    },

<section class="section" style="padding-top: {{ section.settings.pad_top }}px; padding-bottom: {{ section.settings.pad_bottom }}px;">
  <div class="wrap" style="max-width:760px">
    <h1 class="display">{{ page.title }}</h1>
    <div class="rte" style="margin-top:1rem">{{ page.content }}</div>
  </div>
</section>

{% schema %}
{
  "name": "Page",
  "settings": [
    {
      "type": "header",
      "content": "Section space"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Top space",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 52,
      "info": "Space above and below this section."
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Bottom space",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 52,
      "info": "Space above and below this section."
    }
  ]
}
{% endschema %}

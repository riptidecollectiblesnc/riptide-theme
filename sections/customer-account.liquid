{% render 'section-bg', section: section %}
<section class="section" style="padding-top: {{ section.settings.pad_top }}px; padding-bottom: {{ section.settings.pad_bottom }}px;">
  <div class="wrap">
    <header class="section-head">
      <h1 class="display">{{ customer.first_name | default: customer.email }}</h1>
      <a class="nav-link" href="{{ routes.account_logout_url }}">Log out</a>
    </header>
    <p><a class="nav-link" href="{{ routes.account_addresses_url }}">Addresses</a></p>
    <div class="hit-list" style="margin-top:1rem">
      {% for order in customer.orders %}
        <a class="panel" style="padding:0.8rem 0.9rem" href="{{ order.customer_url }}">
          <strong>{{ order.name }}</strong>
          <p class="fine">{{ order.created_at | date: '%b %d, %Y' }} · {{ order.financial_status_label }} · {{ order.total_price | money }}</p>
        </a>
      {% else %}
        <p class="muted">No orders yet.</p>
      {% endfor %}
    </div>
  </div>
</section>


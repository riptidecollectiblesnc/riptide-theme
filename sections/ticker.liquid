{% if section.blocks.size > 0 %}
  <div class="ticker" style="--ticker-ms: {{ section.settings.scroll_seconds }}s" aria-hidden="true">
    <div class="ticker-track">
      {% for pass in (1..2) %}
        {% for block in section.blocks %}
          <span {{ block.shopify_attributes }}><b style="{% render 'field-style', color: block.settings.title_color, size: block.settings.title_size, depth: block.settings.title_depth, amount: block.settings.title_depth_amount, shadow: block.settings.title_depth_color %}">{{ block.settings.title }}</b> <span style="{% render 'field-style', color: block.settings.detail_color, size: block.settings.detail_size, depth: block.settings.detail_depth, amount: block.settings.detail_depth_amount, shadow: block.settings.detail_depth_color %}">{{ block.settings.detail }}</span></span>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
{% endif %}

{% schema %}
{
  "name": "Hit ticker",
  "settings": [
    {
      "type": "range",
      "id": "scroll_seconds",
      "label": "Scroll speed",
      "min": 8,
      "max": 80,
      "step": 2,
      "unit": "s",
      "default": 40,
      "info": "Seconds for one full pass. Lower is faster. The ticker stays full width."
    }
  ],
  "blocks": [
    {
      "type": "hit",
      "name": "Hit",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Hit"
        },
        {
          "type": "color",
          "id": "title_color",
          "label": "Title color",
          "default": "#e7f6fb"
        },
        {
          "type": "range",
          "id": "title_size",
          "label": "Title size",
          "min": 10,
          "max": 96,
          "step": 2,
          "unit": "px",
          "default": 16
        },
        {
          "type": "select",
          "id": "title_depth",
          "label": "Title depth",
          "default": "none",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "soft",
              "label": "Soft shadow"
            },
            {
              "value": "hard",
              "label": "Hard offset"
            },
            {
              "value": "neon",
              "label": "Neon glow"
            }
          ]
        },
        {
          "type": "range",
          "id": "title_depth_amount",
          "label": "Title depth amount",
          "min": 0,
          "max": 40,
          "step": 2,
          "unit": "px",
          "default": 8
        },
        {
          "type": "color",
          "id": "title_depth_color",
          "label": "Title depth color",
          "default": "#00e5ff"
        },
        {
          "type": "text",
          "id": "detail",
          "label": "Detail",
          "default": "Replace this"
        },
        {
          "type": "color",
          "id": "detail_color",
          "label": "Detail color",
          "default": "#8eafbf"
        },
        {
          "type": "range",
          "id": "detail_size",
          "label": "Detail size",
          "min": 10,
          "max": 96,
          "step": 2,
          "unit": "px",
          "default": 14
        },
        {
          "type": "select",
          "id": "detail_depth",
          "label": "Detail depth",
          "default": "none",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "soft",
              "label": "Soft shadow"
            },
            {
              "value": "hard",
              "label": "Hard offset"
            },
            {
              "value": "neon",
              "label": "Neon glow"
            }
          ]
        },
        {
          "type": "range",
          "id": "detail_depth_amount",
          "label": "Detail depth amount",
          "min": 0,
          "max": 40,
          "step": 2,
          "unit": "px",
          "default": 8
        },
        {
          "type": "color",
          "id": "detail_depth_color",
          "label": "Detail depth color",
          "default": "#00e5ff"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hit ticker",
      "blocks": [
        {
          "type": "hit",
          "settings": {
            "title": "Sample",
            "detail": "Replace ticker hits in the theme editor"
          }
        }
      ]
    }
  ]
}
{% endschema %}

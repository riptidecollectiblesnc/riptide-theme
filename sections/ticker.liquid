{% render 'section-bg', section: section %}
{% if section.blocks.size > 0 %}
  <div class="ticker-slot" style="padding-top: {{ section.settings.pad_top }}px; padding-bottom: {{ section.settings.pad_bottom }}px;">
  <div class="ticker bar-fill fill-{{ section.settings.fill }}" data-ticker style="--bar-h: {{ section.settings.bar_height }}px; --ticker-ms: {{ section.settings.scroll_seconds }}s; --fill: {{ section.settings.fill_color }}; --fill-2: {{ section.settings.fill_color_2 }}; --fill-angle: {{ section.settings.fill_angle }}deg;" aria-hidden="true">
    <div class="ticker-track">
      <div class="ticker-set">
        {% for block in section.blocks %}
          <span class="ticker-item" {{ block.shopify_attributes }}><b style="{% render 'field-style', font: block.settings.title_font, bold: block.settings.title_bold, italic: block.settings.title_italic, align: block.settings.title_align, valign: block.settings.title_valign, fill: block.settings.title_fill, fill_2: block.settings.title_fill_2, color: block.settings.title_color, size: block.settings.title_size, depth: block.settings.title_depth, amount: block.settings.title_depth_amount, shadow: block.settings.title_depth_color %}">{{ block.settings.title }}</b> <span style="{% render 'field-style', font: block.settings.detail_font, bold: block.settings.detail_bold, italic: block.settings.detail_italic, align: block.settings.detail_align, valign: block.settings.detail_valign, fill: block.settings.detail_fill, fill_2: block.settings.detail_fill_2, color: block.settings.detail_color, size: block.settings.detail_size, depth: block.settings.detail_depth, amount: block.settings.detail_depth_amount, shadow: block.settings.detail_depth_color %}">{{ block.settings.detail }}</span></span>
        {% endfor %}
      </div>
    </div>
  </div>
  </div>
  <script>
    (function () {
      var slot = document.currentScript && document.currentScript.previousElementSibling;
      var root = slot && slot.querySelector ? slot.querySelector('[data-ticker]') : null;
      if (!root) root = document.querySelector('[data-ticker]');
      if (!root || root.dataset.ready === '1') return;
      var track = root.querySelector('.ticker-track');
      var set = track && track.querySelector('.ticker-set');
      if (!track || !set) return;
      root.dataset.ready = '1';
      var seed = Array.prototype.map.call(set.children, function (node) {
        var copy = node.cloneNode(true);
        copy.removeAttribute('data-shopify-editor-block');
        return copy;
      });
      function pump() {
        var sets = track.querySelectorAll('.ticker-set');
        for (var i = 1; i < sets.length; i++) sets[i].remove();
        var need = Math.max(root.clientWidth || 0, window.innerWidth || 0);
        var guard = 0;
        while (set.scrollWidth < need && guard < 30) {
          seed.forEach(function (node) { set.appendChild(node.cloneNode(true)); });
          guard += 1;
        }
        var twin = set.cloneNode(true);
        twin.setAttribute('aria-hidden', 'true');
        twin.querySelectorAll('[data-shopify-editor-block]').forEach(function (node) {
          node.removeAttribute('data-shopify-editor-block');
        });
        track.appendChild(twin);
        var shift = set.offsetWidth;
        if (shift) track.style.setProperty('--ticker-shift', shift + 'px');
      }
      pump();
      if (document.fonts && document.fonts.ready) document.fonts.ready.then(pump);
    })();
  </script>
{% endif %}


{% render 'section-bg', section: section %}
{% liquid
  assign title = section.settings.title
  if title == blank
    assign title = collection.title
  endif
  assign href = section.settings.link_url
  if href == blank
    assign href = routes.all_products_collection_url
  endif
  assign show_link = false
  if section.settings.link != blank or section.settings.arrow != blank
    assign show_link = true
  endif
%}
<section class="section collection-page" style="padding-top: {{ section.settings.pad_top }}px; padding-bottom: {{ section.settings.pad_bottom }}px;">
  <div class="wrap">
    <header class="section-head">
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="kicker keep-lead" style="{% render 'field-style', font: section.settings.eyebrow_font, bold: section.settings.eyebrow_bold, italic: section.settings.eyebrow_italic, align: section.settings.eyebrow_align, valign: section.settings.eyebrow_valign, fill: section.settings.eyebrow_fill, fill_2: section.settings.eyebrow_fill_2, color: section.settings.eyebrow_color, size: section.settings.eyebrow_size, depth: section.settings.eyebrow_depth, amount: section.settings.eyebrow_depth_amount, shadow: section.settings.eyebrow_depth_color %}">{% render 'keep-space', text: section.settings.eyebrow %}</p>
        {% endif %}
        <h1 class="display collection-line keep-lead" style="{% render 'field-style', font: section.settings.title_font, bold: section.settings.title_bold, italic: section.settings.title_italic, align: section.settings.title_align, valign: section.settings.title_valign, fill: section.settings.title_fill, fill_2: section.settings.title_fill_2, color: section.settings.title_color, size: section.settings.title_size, depth: section.settings.title_depth, amount: section.settings.title_depth_amount, shadow: section.settings.title_depth_color %}">{% render 'keep-space', text: title %}{% if show_link %}<a class="collection-all keep-lead" href="{{ href }}" style="{% render 'field-style', font: section.settings.link_font, bold: section.settings.link_bold, italic: section.settings.link_italic, align: section.settings.link_align, valign: section.settings.link_valign, fill: section.settings.link_fill, fill_2: section.settings.link_fill_2, color: section.settings.link_color, size: section.settings.link_size, depth: section.settings.link_depth, amount: section.settings.link_depth_amount, shadow: section.settings.link_depth_color %}">{% if section.settings.arrow != blank %}{% render 'keep-space', text: section.settings.arrow %}{% endif %}{% if section.settings.arrow != blank and section.settings.link != blank %} {% endif %}{% render 'keep-space', text: section.settings.link %}</a>{% endif %}</h1>
        {% if collection.description != blank %}
          <div class="rte" style="margin-top:0.5rem">{{ collection.description }}</div>
        {% endif %}
      </div>
    </header>
    {% paginate collection.products by section.settings.per_page %}
      <div class="shop-grid">
        {% if collection.filters.size > 0 %}
          <form class="filters" method="get" action="{{ collection.url }}">
            {% for filter in collection.filters %}
              <details {% if forloop.first %}open{% endif %}>
                <summary>{{ filter.label }}</summary>
                {% if filter.type == 'price_range' %}
                  <label>Min
                    <input class="field" type="number" name="{{ filter.min_value.param_name }}" {% if filter.min_value.value %}value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"{% endif %}>
                  </label>
                  <label>Max
                    <input class="field" type="number" name="{{ filter.max_value.param_name }}" {% if filter.max_value.value %}value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"{% endif %}>
                  </label>
                {% else %}
                  {% for value in filter.values %}
                    <label>
                      <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}" {% if value.active %}checked{% endif %}>
                      {{ value.label }} ({{ value.count }})
                    </label>
                  {% endfor %}
                {% endif %}
              </details>
            {% endfor %}
            <button class="btn btn-ghost" type="submit">Apply</button>
          </form>
        {% endif %}
        <div class="grid-cards">
          {% for product in collection.products %}
            {% render 'product-card', product: product %}
          {% else %}
            <p class="muted">Nothing in this collection yet.</p>
          {% endfor %}
        </div>
      </div>
      {% if paginate.pages > 1 %}
        <nav class="pager" aria-label="Pagination">
          {% if paginate.previous %}<a class="btn btn-ghost" href="{{ paginate.previous.url }}">Previous</a>{% endif %}
          <span class="fine">{{ paginate.current_page }} / {{ paginate.pages }}</span>
          {% if paginate.next %}<a class="btn btn-ghost" href="{{ paginate.next.url }}">Next</a>{% endif %}
        </nav>
      {% endif %}
    {% endpaginate %}
  </div>
</section>


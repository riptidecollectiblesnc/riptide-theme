{% liquid
  assign raw = section.settings.youtube_url
  assign yid = ''
  if raw contains 'watch?v='
    assign yid = raw | split: 'watch?v=' | last | split: '&' | first
  elsif raw contains 'youtu.be/'
    assign yid = raw | split: 'youtu.be/' | last | split: '?' | first
  elsif raw contains '/live/'
    assign yid = raw | split: '/live/' | last | split: '?' | first
  elsif raw contains '/embed/'
    assign yid = raw | split: '/embed/' | last | split: '?' | first
  endif
  assign channel = section.settings.twitch_channel | replace: 'https://www.twitch.tv/', '' | replace: 'http://www.twitch.tv/', '' | replace: '@', '' | split: '/' | first | split: '?' | first
  assign whatnot = section.settings.whatnot_url | default: settings.whatnot_url
  assign provider = section.settings.provider
%}
<section class="section">
  <div class="wrap">
    <header class="section-head">
      <div>
        {% if section.settings.kicker != blank %}<p class="kicker" style="{% render 'field-style', font: section.settings.kicker_font, bold: section.settings.kicker_bold, italic: section.settings.kicker_italic, align: section.settings.kicker_align, valign: section.settings.kicker_valign, fill: section.settings.kicker_fill, size: section.settings.kicker_size, depth: section.settings.kicker_depth, amount: section.settings.kicker_depth_amount %}">{{ section.settings.kicker }}</p>{% endif %}
        <h2 class="display" style="{% render 'field-style', font: section.settings.heading_font, bold: section.settings.heading_bold, italic: section.settings.heading_italic, align: section.settings.heading_align, valign: section.settings.heading_valign, fill: section.settings.heading_fill, size: section.settings.heading_size, depth: section.settings.heading_depth, amount: section.settings.heading_depth_amount %}">{{ section.settings.heading }}</h2>
      </div>
    </header>
    <div class="live-grid">
      <div>
        <div class="stage">
          {% if provider == 'youtube' and yid != blank %}
            <iframe src="https://www.youtube.com/embed/{{ yid | escape }}?rel=0" title="Live show" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>
          {% elsif provider == 'twitch' and channel != blank %}
            <iframe src="https://player.twitch.tv/?channel={{ channel | url_encode }}&parent={{ request.host }}" title="Live show" allowfullscreen></iframe>
          {% else %}
            {% render 'wax', style: 'ice', label: 'Live' %}
            <div class="stage-lower">
              <span class="live-dot"></span>
              <span style="{% render 'field-style', font: section.settings.lower_font, bold: section.settings.lower_bold, italic: section.settings.lower_italic, align: section.settings.lower_align, valign: section.settings.lower_valign, fill: section.settings.lower_fill, size: section.settings.lower_size, depth: section.settings.lower_depth, amount: section.settings.lower_depth_amount %}">{{ section.settings.lower }}</span>
            </div>
          {% endif %}
        </div>
        {% if provider == 'youtube' and yid == blank %}
          <p class="fine" style="margin-top:0.6rem">Paste a YouTube link in this section. Until then the stage stays on the slab.</p>
        {% endif %}
        {% if provider == 'whatnot' or provider == 'off' %}
          <p class="muted" style="margin-top:0.7rem;{% render 'field-style', font: section.settings.note_font, bold: section.settings.note_bold, italic: section.settings.note_italic, align: section.settings.note_align, valign: section.settings.note_valign, fill: section.settings.note_fill, size: section.settings.note_size, depth: section.settings.note_depth, amount: section.settings.note_depth_amount %}">{{ section.settings.note }}</p>
          {% if whatnot != blank %}
            <a class="btn btn-primary" style="margin-top:0.6rem" href="{{ whatnot }}" target="_blank" rel="noreferrer">Open the Whatnot room</a>
          {% endif %}
        {% endif %}
      </div>
      <div>
        {% if section.settings.show_chat and provider == 'youtube' and yid != blank %}
          <div class="chat-frame">
            <iframe src="https://www.youtube.com/live_chat?v={{ yid | escape }}&embed_domain={{ request.host }}" title="Live chat"></iframe>
          </div>
        {% elsif section.settings.show_chat and provider == 'twitch' and channel != blank %}
          <div class="chat-frame">
            <iframe src="https://www.twitch.tv/embed/{{ channel | url_encode }}/chat?parent={{ request.host }}" title="Live chat"></iframe>
          </div>
        {% else %}
          <div class="panel" style="padding:1rem">
            <p class="kicker">Chat</p>
            <p class="muted" style="margin-top:0.35rem">YouTube and Twitch chat sit here when that provider is selected. Whatnot chat stays in the Whatnot app.</p>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>


{% render 'section-bg', section: section %}
{% liquid
  assign feed = section.settings.feed_url
  if feed == blank
    assign feed = 'https://www.youtube.com/embed/live_stream?channel=UC6uAyMzSKThKV7Xhk7s4qzA'
  endif
  assign yid = ''
  assign ysrc = ''
  if feed contains 'channel='
    assign chan = feed | split: 'channel=' | last | split: '&' | first | split: '/' | first
    assign ysrc = 'https://www.youtube.com/embed/live_stream?channel=' | append: chan | append: '&autoplay=1&mute=1&controls=0&rel=0&enablejsapi=1&origin=' | append: request.origin
  elsif feed contains 'watch?v='
    assign yid = feed | split: 'watch?v=' | last | split: '&' | first
  elsif feed contains 'youtu.be/'
    assign yid = feed | split: 'youtu.be/' | last | split: '?' | first
  elsif feed contains '/live/'
    assign yid = feed | split: '/live/' | last | split: '?' | first
  elsif feed contains '/embed/'
    assign yid = feed | split: '/embed/' | last | split: '?' | first
  endif
  if ysrc == blank and yid != blank
    assign ysrc = 'https://www.youtube.com/embed/' | append: yid | append: '?autoplay=1&mute=1&controls=0&rel=0&enablejsapi=1&origin=' | append: request.origin
  endif
  assign place = section.settings.place | default: 'left'
  assign dx = section.settings.x | default: 0
  assign dy = section.settings.y | default: 0
  assign dw = section.settings.feed_width | default: 760
  assign chat_w = section.settings.chat_width | default: 280
  assign wheel_w = section.settings.wheel_width | default: 280
  assign watcher = section.settings.watcher_url | default: 'https://ripwatch-production.up.railway.app/api/tick?clock=1&chat=1'
%}
{% style %}
  #shopify-section-{{ section.id }} .desk-title {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.35rem;
  }
  #shopify-section-{{ section.id }} > .section { position: relative; }
  #shopify-section-{{ section.id }} .desk-note {
    position: absolute;
    z-index: 4;
    margin: 0;
    overflow: auto;
  }
  #shopify-section-{{ section.id }} .desk-note p { display: block; margin: 0; }
  #shopify-section-{{ section.id }} .desk-note p + p { margin-top: 0.7rem; }
  #shopify-section-{{ section.id }} .desk-note p:empty { min-height: 1em; }
  #shopify-section-{{ section.id }} .desk-note,
  #shopify-section-{{ section.id }} .desk-note p,
  #shopify-section-{{ section.id }} .desk-note li,
  #shopify-section-{{ section.id }} .desk-note a {
    font-family: inherit;
    font-size: inherit;
    color: inherit;
    -webkit-text-fill-color: inherit;
    background-image: inherit;
    background-clip: inherit;
    -webkit-background-clip: inherit;
    text-shadow: inherit;
  }
  #shopify-section-{{ section.id }} .desk-note strong,
  #shopify-section-{{ section.id }} .desk-note b {
    color: {{ section.settings.note_bold_color | default: '#00e5ff' }};
    -webkit-text-fill-color: {{ section.settings.note_bold_color | default: '#00e5ff' }};
    background-image: none;
  }
  #shopify-section-{{ section.id }} .desk-note::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: #000;
    opacity: {{ section.settings.note_dark | default: 0 | times: 0.01 }};
    border-radius: inherit;
  }
  #shopify-section-{{ section.id }} .desk-note > * {
    position: relative;
    z-index: 1;
  }
  #shopify-section-{{ section.id }} .desk-status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  #shopify-section-{{ section.id }} .desk-status .live-dot {
    width: 0.72em;
    height: 0.72em;
    background: var(--dot, #00e5ff);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--dot, #00e5ff) 70%, transparent);
  }
  #shopify-section-{{ section.id }} .desk-status-text { display: inline-block; }
  #shopify-section-{{ section.id }} .desk-status .live-dot.is-steady {
    animation: none;
    box-shadow: none;
  }
  #shopify-section-{{ section.id }} .desk-board {
    display: grid;
    grid-template-columns: auto minmax(0, {{ chat_w }}px) minmax(0, {{ wheel_w }}px);
    justify-content: start;
    gap: 0.85rem;
    align-items: stretch;
  }
  #shopify-section-{{ section.id }} .desk-player {
    justify-self: start;
    align-self: start;
    width: min(100%, {{ dw }}px);
    margin-left: {{ dx }}px;
    margin-top: {{ dy }}px;
  }
  #shopify-section-{{ section.id }} .desk-player.is-center { justify-self: center; }
  #shopify-section-{{ section.id }} .desk-player.is-right { justify-self: end; }
  #shopify-section-{{ section.id }} .desk-player .stage {
    width: 100%;
    aspect-ratio: 9 / 16;
    min-height: 0;
    border: 0;
    box-shadow: none;
    border-radius: 0;
  }
  #shopify-section-{{ section.id }} .desk-crop {
    position: absolute;
    top: 0;
    left: 50%;
    width: 348%;
    height: 110%;
    transform: translateX(-50%);
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .desk-board .desk-player .stage iframe {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 2000% !important;
    height: 2000% !important;
    max-width: none !important;
    transform: scale(0.05) !important;
    transform-origin: top left !important;
    border: 0 !important;
  }
  #shopify-section-{{ section.id }} .desk-shield {
    position: absolute;
    inset: 0;
    z-index: 3;
    background: transparent;
  }
  #shopify-section-{{ section.id }} .desk-live-jump {
    position: absolute;
    z-index: 4;
    top: 10px;
    right: 10px;
    margin: 0;
    padding: 0.2rem 0.55rem;
    border: 1px solid #00ff3c;
    border-radius: 999px;
    background: rgba(4, 16, 24, 0.72);
    color: #00ff3c;
    font: 700 12px/1 "Barlow Condensed", sans-serif;
    letter-spacing: 0.14em;
    cursor: pointer;
  }
  #shopify-section-{{ section.id }} .desk-pause {
    position: absolute;
    z-index: 4;
    left: 50%;
    bottom: 10px;
    transform: translateX(-50%);
    margin: 0;
    padding: 0.2rem 0.7rem;
    border: 1px solid #ffe14a;
    border-radius: 999px;
    background: rgba(4, 16, 24, 0.72);
    color: #ffe14a;
    font: 700 12px/1 "Barlow Condensed", sans-serif;
    letter-spacing: 0.14em;
    white-space: nowrap;
    pointer-events: none;
  }
  #shopify-section-{{ section.id }} .desk-line {
    position: absolute;
    z-index: 5;
    margin: 0;
    white-space: pre-wrap;
  }
  #shopify-section-{{ section.id }} .desk-btn {
    position: absolute;
    z-index: 6;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    line-height: 1.15;
    text-decoration: none;
    padding: 0.35rem 0.8rem;
  }
  #shopify-section-{{ section.id }} .desk-btn span {
    white-space: pre-wrap;
  }
  #shopify-section-{{ section.id }} .desk-offair {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  #shopify-section-{{ section.id }} .desk-panel {
    position: relative;
    height: 100%;
    min-height: 0;
    max-height: none;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: transparent;
    box-shadow: none;
  }
  #shopify-section-{{ section.id }} .desk-panel::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: #000;
    opacity: var(--panel-dark, 0);
    border-radius: inherit;
  }
  #shopify-section-{{ section.id }} .desk-panel > * {
    position: relative;
    z-index: 1;
  }
  #shopify-section-{{ section.id }} .desk-head {
    flex: none;
  }
  #shopify-section-{{ section.id }} .desk-log {
    list-style: none;
    margin: 0.45rem 0 0;
    padding: 0;
    overflow: auto;
    flex: 1 1 auto;
    min-height: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  #shopify-section-{{ section.id }} .desk-log li {
    font-size: 0.82rem;
    line-height: 1.35;
    color: #d5e6ee;
  }
  #shopify-section-{{ section.id }} .desk-log .who {
    color: #00e5ff;
    font-weight: 700;
    margin-right: 0.3rem;
  }
  #shopify-section-{{ section.id }} .desk-empty {
    margin: 0.45rem 0 0;
    color: #8eafbf;
    font-size: 0.85rem;
  }
  #shopify-section-{{ section.id }} .desk-wheel li { color: #e7ff0e; }
  @media (max-width: 799px) {
    #shopify-section-{{ section.id }} .desk-board { grid-template-columns: 1fr; }
    #shopify-section-{{ section.id }} .desk-player { width: min(100%, {{ dw }}px); }
    #shopify-section-{{ section.id }} .desk-chat-panel,
    #shopify-section-{{ section.id }} .desk-wheel-panel { width: 100% !important; }
    #shopify-section-{{ section.id }} .desk-panel { min-height: 320px; height: 320px; }
  }
{% endstyle %}
<section class="section" style="padding-top: {{ section.settings.pad_top }}px; padding-bottom: {{ section.settings.pad_bottom }}px;{% if section.settings.sec_height > 0 %}height: {{ section.settings.sec_height }}px !important; min-height: {{ section.settings.sec_height }}px !important; max-height: {{ section.settings.sec_height }}px !important; overflow: hidden !important;{% endif %}">
  <div class="wrap">
    <header class="section-head">
      {% liquid
        if section.settings.stream_live
          assign status_color = section.settings.status_on_color | default: '#00ff3c'
        else
          assign status_color = section.settings.status_off_color | default: '#9aa8b2'
        endif
      %}
      <div class="desk-title">
        <p class="kicker desk-status" style="{% render 'field-style', font: section.settings.kicker_font, bold: section.settings.kicker_bold, italic: section.settings.kicker_italic, align: section.settings.kicker_align, valign: section.settings.kicker_valign, fill: section.settings.kicker_fill, fill_2: section.settings.kicker_fill_2, color: status_color, size: section.settings.kicker_size, depth: section.settings.kicker_depth, amount: section.settings.kicker_depth_amount, shadow: section.settings.kicker_depth_color %}">
          <span class="live-dot{% unless section.settings.stream_live %} is-steady{% endunless %}" style="--dot: {{ status_color }}; transform: translate({{ section.settings.dot_x | default: 0 }}px, {{ section.settings.dot_y | default: 0 }}px);"></span>
          <span class="desk-status-text" style="transform: translate({{ section.settings.status_x | default: 0 }}px, {{ section.settings.status_y | default: 0 }}px);">{% if section.settings.stream_live %}{{ section.settings.status_on | default: 'Stream is LIVE' }}{% else %}{{ section.settings.status_off | default: 'Stream offline' }}{% endif %}</span>
        </p>
        <h2 class="display" style="transform: translate({{ section.settings.heading_x | default: 0 }}px, {{ section.settings.heading_y | default: 0 }}px); {% render 'field-style', font: section.settings.heading_font, bold: section.settings.heading_bold, italic: section.settings.heading_italic, align: section.settings.heading_align, valign: section.settings.heading_valign, fill: section.settings.heading_fill, fill_2: section.settings.heading_fill_2, color: section.settings.heading_color, size: section.settings.heading_size, depth: section.settings.heading_depth, amount: section.settings.heading_depth_amount, shadow: section.settings.heading_depth_color %}">{{ section.settings.heading }}</h2>
      </div>
    </header>
    <div class="desk-board"{% if section.settings.show_room %} data-desk-side data-watcher="{{ watcher | escape }}"{% endif %}>
      <div class="desk-player is-{{ place }}" data-desk-player style="{% render 'box-edge', width: section.settings.feed_border, style: section.settings.feed_border_style, color: section.settings.feed_border_color, radius: section.settings.feed_radius, pad_top: section.settings.feed_pad_top, pad_right: section.settings.feed_pad_right, pad_bottom: section.settings.feed_pad_bottom, pad_left: section.settings.feed_pad_left %}">
        <div class="stage">
          {% if section.settings.stream_live and ysrc != blank %}
            <div class="desk-crop">
              <iframe id="desk-yt-{{ section.id }}" src="{{ ysrc }}" title="Live show" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe>
            </div>
            <div class="desk-shield"></div>
            <button type="button" class="desk-live-jump" data-desk-live>GO TO LIVE</button>
            <span class="desk-pause">PAUSE BUTTON WILL GO AWAY</span>
          {% elsif section.settings.stream_live %}
            <div class="feed-card">
              <span class="live-dot is-off"></span>
              <p class="kicker">Offline</p>
              <p>Paste a YouTube link under Live desk, Edit, Feed.</p>
            </div>
          {% elsif section.settings.offair_image != blank %}
            {{ section.settings.offair_image | image_url: width: 1400 | image_tag: class: 'desk-offair', alt: 'Off air', widths: '400, 800, 1200, 1400' }}
          {% else %}
            <img class="desk-offair" src="{{ 'off-air.jpg' | asset_url }}" alt="Off air" width="1008" height="1792">
          {% endif %}
        </div>
      </div>
      {% if section.settings.show_room %}
        <div class="panel desk-panel desk-chat-panel" style="--panel-dark: {{ section.settings.chat_dark | default: 0 | times: 0.01 }}; width: min(100%, {{ chat_w }}px); transform: translate({{ section.settings.chat_x | default: 0 }}px, {{ section.settings.chat_y | default: 0 }}px);{% if section.settings.chat_height > 0 %} align-self: start; height: {{ section.settings.chat_height }}px; min-height: {{ section.settings.chat_height }}px; max-height: {{ section.settings.chat_height }}px;{% endif %} {% render 'box-edge', width: section.settings.chat_border, style: section.settings.chat_border_style, color: section.settings.chat_border_color, radius: section.settings.chat_radius, pad_top: section.settings.chat_pad_top, pad_right: section.settings.chat_pad_right, pad_bottom: section.settings.chat_pad_bottom, pad_left: section.settings.chat_pad_left %}">
          <p class="kicker desk-head" style="{% render 'field-style', font: section.settings.chat_font, bold: section.settings.chat_bold, italic: section.settings.chat_italic, align: section.settings.chat_align, valign: section.settings.chat_valign, fill: section.settings.chat_fill, fill_2: section.settings.chat_fill_2, color: section.settings.chat_color, size: section.settings.chat_size, depth: section.settings.chat_depth, amount: section.settings.chat_depth_amount, shadow: section.settings.chat_depth_color %}">{{ section.settings.chat_heading | default: 'Whatnot chat' }}</p>
          <p class="desk-empty" data-desk-chat-empty>Waiting for the watcher.</p>
          <ul class="desk-log" data-desk-chat hidden></ul>
        </div>
        <div class="panel desk-panel desk-wheel-panel" style="--panel-dark: {{ section.settings.wheel_dark | default: 0 | times: 0.01 }}; width: min(100%, {{ wheel_w }}px); transform: translate({{ section.settings.wheel_x | default: 0 }}px, {{ section.settings.wheel_y | default: 0 }}px);{% if section.settings.wheel_height > 0 %} align-self: start; height: {{ section.settings.wheel_height }}px; min-height: {{ section.settings.wheel_height }}px; max-height: {{ section.settings.wheel_height }}px;{% endif %} {% render 'box-edge', width: section.settings.wheel_border, style: section.settings.wheel_border_style, color: section.settings.wheel_border_color, radius: section.settings.wheel_radius, pad_top: section.settings.wheel_pad_top, pad_right: section.settings.wheel_pad_right, pad_bottom: section.settings.wheel_pad_bottom, pad_left: section.settings.wheel_pad_left %}">
          <p class="kicker desk-head" style="{% render 'field-style', font: section.settings.wheel_font, bold: section.settings.wheel_bold, italic: section.settings.wheel_italic, align: section.settings.wheel_align, valign: section.settings.wheel_valign, fill: section.settings.wheel_fill, fill_2: section.settings.wheel_fill_2, color: section.settings.wheel_color, size: section.settings.wheel_size, depth: section.settings.wheel_depth, amount: section.settings.wheel_depth_amount, shadow: section.settings.wheel_depth_color %}">{{ section.settings.wheel_heading | default: 'Wheel hits' }}</p>
          <p class="desk-empty" data-desk-wheel-empty>No spins yet.</p>
          <ul class="desk-log desk-wheel" data-desk-wheel hidden></ul>
        </div>
      {% endif %}
    </div>
  </div>
  {% liquid
    assign desk_note = section.settings.note | strip_html | strip
  %}
  {% if desk_note != blank %}
    <div class="desk-note rte" style="left: {{ section.settings.note_x | default: 0 }}px; top: {{ section.settings.note_y | default: 0 }}px; width: {{ section.settings.note_w | default: 320 }}px;{% if section.settings.note_h > 0 %} height: {{ section.settings.note_h }}px;{% endif %} box-sizing: border-box; border: {{ section.settings.note_border | default: 0 }}px {{ section.settings.note_border_style | default: 'solid' }} {{ section.settings.note_border_color | default: '#00e5ff' }}; border-radius: {{ section.settings.note_radius | default: 0 }}px; padding: {{ section.settings.note_pad_top | default: 0 }}px {{ section.settings.note_pad_right | default: 0 }}px {{ section.settings.note_pad_bottom | default: 0 }}px {{ section.settings.note_pad_left | default: 0 }}px; {% render 'field-style', font: section.settings.note_font, fill: section.settings.note_fill, fill_2: section.settings.note_fill_2, color: section.settings.note_color, size: section.settings.note_size, depth: section.settings.note_depth, amount: section.settings.note_depth_amount, shadow: section.settings.note_depth_color %}">{% render 'rte-paras', html: section.settings.note %}</div>
  {% endif %}
  {% if section.settings.line != blank %}
    <p class="desk-line" style="left: {{ section.settings.line_x | default: 0 }}px; top: {{ section.settings.line_y | default: 0 }}px; {% render 'field-style', font: section.settings.line_font, bold: section.settings.line_bold, italic: section.settings.line_italic, align: section.settings.line_align, valign: section.settings.line_valign, fill: section.settings.line_fill, fill_2: section.settings.line_fill_2, color: section.settings.line_color, size: section.settings.line_size, depth: section.settings.line_depth, amount: section.settings.line_depth_amount, shadow: section.settings.line_depth_color %}">{{ section.settings.line }}</p>
  {% endif %}
  {% if section.settings.btn_label != blank %}
    {% capture btn_box %}left: {{ section.settings.btn_x | default: 0 }}px; top: {{ section.settings.btn_y | default: 0 }}px;{% if section.settings.btn_w > 0 %} width: {{ section.settings.btn_w }}px;{% endif %}{% if section.settings.btn_h > 0 %} height: {{ section.settings.btn_h }}px;{% endif %} border-radius: {{ section.settings.btn_radius | default: 12 }}px; --cell-border: {{ section.settings.btn_border | default: 1 }}px; --cell-border-color: {{ section.settings.btn_border_color | default: '#00EAFF' }}; --fill: {{ section.settings.btn_color | default: '#0E1C28' }}; --fill-2: {{ section.settings.btn_color_2 | default: '#00E5FF' }}; --fill-angle: {{ section.settings.btn_angle | default: 90 }}deg; --depth: {{ section.settings.btn_depth_amount | default: 6 }}px; --depth-color: {{ section.settings.btn_depth_color | default: '#00E5FF' }};{% endcapture %}
    {% capture btn_face %}{% render 'field-style', font: section.settings.btn_font, bold: section.settings.btn_bold, italic: section.settings.btn_italic, align: section.settings.btn_align, valign: section.settings.btn_valign, fill: section.settings.btn_text_fill, fill_2: section.settings.btn_text_fill_2, color: section.settings.btn_text_color, size: section.settings.btn_size, depth: section.settings.btn_text_depth, amount: section.settings.btn_text_depth_amount, shadow: section.settings.btn_text_depth_color %}{% endcapture %}
    {% if section.settings.btn_link != blank %}
      <a class="desk-btn image-cell {% if section.settings.btn_show_cell == false %}is-clear{% else %}fill-{{ section.settings.btn_fill | default: 'solid' }}{% endif %} depth-{{ section.settings.btn_depth | default: 'neon' }}" href="{{ section.settings.btn_link }}" style="{{ btn_box }}"><span style="{{ btn_face }}">{{ section.settings.btn_label }}</span></a>
    {% else %}
      <span class="desk-btn image-cell {% if section.settings.btn_show_cell == false %}is-clear{% else %}fill-{{ section.settings.btn_fill | default: 'solid' }}{% endif %} depth-{{ section.settings.btn_depth | default: 'neon' }}" style="{{ btn_box }}"><span style="{{ btn_face }}">{{ section.settings.btn_label }}</span></span>
    {% endif %}
  {% endif %}
</section>
{% if section.settings.stream_live and ysrc != blank %}
<script>
  (function () {
    var frame = document.getElementById('desk-yt-{{ section.id }}');
    var btn = document.querySelector('#shopify-section-{{ section.id }} [data-desk-live]');
    if (!frame || !btn) return;
    btn.addEventListener('click', function () {
      if (!frame.contentWindow) return;
      frame.contentWindow.postMessage(JSON.stringify({
        event: 'command',
        func: 'seekTo',
        args: [1000000000, true],
        id: frame.id,
        channel: 'widget'
      }), '*');
    });
  })();
</script>
{% endif %}
{% if section.settings.show_room %}
<script>
  (function () {
    var side = document.querySelector('#shopify-section-{{ section.id }} [data-desk-side]');
    if (!side) return;
    var url = side.getAttribute('data-watcher');
    var chatList = side.querySelector('[data-desk-chat]');
    var chatEmpty = side.querySelector('[data-desk-chat-empty]');
    var wheelList = side.querySelector('[data-desk-wheel]');
    var wheelEmpty = side.querySelector('[data-desk-wheel-empty]');
    var last = '';
    function lobby(text) {
      return /^Live\s*·/.test(text) || /Sponsored Live/.test(text) || /^@[\w.]+$/.test(text);
    }
    function wheelLine(text) {
      return /\bgot\b/i.test(text) || /\bspin\b/i.test(text) || /\bspun\b/i.test(text) || /wheel/i.test(text);
    }
    function row(item) {
      var li = document.createElement('li');
      if (item.username) {
        var who = document.createElement('span');
        who.className = 'who';
        who.textContent = item.username;
        li.appendChild(who);
      }
      li.appendChild(document.createTextNode(item.text));
      return li;
    }
    function paint(data) {
      var lines = Array.isArray(data.roomChat) ? data.roomChat : [];
      var chat = [];
      var wheels = [];
      for (var i = 0; i < lines.length; i++) {
        var item = lines[i] || {};
        var text = String(item.text || '').replace(/\s+/g, ' ').trim();
        if (!text || lobby(text)) continue;
        var clean = { username: String(item.username || '').trim(), text: text };
        if (wheelLine(text)) wheels.push(clean);
        else chat.push(clean);
      }
      if (data.giveawayWinner) {
        wheels.push({ username: '', text: 'Giveaway · ' + data.giveawayWinner });
      }
      chat = chat.slice(-40);
      wheels = wheels.slice(-12);
      var snap = JSON.stringify([chat, wheels]);
      if (snap === last) return;
      last = snap;
      chatList.replaceChildren.apply(chatList, chat.map(row));
      wheelList.replaceChildren.apply(wheelList, wheels.map(row));
      chatList.hidden = chat.length === 0;
      chatEmpty.hidden = chat.length > 0;
      wheelList.hidden = wheels.length === 0;
      wheelEmpty.hidden = wheels.length > 0;
      chatEmpty.textContent = chat.length ? '' : 'Waiting for the room chat.';
    }
    function pull() {
      fetch(url, { cache: 'no-store' })
        .then(function (res) { return res.ok ? res.json() : Promise.reject(); })
        .then(paint)
        .catch(function () {

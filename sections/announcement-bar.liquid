      "default": false
    },
    {
      "type": "checkbox",
      "id": "text_italic",
      "label": "Text italic",
      "default": false
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text horizontal",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Theme default"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",

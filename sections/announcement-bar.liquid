{% render 'section-bg', section: section %}
{% if section.settings.enabled and section.settings.text != blank %}
  {% capture announce_style %}{% render 'field-style', font: section.settings.text_font, bold: section.settings.text_bold, italic: section.settings.text_italic, align: section.settings.text_align, valign: section.settings.text_valign, fill: section.settings.text_fill, fill_2: section.settings.text_fill_2, color: section.settings.text_color, size: section.settings.text_size, depth: section.settings.text_depth, amount: section.settings.text_depth_amount, shadow: section.settings.text_depth_color %}{% endcapture %}
  <div class="ticker-slot" style="padding-top: {{ section.settings.pad_top | default: 0 }}px; padding-bottom: {{ section.settings.pad_bottom | default: 0 }}px;">
  <div class="bar-fill fill-{{ section.settings.fill }}" style="--bar-h: {{ section.settings.bar_height }}px; --fill: {{ section.settings.fill_color }}; --fill-2: {{ section.settings.fill_color_2 }}; --fill-angle: {{ section.settings.fill_angle }}deg;">
    {% if section.settings.link != blank %}
      <a class="announce" href="{{ section.settings.link }}" style="{{ announce_style }}">{{ section.settings.text }}</a>
    {% else %}
      <p class="announce" style="{{ announce_style }}">{{ section.settings.text }}</p>
    {% endif %}
  </div>
  </div>
{% endif %}

{% schema %}

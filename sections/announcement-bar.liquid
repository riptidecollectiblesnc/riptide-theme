{% if section.settings.enabled and section.settings.text != blank %}
  {% capture announce_style %}{% render 'field-style', color: section.settings.text_color, size: section.settings.text_size, depth: section.settings.text_depth, amount: section.settings.text_depth_amount, shadow: section.settings.text_depth_color %}{% endcapture %}
  {% if section.settings.link != blank %}
    <a class="announce" href="{{ section.settings.link }}" style="{{ announce_style }}">{{ section.settings.text }}</a>
  {% else %}
    <p class="announce" style="{{ announce_style }}">{{ section.settings.text }}</p>
  {% endif %}
{% endif %}

{% schema %}
{
  "name": "Announcement",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Show announcement",
      "default": true
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Thursday through Saturday, 9:30 PM ET on Whatnot. In-house live is paused."
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#d5e6ee"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "Text size",
      "min": 10,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "select",
      "id": "text_depth",
      "label": "Text depth",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "soft",
          "label": "Soft shadow"
        },
        {
          "value": "hard",
          "label": "Hard offset"
        },
        {
          "value": "neon",
          "label": "Neon glow"
        }
      ]
    },
    {
      "type": "range",
      "id": "text_depth_amount",
      "label": "Text depth amount",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "color",
      "id": "text_depth_color",
      "label": "Text depth color",
      "default": "#00e5ff"
    },
    {
      "type": "text",
      "id": "link",
      "label": "Link",
      "default": "#shopify-section-whatnot",
      "info": "A full URL or a homepage anchor such as #shopify-section-live."
    }
  ]
}
{% endschema %}

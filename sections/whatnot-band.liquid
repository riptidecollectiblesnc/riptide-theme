{% render 'section-bg', section: section %}
{% assign room = section.settings.room | default: settings.whatnot_url %}
<section class="section whatnot-section" style="padding-top: {{ section.settings.pad_top }}px; padding-bottom: {{ section.settings.pad_bottom }}px;">
  <div class="wrap">
    <header class="section-head">
      <div>
        <p class="kicker" style="{% render 'field-style', font: section.settings.kicker_font, bold: section.settings.kicker_bold, italic: section.settings.kicker_italic, align: section.settings.kicker_align, valign: section.settings.kicker_valign, fill: section.settings.kicker_fill, fill_2: section.settings.kicker_fill_2, color: section.settings.kicker_color, size: section.settings.kicker_size, depth: section.settings.kicker_depth, amount: section.settings.kicker_depth_amount, shadow: section.settings.kicker_depth_color %}">{{ section.settings.kicker }}</p>
        <h2 class="display" style="{% render 'field-style', font: section.settings.heading_font, bold: section.settings.heading_bold, italic: section.settings.heading_italic, align: section.settings.heading_align, valign: section.settings.heading_valign, fill: section.settings.heading_fill, fill_2: section.settings.heading_fill_2, color: section.settings.heading_color, size: section.settings.heading_size, depth: section.settings.heading_depth, amount: section.settings.heading_depth_amount, shadow: section.settings.heading_depth_color %}">{{ section.settings.heading }}</h2>
      </div>
      {% if room != blank %}
        <a class="btn btn-primary" href="{{ room }}" target="_blank" rel="noreferrer">Open Whatnot</a>
      {% endif %}
    </header>
    <p class="lede" style="margin-top:0;{% render 'field-style', font: section.settings.text_font, bold: section.settings.text_bold, italic: section.settings.text_italic, align: section.settings.text_align, valign: section.settings.text_valign, fill: section.settings.text_fill, fill_2: section.settings.text_fill_2, color: section.settings.text_color, size: section.settings.text_size, depth: section.settings.text_depth, amount: section.settings.text_depth_amount, shadow: section.settings.text_depth_color %}">{{ section.settings.text }}</p>
    {% if section.blocks.size > 0 %}
      <ul class="schedule">
        {% for block in section.blocks %}
          <li class="panel" {{ block.shopify_attributes }}>
            <strong style="{% render 'field-style', font: block.settings.day_font, bold: block.settings.day_bold, italic: block.settings.day_italic, align: block.settings.day_align, valign: block.settings.day_valign, fill: block.settings.day_fill, fill_2: block.settings.day_fill_2, color: block.settings.day_color, size: block.settings.day_size, depth: block.settings.day_depth, amount: block.settings.day_depth_amount, shadow: block.settings.day_depth_color %}">{{ block.settings.day }}</strong>
            <span style="{% render 'field-style', font: block.settings.time_font, bold: block.settings.time_bold, italic: block.settings.time_italic, align: block.settings.time_align, valign: block.settings.time_valign, fill: block.settings.time_fill, fill_2: block.settings.time_fill_2, color: block.settings.time_color, size: block.settings.time_size, depth: block.settings.time_depth, amount: block.settings.time_depth_amount, shadow: block.settings.time_depth_color %}">{{ block.settings.time }}</span>
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</section>


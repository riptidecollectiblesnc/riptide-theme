{% assign room = section.settings.room | default: settings.whatnot_url %}
<section class="section whatnot-section">
  <div class="wrap">
    <header class="section-head">
      <div>
        <p class="kicker" style="{% render 'field-style', color: section.settings.kicker_color, size: section.settings.kicker_size, depth: section.settings.kicker_depth, amount: section.settings.kicker_depth_amount, shadow: section.settings.kicker_depth_color %}">{{ section.settings.kicker }}</p>
        <h2 class="display" style="{% render 'field-style', color: section.settings.heading_color, size: section.settings.heading_size, depth: section.settings.heading_depth, amount: section.settings.heading_depth_amount, shadow: section.settings.heading_depth_color %}">{{ section.settings.heading }}</h2>
      </div>
      {% if room != blank %}
        <a class="btn btn-primary" href="{{ room }}" target="_blank" rel="noreferrer">Open Whatnot</a>
      {% endif %}
    </header>
    <p class="lede" style="margin-top:0;{% render 'field-style', color: section.settings.text_color, size: section.settings.text_size, depth: section.settings.text_depth, amount: section.settings.text_depth_amount, shadow: section.settings.text_depth_color %}">{{ section.settings.text }}</p>
    {% if section.blocks.size > 0 %}
      <ul class="schedule">
        {% for block in section.blocks %}
          <li class="panel" {{ block.shopify_attributes }}>
            <strong style="{% render 'field-style', color: block.settings.day_color, size: block.settings.day_size, depth: block.settings.day_depth, amount: block.settings.day_depth_amount, shadow: block.settings.day_depth_color %}">{{ block.settings.day }}</strong>
            <span style="{% render 'field-style', color: block.settings.time_color, size: block.settings.time_size, depth: block.settings.time_depth, amount: block.settings.time_depth_amount, shadow: block.settings.time_depth_color %}">{{ block.settings.time }}</span>
          </li>
        {% endfor %}
      </ul>
    {% endif %}
  </div>
</section>


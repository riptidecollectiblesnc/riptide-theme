<section class="section">
  <div class="wrap">
    <header class="section-head">
      <div>
        {% if section.settings.kicker != blank %}<p class="kicker">{{ section.settings.kicker }}</p>{% endif %}
        <h2 class="display">{{ section.settings.heading }}</h2>
      </div>
    </header>
    <div class="grid-cards">
      {% if section.settings.collection != blank %}
        {% for product in section.settings.collection.products limit: section.settings.limit %}
          {% render 'product-card', product: product %}
        {% endfor %}
      {% else %}
        {% assign shown = 0 %}
        {% for product in collections.all.products %}
          {% if shown < section.settings.limit %}
            {% if product.tags contains 'break' or product.tags contains 'pack-wars' %}
              {% render 'product-card', product: product %}
              {% assign shown = shown | plus: 1 %}
            {% endif %}
          {% endif %}
        {% endfor %}
        {% if shown == 0 and request.design_mode %}
          <p class="muted">Tag a product <strong>break</strong> or <strong>pack-wars</strong>, or pick a Breaks collection. One variant per spot.</p>
        {% endif %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Break list",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "On the board" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Breaks" },
    { "type": "collection", "id": "collection", "label": "Breaks collection", "info": "Or leave empty and tag products break or pack-wars." },
    { "type": "range", "id": "limit", "label": "Products", "min": 4, "max": 12, "step": 4, "default": 4 }
  ],
  "presets": [{ "name": "Break list" }]
}
{% endschema %}

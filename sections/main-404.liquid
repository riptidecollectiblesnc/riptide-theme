<section class="section" style="padding-top: {{ section.settings.pad_top }}px; padding-bottom: {{ section.settings.pad_bottom }}px;">
  <div class="wrap">
    <p class="kicker">404</p>
    <h1 class="display">That page is not on the shelf.</h1>
    <a class="btn btn-primary" style="margin-top:1rem" href="{{ routes.root_url }}">Back to the shop</a>
  </div>
</section>

{% schema %}
{
  "name": "404",
  "settings": [
    {
      "type": "header",
      "content": "Section space"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Top space",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 52,
      "info": "Space above and below this section."
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Bottom space",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 52,
      "info": "Space above and below this section."
    }
  ]
}
{% endschema %}

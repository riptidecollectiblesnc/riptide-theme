{% liquid
  assign alt = section.settings.alt
  if alt == blank and section.settings.image != blank
    assign alt = section.settings.image.alt
  endif
  if alt == blank
    assign alt = shop.name
  endif
  assign ratio = section.settings.ratio
%}
<section class="section image-section" style="padding-top: {{ section.settings.pad_top }}px; padding-bottom: {{ section.settings.pad_bottom }}px;">
  <div class="wrap">
    <div
      class="image-hold place-{{ section.settings.place }}{% if ratio != 'natural' %} has-ratio{% endif %}"
      style="--img-w: {{ section.settings.size }}%; --img-x: {{ section.settings.x }}px; --img-y: {{ section.settings.y }}px; --img-ratio: {{ ratio }}; --img-fit: {{ section.settings.fit }}; --img-pos: {{ section.settings.crop_x }} {{ section.settings.crop_y }};"
    >
      {% if section.settings.image != blank %}
        {% if section.settings.link != blank %}
          <a href="{{ section.settings.link }}">
            {{ section.settings.image | image_url: width: 2000 | image_tag: alt: alt, loading: 'lazy', widths: '400, 800, 1200, 1600, 2000' }}
          </a>
        {% else %}
          {{ section.settings.image | image_url: width: 2000 | image_tag: alt: alt, loading: 'lazy', widths: '400, 800, 1200, 1600, 2000' }}
        {% endif %}
      {% else %}
        <div class="image-empty">Add an image in this section.</div>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Image",
  "enabled_on": {
    "templates": [
      "*"
    ]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "alt",
      "label": "Alt text",
      "info": "Read by screen readers. Leave blank to use the image's own alt text."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "info": "Optional. The image becomes a link."
    },
    {
      "type": "header",
      "content": "Ratio"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Ratio",
      "default": "natural",
      "options": [
        {
          "value": "natural",
          "label": "Natural"
        },
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "4 / 5",
          "label": "Portrait"
        },
        {
          "value": "3 / 4",
          "label": "Tall"
        },
        {
          "value": "2 / 3",
          "label": "Card"
        },
        {
          "value": "16 / 9",
          "label": "Wide"
        },
        {
          "value": "21 / 9",
          "label": "Banner"
        }
      ]
    },
    {
      "type": "select",
      "id": "fit",
      "label": "Fit",
      "default": "cover",
      "options": [
        {
          "value": "cover",
          "label": "Fill and crop"
        },
        {
          "value": "contain",
          "label": "Fit inside"
        }
      ],
      "info": "Used when a ratio is set. Natural shows the whole image."
    },
    {
      "type": "header",
      "content": "Size"
    },
    {
      "type": "range",
      "id": "size",
      "label": "Size",
      "min": 20,
      "max": 100,
      "step": 2,
      "unit": "%",
      "default": 100,
      "info": "Width of the image inside the section."
    },
    {
      "type": "header",
      "content": "Position"
    },
    {
      "type": "select",
      "id": "place",
      "label": "Place",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "info": "Where the image sits in the row."
    },
    {
      "type": "range",
      "id": "x",
      "label": "X axis",
      "min": -200,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "Moves the image left or right. Positive moves right."
    },
    {
      "type": "range",
      "id": "y",
      "label": "Y axis",
      "min": -200,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 0,
      "info": "Moves the image up or down. Positive moves down."
    },
    {
      "type": "select",
      "id": "crop_x",
      "label": "Crop horizontal",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "info": "Which side stays visible when Fill and crop cuts the image."
    },
    {
      "type": "select",
      "id": "crop_y",
      "label": "Crop vertical",
      "default": "center",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "header",
      "content": "Section space"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Top space",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Bottom space",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "Image"
    }
  ]
}
{% endschema %}

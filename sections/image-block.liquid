{% render 'section-bg', section: section %}
{% liquid
  assign alt = section.settings.alt
  if alt == blank and section.settings.image != blank
    assign alt = section.settings.image.alt
  endif
  if alt == blank
    assign alt = shop.name
  endif
  assign ratio = section.settings.ratio
%}
<section class="section image-section" style="padding-top: {{ section.settings.pad_top }}px; padding-bottom: {{ section.settings.pad_bottom }}px;">
  <div class="wrap">
    <div
      class="image-hold place-{{ section.settings.place }}{% if section.settings.ratio_lock == false %} is-unlocked{% endif %}{% if ratio != 'natural' %} has-ratio{% endif %}"
      style="--img-w: {{ section.settings.width_px | default: 1600 }}px; --img-h: {{ section.settings.height_px | default: 400 }}px; --img-x: {{ section.settings.x }}px; --img-y: {{ section.settings.y }}px; --img-ratio: {{ ratio }}; --img-fit: {{ section.settings.fit }}; --img-pos: {{ section.settings.crop_x }} {{ section.settings.crop_y }};"
    >
      <div
        class="image-cell {% if section.settings.show_cell == false %}is-clear{% else %}fill-{{ section.settings.cell_fill | default: 'none' }}{% endif %} depth-{{ section.settings.cell_depth | default: 'soft' }}"
        style="--cell-border: {{ section.settings.border_width | default: 1 }}px; --cell-border-color: {{ section.settings.border_color | default: '#00EAFF' }}; --fill: {{ section.settings.cell_color | default: '#0E1C28' }}; --fill-2: {{ section.settings.cell_color_2 | default: '#00E5FF' }}; --fill-angle: {{ section.settings.cell_angle | default: 90 }}deg; --depth: {{ section.settings.cell_depth_amount | default: 6 }}px; --depth-color: {{ section.settings.cell_depth_color | default: '#00E5FF' }};"
      >
      {% if section.settings.image != blank %}
        {% if section.settings.link != blank %}
          <a href="{{ section.settings.link }}">
            {{ section.settings.image | image_url: width: 2000 | image_tag: alt: alt, loading: 'lazy', widths: '400, 800, 1200, 1600, 2000' }}
          </a>
        {% else %}
          {{ section.settings.image | image_url: width: 2000 | image_tag: alt: alt, loading: 'lazy', widths: '400, 800, 1200, 1600, 2000' }}
        {% endif %}
      {% else %}
        <div class="image-empty">Add an image in this section.</div>
      {% endif %}
      </div>
    </div>
  </div>
</section>


{% render 'section-bg', section: section %}
<footer class="site-footer" style="padding-top: {{ section.settings.pad_top }}px; padding-bottom: {{ section.settings.pad_bottom }}px;">
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <p class="display foot-name">{{ shop.name }}</p>
        <p class="muted" style="margin-top:0.55rem;max-width:28rem;{% render 'field-style', font: section.settings.blurb_font, bold: section.settings.blurb_bold, italic: section.settings.blurb_italic, align: section.settings.blurb_align, valign: section.settings.blurb_valign, fill: section.settings.blurb_fill, fill_2: section.settings.blurb_fill_2, color: section.settings.blurb_color, size: section.settings.blurb_size, depth: section.settings.blurb_depth, amount: section.settings.blurb_depth_amount, shadow: section.settings.blurb_depth_color %}">{{ section.settings.blurb }}</p>
      </div>
      <div>
        <p class="kicker">Shop</p>
        {% if section.settings.menu != blank %}
          {% for link in section.settings.menu.links %}
            <a class="nav-link" href="{{ link.url }}">{{ link.title }}</a>
          {% endfor %}
        {% else %}
          <a class="nav-link" href="{{ routes.all_products_collection_url }}">All wax</a>
          <a class="nav-link" href="{{ routes.root_url }}#shopify-section-breaks">Breaks</a>
          <a class="nav-link" href="{{ routes.cart_url }}">Cart</a>
        {% endif %}
      </div>
      <div>
        <p class="kicker">Shows</p>
        <a class="nav-link" href="{{ routes.root_url }}#shopify-section-live">Live stage</a>
        <a class="nav-link" href="{{ routes.root_url }}#shopify-section-auctions">Auctions</a>
        {% if settings.whatnot_url != blank %}
          <a class="btn btn-ghost" style="margin-top:0.6rem" href="{{ settings.whatnot_url }}" target="_blank" rel="noreferrer">Whatnot room</a>
        {% endif %}
      </div>
    </div>
    <p class="fine foot-copy">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Crystal Coast.</p>
  </div>
</footer>


<footer class="site-footer">
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <p class="display foot-name">{{ shop.name }}</p>
        <p class="muted" style="margin-top:0.55rem;max-width:28rem;{% render 'field-style', color: section.settings.blurb_color, size: section.settings.blurb_size, depth: section.settings.blurb_depth, amount: section.settings.blurb_depth_amount, shadow: section.settings.blurb_depth_color %}">{{ section.settings.blurb }}</p>
      </div>
      <div>
        <p class="kicker">Shop</p>
        {% if section.settings.menu != blank %}
          {% for link in section.settings.menu.links %}
            <a class="nav-link" href="{{ link.url }}">{{ link.title }}</a>
          {% endfor %}
        {% else %}
          <a class="nav-link" href="{{ routes.all_products_collection_url }}">All wax</a>
          <a class="nav-link" href="{{ routes.root_url }}#shopify-section-breaks">Breaks</a>
          <a class="nav-link" href="{{ routes.cart_url }}">Cart</a>
        {% endif %}
      </div>
      <div>
        <p class="kicker">Shows</p>
        <a class="nav-link" href="{{ routes.root_url }}#shopify-section-live">Live stage</a>
        <a class="nav-link" href="{{ routes.root_url }}#shopify-section-auctions">Auctions</a>
        {% if settings.whatnot_url != blank %}
          <a class="btn btn-ghost" style="margin-top:0.6rem" href="{{ settings.whatnot_url }}" target="_blank" rel="noreferrer">Whatnot room</a>
        {% endif %}
      </div>
    </div>
    <p class="fine foot-copy">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Crystal Coast.</p>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "blurb",
      "label": "Blurb",
      "default": "Online-only from the Crystal Coast. Sealed wax, breaks, and live shows."
    },
    {
      "type": "color",
      "id": "blurb_color",
      "label": "Blurb color",
      "default": "#8eafbf"
    },
    {
      "type": "range",
      "id": "blurb_size",
      "label": "Blurb size",
      "min": 10,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "blurb_depth",
      "label": "Blurb depth",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "soft",
          "label": "Soft shadow"
        },
        {
          "value": "hard",
          "label": "Hard offset"
        },
        {
          "value": "neon",
          "label": "Neon glow"
        }
      ]
    },
    {
      "type": "range",
      "id": "blurb_depth_amount",
      "label": "Blurb depth amount",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "color",
      "id": "blurb_depth_color",
      "label": "Blurb depth color",
      "default": "#00e5ff"
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    }
  ]
}
{% endschema %}

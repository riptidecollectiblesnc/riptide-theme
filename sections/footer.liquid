<footer class="site-footer">
  <div class="wrap">
    <div class="foot-grid">
      <div>
        <p class="display foot-name">{{ shop.name }}</p>
        <p class="muted" style="margin-top:0.55rem;max-width:28rem;{% render 'field-style', font: section.settings.blurb_font, bold: section.settings.blurb_bold, italic: section.settings.blurb_italic, align: section.settings.blurb_align, valign: section.settings.blurb_valign, fill: section.settings.blurb_fill, size: section.settings.blurb_size, depth: section.settings.blurb_depth, amount: section.settings.blurb_depth_amount %}">{{ section.settings.blurb }}</p>
      </div>
      <div>
        <p class="kicker">Shop</p>
        {% if section.settings.menu != blank %}
          {% for link in section.settings.menu.links %}
            <a class="nav-link" href="{{ link.url }}">{{ link.title }}</a>
          {% endfor %}
        {% else %}
          <a class="nav-link" href="{{ routes.all_products_collection_url }}">All wax</a>
          <a class="nav-link" href="{{ routes.root_url }}#shopify-section-breaks">Breaks</a>
          <a class="nav-link" href="{{ routes.cart_url }}">Cart</a>
        {% endif %}
      </div>
      <div>
        <p class="kicker">Shows</p>
        <a class="nav-link" href="{{ routes.root_url }}#shopify-section-live">Live stage</a>
        <a class="nav-link" href="{{ routes.root_url }}#shopify-section-auctions">Auctions</a>
        {% if settings.whatnot_url != blank %}
          <a class="btn btn-ghost" style="margin-top:0.6rem" href="{{ settings.whatnot_url }}" target="_blank" rel="noreferrer">Whatnot room</a>
        {% endif %}
      </div>
    </div>
    <p class="fine foot-copy">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. Crystal Coast.</p>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "textarea",
      "id": "blurb",
      "label": "Blurb",
      "default": "Online-only from the Crystal Coast. Sealed wax, breaks, and live shows."
    },
    {
      "type": "select",
      "id": "blurb_font",
      "label": "Blurb font",
      "default": "inherit",
      "options": [
        {
          "value": "inherit",
          "label": "Theme default"
        },
        {
          "value": "Unbounded, sans-serif",
          "label": "Unbounded"
        },
        {
          "value": "Outfit, sans-serif",
          "label": "Outfit"
        },
        {
          "value": "\"Barlow Condensed\", sans-serif",
          "label": "Barlow Condensed"
        },
        {
          "value": "\"Bebas Neue\", sans-serif",
          "label": "Bebas Neue"
        },
        {
          "value": "Oswald, sans-serif",
          "label": "Oswald"
        },
        {
          "value": "Anton, sans-serif",
          "label": "Anton"
        },
        {
          "value": "Archivo, sans-serif",
          "label": "Archivo"
        },
        {
          "value": "Inter, sans-serif",
          "label": "Inter"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "blurb_bold",
      "label": "Blurb bold",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "blurb_italic",
      "label": "Blurb italic",
      "default": false
    },
    {
      "type": "select",
      "id": "blurb_align",
      "label": "Blurb horizontal",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Theme default"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "blurb_valign",
      "label": "Blurb vertical",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Theme default"
        },
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "middle",
          "label": "Middle"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "select",
      "id": "blurb_fill",
      "label": "Blurb fill",
      "default": "solid",
      "options": [
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "tide",
          "label": "Tide"
        },
        {
          "value": "violet",
          "label": "Violet"
        },
        {
          "value": "foil",
          "label": "Foil"
        },
        {
          "value": "sunset",
          "label": "Sunset"
        },
        {
          "value": "aurora",
          "label": "Aurora"
        },
        {
          "value": "pulse",
          "label": "Neon pulse"
        },
        {
          "value": "custom",
          "label": "Custom gradient"
        }
      ],
      "info": "Gradient is painted on the letters. Solid uses the color above."
    },
    {
      "type": "range",
      "id": "blurb_size",
      "label": "Blurb size",
      "min": 10,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "select",
      "id": "blurb_depth",
      "label": "Blurb depth",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "soft",
          "label": "Soft shadow"
        },
        {
          "value": "hard",
          "label": "Hard offset"
        },
        {
          "value": "lift",
          "label": "Lift"
        },
        {
          "value": "long",
          "label": "Long shadow"
        },
        {
          "value": "echo",
          "label": "Echo"
        },
        {
          "value": "press",
          "label": "Letterpress"
        },
        {
          "value": "emboss",
          "label": "Emboss"
        },
        {
          "value": "outline",
          "label": "Outline"
        },
        {
          "value": "neon",
          "label": "Neon glow"
        },
        {
          "value": "double",
          "label": "Double glow"
        },
        {
          "value": "foil",
          "label": "Foil"
        }
      ]
    },
    {
      "type": "range",
      "id": "blurb_depth_amount",
      "label": "Blurb depth amount",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    }
  ]
}
{% endschema %}

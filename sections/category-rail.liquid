<section class="section" style="padding-top:0">
  <div class="wrap" style="--rail-w: {{ section.settings.card_width }}px">
    <div class="rail">
      {% for block in section.blocks %}
        {% liquid
          if block.settings.collection != blank
            assign href = block.settings.collection.url
          else
            assign q = block.settings.title | url_encode
            assign href = routes.search_url | append: '?type=product&q=' | append: q
          endif
        %}
        <a class="panel rail-card" href="{{ href }}" {{ block.shopify_attributes }}>
          {% capture label_style %}{% render 'field-style', font: block.settings.title_font, color: block.settings.title_color, size: block.settings.title_size, depth: block.settings.title_depth, amount: block.settings.title_depth_amount, shadow: block.settings.title_depth_color %}{% endcapture %}
          {% render 'wax', style: block.settings.style, label: block.settings.title, label_style: label_style %}
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Category rail",
  "settings": [
    {
      "type": "range",
      "id": "card_width",
      "label": "Card width",
      "min": 96,
      "max": 220,
      "step": 4,
      "unit": "px",
      "default": 134
    }
  ],
  "blocks": [
    {
      "type": "cat",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Label",
          "default": "Hockey"
        },
        {
          "type": "select",
          "id": "title_font",
          "label": "Label font",
          "default": "inherit",
          "options": [
            {
              "value": "inherit",
              "label": "Theme default"
            },
            {
              "value": "Unbounded, sans-serif",
              "label": "Unbounded"
            },
            {
              "value": "Outfit, sans-serif",
              "label": "Outfit"
            },
            {
              "value": "\"Barlow Condensed\", sans-serif",
              "label": "Barlow Condensed"
            },
            {
              "value": "\"Bebas Neue\", sans-serif",
              "label": "Bebas Neue"
            },
            {
              "value": "Oswald, sans-serif",
              "label": "Oswald"
            },
            {
              "value": "Anton, sans-serif",
              "label": "Anton"
            },
            {
              "value": "Archivo, sans-serif",
              "label": "Archivo"
            },
            {
              "value": "Inter, sans-serif",
              "label": "Inter"
            }
          ]
        },
        {
          "type": "color",
          "id": "title_color",
          "label": "Label color",
          "default": "#e7f6fb"
        },
        {
          "type": "range",
          "id": "title_size",
          "label": "Label size",
          "min": 10,
          "max": 96,
          "step": 2,
          "unit": "px",
          "default": 16
        },
        {
          "type": "select",
          "id": "title_depth",
          "label": "Label depth",
          "default": "none",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "soft",
              "label": "Soft shadow"
            },
            {
              "value": "hard",
              "label": "Hard offset"
            },
            {
              "value": "lift",
              "label": "Lift"
            },
            {
              "value": "long",
              "label": "Long shadow"
            },
            {
              "value": "echo",
              "label": "Echo"
            },
            {
              "value": "press",
              "label": "Letterpress"
            },
            {
              "value": "emboss",
              "label": "Emboss"
            },
            {
              "value": "outline",
              "label": "Outline"
            },
            {
              "value": "neon",
              "label": "Neon glow"
            },
            {
              "value": "double",
              "label": "Double glow"
            },
            {
              "value": "foil",
              "label": "Foil"
            }
          ]
        },
        {
          "type": "range",
          "id": "title_depth_amount",
          "label": "Label depth amount",
          "min": 0,
          "max": 40,
          "step": 2,
          "unit": "px",
          "default": 8
        },
        {
          "type": "color",
          "id": "title_depth_color",
          "label": "Label depth color",
          "default": "#00e5ff"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Wax style",
          "default": "ice",
          "options": [
            {
              "value": "ice",
              "label": "Ice"
            },
            {
              "value": "gold",
              "label": "Gold"
            },
            {
              "value": "crystal",
              "label": "Crystal"
            }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category rail",
      "blocks": [
        {
          "type": "cat",
          "settings": {
            "title": "Hockey",
            "style": "ice"
          }
        },
        {
          "type": "cat",
          "settings": {
            "title": "Football",
            "style": "gold"
          }
        },
        {
          "type": "cat",
          "settings": {
            "title": "NASCAR",
            "style": "crystal"
          }
        },
        {
          "type": "cat",
          "settings": {
            "title": "Baseball",
            "style": "ice"
          }
        },
        {
          "type": "cat",
          "settings": {
            "title": "Pok\u00e9mon",
            "style": "crystal"
          }
        },
        {
          "type": "cat",
          "settings": {
            "title": "Yu-Gi-Oh!",
            "style": "gold"
          }
        },
        {
          "type": "cat",
          "settings": {
            "title": "Magic",
            "style": "ice"
          }
        }
      ]
    }
  ]
}
{% endschema %}

{% render 'section-bg', section: section %}
<section class="section" style="padding-top: {{ section.settings.pad_top }}px; padding-bottom: {{ section.settings.pad_bottom }}px;">
  <div class="wrap" style="--rail-w: {{ section.settings.card_width }}px">
    <div class="rail">
      {% for block in section.blocks %}
        {% liquid
          if block.settings.collection != blank
            assign href = block.settings.collection.url
          else
            assign q = block.settings.title | url_encode
            assign href = routes.search_url | append: '?type=product&q=' | append: q
          endif
        %}
        <a class="panel rail-card" href="{{ href }}" {{ block.shopify_attributes }}>
          {% capture label_style %}{% render 'field-style', font: block.settings.title_font, bold: block.settings.title_bold, italic: block.settings.title_italic, align: block.settings.title_align, valign: block.settings.title_valign, fill: block.settings.title_fill, fill_2: block.settings.title_fill_2, color: block.settings.title_color, size: block.settings.title_size, depth: block.settings.title_depth, amount: block.settings.title_depth_amount, shadow: block.settings.title_depth_color %}{% endcapture %}
          {% render 'wax', style: block.settings.style, label: block.settings.title, label_style: label_style %}
        </a>
      {% endfor %}
    </div>
  </div>
</section>


{% render 'section-bg', section: section %}
<section class="section" style="padding-top: {{ section.settings.pad_top }}px; padding-bottom: {{ section.settings.pad_bottom }}px;">
  <div class="wrap">
    <div class="rail">
      {% for block in section.blocks %}
        {% liquid
          if block.settings.collection != blank
            assign href = block.settings.collection.url
          else
            assign q = block.settings.title | url_encode
            assign href = routes.search_url | append: '?type=product&q=' | append: q
          endif
        %}
        <a class="panel rail-card" href="{{ href }}" {{ block.shopify_attributes }}>
          {% render 'wax', style: block.settings.style, label: block.settings.title %}
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Category rail",
  "settings": [
    {
      "type": "select",
      "id": "edit_group",
      "label": "Edit",
      "default": "background",
      "options": [
        {
          "value": "background",
          "label": "Background"
        },
        {
          "value": "section_space",
          "label": "Section space"
        }
      ],
      "info": "Opens that group. Pick another title to switch."
    },
    {
      "type": "header",
      "content": "Background",
      "visible_if": "{{ section.settings.edit_group == 'background' }}"
    },
    {
      "type": "select",
      "id": "sec_fill",
      "label": "Fill",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "solid",
          "label": "Solid"
        },
        {
          "value": "tide",
          "label": "Tide"
        },
        {
          "value": "violet",
          "label": "Violet night"
        },
        {
          "value": "foil",
          "label": "Foil sweep"
        },
        {
          "value": "sunset",
          "label": "Sunset"
        },
        {
          "value": "aurora",
          "label": "Aurora"
        },
        {
          "value": "pulse",
          "label": "Neon pulse"
        },
        {
          "value": "glass",
          "label": "Glass"
        },
        {
          "value": "mesh",
          "label": "Mesh glow"
        },
        {
          "value": "custom",
          "label": "Custom gradient"
        }
      ],
      "info": "None leaves the section as it is. Foil, Aurora, and Neon pulse animate.",
      "visible_if": "{{ section.settings.edit_group == 'background' }}"
    },
    {
      "type": "color",
      "id": "sec_fill_color",
      "label": "Fill color",
      "default": "#0E1C28",
      "info": "Solid, glass, mesh, and custom gradient.",
      "visible_if": "{{ section.settings.edit_group == 'background' }}"
    },
    {
      "type": "color",
      "id": "sec_fill_color_2",
      "label": "Second color",
      "default": "#00E5FF",
      "info": "Used by Custom gradient.",
      "visible_if": "{{ section.settings.edit_group == 'background' }}"
    },
    {
      "type": "range",
      "id": "sec_angle",
      "label": "Gradient angle",
      "min": 0,
      "max": 360,
      "step": 15,
      "unit": "deg",
      "default": 90,
      "info": "Used by Custom gradient.",
      "visible_if": "{{ section.settings.edit_group == 'background' }}"
    },
    {
      "type": "select",
      "id": "sec_preset",
      "label": "Image preset",
      "default": "none",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "deep-tide",
          "label": "Deep tide"
        },
        {
          "value": "horizon",
          "label": "Neon horizon"
        },
        {
          "value": "foil-sweep",
          "label": "Foil sweep"
        },
        {
          "value": "nebula",
          "label": "Violet nebula"
        },
        {
          "value": "grid",
          "label": "Night grid"
        },
        {
          "value": "bubbles",
          "label": "Bubble field"
        },
        {
          "value": "aurora-sheet",
          "label": "Aurora sheet"
        },
        {
          "value": "slab",
          "label": "Slab glow"
        },
        {
          "value": "storm",
          "label": "Storm glass"
        }
      ],
      "info": "Painted art behind the section. Foil sweep and Aurora sheet animate.",
      "visible_if": "{{ section.settings.edit_group == 'background' }}"
    },
    {
      "type": "image_picker",
      "id": "sec_image",
      "label": "Background image",
      "info": "Optional photo. Sits on top of the fill and preset.",
      "visible_if": "{{ section.settings.edit_group == 'background' }}"
    },
    {
      "type": "header",
      "content": "Section space",
      "visible_if": "{{ section.settings.edit_group == 'section_space' }}"
    },
    {
      "type": "range",
      "id": "pad_top",
      "label": "Top space",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 0,
      "info": "Space above this row. Zero keeps it tight under the header.",
      "visible_if": "{{ section.settings.edit_group == 'section_space' }}"
    },
    {
      "type": "range",
      "id": "pad_bottom",
      "label": "Bottom space",
      "min": 0,
      "max": 200,
      "step": 2,
      "unit": "px",
      "default": 52,
      "info": "Space below this row.",
      "visible_if": "{{ section.settings.edit_group == 'section_space' }}"
    }
  ],
  "blocks": [
    {
      "type": "cat",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Label",
          "default": "Hockey"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Wax style",
          "default": "ice",
          "options": [
            {
              "value": "ice",
              "label": "Ice"
            },
            {
              "value": "gold",
              "label": "Gold"
            },
            {
              "value": "crystal",
              "label": "Crystal"
            }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Category rail",
      "blocks": [
        {
          "type": "cat",
          "settings": {
            "title": "Hockey",
            "style": "ice"
          }
        },
        {
          "type": "cat",
          "settings": {
            "title": "Football",
            "style": "gold"
          }
        },
        {
          "type": "cat",
          "settings": {
            "title": "NASCAR",
            "style": "crystal"
          }
        },
        {
          "type": "cat",
          "settings": {
            "title": "Baseball",
            "style": "ice"
          }
        },
        {
          "type": "cat",
          "settings": {
            "title": "Pokémon",
            "style": "crystal"
          }
        },
        {
          "type": "cat",
          "settings": {
            "title": "Yu-Gi-Oh!",
            "style": "gold"
          }
        },
        {
          "type": "cat",
          "settings": {
            "title": "Magic",
            "style": "ice"
          }
        }
      ]
    }
  ]
}
{% endschema %}

{% liquid
  assign fill = section.settings.sec_fill | default: 'none'
  assign preset = section.settings.sec_preset | default: 'none'
  assign paint = section.settings.sec_fill_color | default: '#0E1C28'
  assign paint2 = section.settings.sec_fill_color_2 | default: '#00E5FF'
  assign angle = section.settings.sec_angle | default: 90
  assign photo = section.settings.sec_image
  assign motion = section.settings.sec_image_motion | default: 'none'
  assign speed = section.settings.sec_fill_speed | default: 1
  assign custom_dur = section.settings.sec_fill_duration | default: 0
  assign power = section.settings.sec_fill_power | default: 5
  if speed < 1
    assign speed = 1
  endif
  assign use_motion = false
  if photo != blank and motion != blank and motion != 'none'
    assign use_motion = true
  endif
%}
{% if fill != 'none' or preset != 'none' or photo != blank %}
  {% capture grad %}{% endcapture %}
  {% case preset %}
    {% when 'deep-tide' %}{% capture grad %}radial-gradient(90% 70% at 50% 110%, #00e5ff 0%, transparent 46%), radial-gradient(70% 50% at 0% 0%, #12323c 0%, transparent 55%), linear-gradient(#041018, #071820){% endcapture %}
    {% when 'horizon' %}{% capture grad %}linear-gradient(#041018 0 42%, #00e5ff 42% 44%, #e4c06a 44% 46%, #041018 46%){% endcapture %}
    {% when 'foil-sweep' %}{% capture grad %}linear-gradient(105deg, #6b5424, #e4c06a 28%, #fff6d0 48%, #e4c06a 62%, #8a6a2f){% endcapture %}
    {% when 'nebula' %}{% capture grad %}radial-gradient(60% 80% at 20% 30%, #6d1ecc 0%, transparent 55%), radial-gradient(50% 60% at 80% 70%, #00e5ff 0%, transparent 50%), linear-gradient(#070612, #12061f){% endcapture %}
    {% when 'grid' %}{% capture grad %}linear-gradient(#00e5ff 1px, transparent 1px), linear-gradient(90deg, #00e5ff 1px, transparent 1px), linear-gradient(#071018, #071018){% endcapture %}
    {% when 'bubbles' %}{% capture grad %}radial-gradient(circle at 18% 30%, color-mix(in srgb, #7af6ff 70%, transparent) 0 18px, transparent 19px), radial-gradient(circle at 70% 22%, color-mix(in srgb, #00e5ff 55%, transparent) 0 28px, transparent 29px), radial-gradient(circle at 40% 72%, color-mix(in srgb, #b388ff 50%, transparent) 0 22px, transparent 23px), radial-gradient(circle at 82% 68%, color-mix(in srgb, #7af6ff 40%, transparent) 0 14px, transparent 15px), linear-gradient(#04141c, #071820){% endcapture %}
    {% when 'aurora-sheet' %}{% capture grad %}linear-gradient(100deg, #041018, #00e5ff 28%, #6d1ecc 58%, #041820){% endcapture %}
    {% when 'slab' %}{% capture grad %}linear-gradient(#0e1c28, #0e1c28){% endcapture %}
    {% when 'storm' %}{% capture grad %}radial-gradient(80% 40% at 50% 0%, color-mix(in srgb, #7af6ff 35%, transparent), transparent 60%), repeating-linear-gradient(115deg, transparent 0 10px, color-mix(in srgb, #00e5ff 16%, transparent) 10px 11px), linear-gradient(#071018, #12061f){% endcapture %}
  {% endcase %}
  {% if preset == 'none' %}
    {% case fill %}
      {% when 'tide' %}{% capture grad %}linear-gradient(90deg, #042028, #00e5ff 42%, #7af6ff 50%, #00e5ff 58%, #042028){% endcapture %}
      {% when 'violet' %}{% capture grad %}linear-gradient(100deg, #12061f, #6d1ecc 46%, #00e5ff){% endcapture %}
      {% when 'foil' %}{% capture grad %}linear-gradient(105deg, #6b5424, #e4c06a 28%, #fff6d0 48%, #e4c06a 62%, #8a6a2f){% endcapture %}
      {% when 'sunset' %}{% capture grad %}linear-gradient(90deg, #3a1020, #ff5a7a 35%, #e4c06a 68%, #6d1ecc){% endcapture %}
      {% when 'aurora' %}{% capture grad %}linear-gradient(100deg, #041018, #00e5ff 28%, #6d1ecc 58%, #041820){% endcapture %}
      {% when 'pulse' %}{% capture grad %}linear-gradient(90deg, #00e5ff, #6d1ecc, #00e5ff){% endcapture %}
      {% when 'lava' %}{% capture grad %}linear-gradient(100deg, #3a1020, #ff5a7a 30%, #e4c06a 55%, #00e5ff 78%, #12061f){% endcapture %}
      {% when 'chrome' %}{% capture grad %}linear-gradient(100deg, #1a2830, #9fb4c0 25%, #ffffff 42%, #7af6ff 58%, #c5d4de 75%, #1a2830){% endcapture %}
      {% when 'prism' %}{% capture grad %}linear-gradient(90deg, #041018, #7af6ff 20%, #b388ff 40%, #ffe08a 60%, #ff8fa3 80%, #041018){% endcapture %}
      {% when 'electric' %}{% capture grad %}linear-gradient(90deg, #041018, #00e5ff 35%, #ffffff 50%, #b388ff 65%, #041018){% endcapture %}
      {% when 'holo' %}{% capture grad %}linear-gradient(115deg, #041018, #7af6ff 22%, #e4d4ff 40%, #fff6d0 55%, #00e5ff 72%, #ff8fa3 88%, #041018){% endcapture %}
      {% when 'wave' %}{% capture grad %}linear-gradient(90deg, #042028, #00e5ff 30%, #7af6ff 48%, #ffffff 50%, #00e5ff 52%, #042028){% endcapture %}
      {% when 'goldrush' %}{% capture grad %}linear-gradient(100deg, #1a1408, #6b5424 20%, #fff6d0 42%, #e4c06a 58%, #ffffff 70%, #8a6a2f){% endcapture %}
      {% when 'current' %}{% capture grad %}linear-gradient(90deg, #041018, #0e3a44 20%, #00e5ff 40%, #042028 55%, #6d1ecc 75%, #041018){% endcapture %}
      {% when 'ember' %}{% capture grad %}linear-gradient(100deg, #14060c, #ff5a7a 28%, #3a1020 48%, #e4c06a 68%, #14060c){% endcapture %}
      {% when 'sheen' %}{% capture grad %}linear-gradient(110deg, #041018 0%, #041018 40%, #7af6ff 48%, #ffffff 50%, #7af6ff 52%, #041018 60%, #041018 100%){% endcapture %}
      {% when 'mesh' %}{% capture grad %}radial-gradient(circle at 15% 50%, color-mix(in srgb, {{ paint }} 70%, transparent), transparent 42%), radial-gradient(circle at 80% 40%, color-mix(in srgb, {{ paint2 }} 75%, transparent), transparent 46%){% endcapture %}
      {% when 'custom' %}{% capture grad %}linear-gradient({{ angle }}deg, {{ paint }}, {{ paint2 }}){% endcapture %}
    {% endcase %}
  {% endif %}
  {% assign grad = grad | strip %}
  {% assign movers = 'foil,aurora,pulse,lava,chrome,prism,electric,holo,wave,goldrush,current,ember,sheen' | split: ',' %}
  {% assign sweep = false %}
  {% if preset == 'foil-sweep' or preset == 'aurora-sheet' %}{% assign sweep = true %}{% endif %}
  {% if preset == 'none' and movers contains fill %}{% assign sweep = true %}{% endif %}
  {% assign base = 9 %}
  {% case fill %}
    {% when 'pulse' %}{% assign base = 6 %}
    {% when 'electric' %}{% assign base = 2 %}
    {% when 'chrome' %}{% assign base = 5 %}
    {% when 'goldrush' %}{% assign base = 4 %}
    {% when 'sheen' %}{% assign base = 4 %}
    {% when 'lava' %}{% assign base = 7 %}
    {% when 'prism' %}{% assign base = 8 %}
    {% when 'ember' %}{% assign base = 8 %}
    {% when 'wave' %}{% assign base = 10 %}
    {% when 'aurora' %}{% assign base = 12 %}
    {% when 'current' %}{% assign base = 14 %}
    {% when 'foil' %}{% assign base = 9 %}
  {% endcase %}
  {% if preset == 'aurora-sheet' %}{% assign base = 12 %}{% endif %}
  {% if preset == 'foil-sweep' and custom_dur == 0 %}{% assign base = 9 %}{% endif %}
  {% if custom_dur > 0 %}{% assign base = custom_dur %}{% endif %}
  {% assign span = power | times: 28 | plus: 100 %}
  {% style %}
    #shopify-section-{{ section.id }} {
      position: relative;
      isolation: isolate;
      {% unless use_motion %}
        {% if fill == 'solid' %}background-color: {{ paint }};
        {% elsif fill == 'glass' %}background-color: color-mix(in srgb, {{ paint }} 22%, transparent);
        {% elsif fill == 'mesh' %}background-color: {{ paint }};
        {% endif %}
        {% if photo != blank and grad != blank %}
          background-image: url({{ photo | image_url: width: 2000 }}), {{ grad }};
          background-size: cover, {% if preset == 'grid' %}28px 28px, 28px 28px, cover{% else %}cover{% endif %};
          background-position: center, center;
          background-repeat: no-repeat;
        {% elsif photo != blank %}
          background-image: url({{ photo | image_url: width: 2000 }});
          background-size: cover;
          background-position: center;
          background-repeat: no-repeat;
        {% elsif grad != blank %}
          background-image: {{ grad }};
          {% if preset == 'grid' %}
            background-size: 28px 28px, 28px 28px, cover;
          {% elsif sweep %}
            background-size: {{ span }}% 100%;
          {% else %}
            background-size: cover;
          {% endif %}
          background-position: center;
        {% endif %}
        {% if photo == blank and sweep %}
          animation: fill-pan calc({{ base }}s / {{ speed }}) linear infinite;
        {% endif %}
        {% if preset == 'slab' %}
          box-shadow: inset 0 0 0 1px #00eaff, inset 0 0 40px color-mix(in srgb, #00e5ff 28%, transparent);
        {% endif %}
      {% endunless %}
    }
  {% endstyle %}
  {% if use_motion %}
    <div class="sec-bg-clip" aria-hidden="true">
      {% if fill == 'solid' or fill == 'glass' or fill == 'mesh' or grad != blank %}
        <div class="sec-bg-fill" style="{% if fill == 'solid' or fill == 'mesh' %}background-color: {{ paint }};{% elsif fill == 'glass' %}background-color: color-mix(in srgb, {{ paint }} 22%, transparent);{% endif %}{% if grad != blank %}background-image: {{ grad }};{% if preset == 'grid' %}background-size: 28px 28px, 28px 28px, cover;{% elsif sweep %}background-size: {{ span }}% 100%; animation: fill-pan calc({{ base }}s / {{ speed }}) linear infinite;{% else %}background-size: cover;{% endif %}{% endif %}"></div>
      {% endif %}
      <div class="sec-bg-photo is-{{ motion }}" style="background-image: url({{ photo | image_url: width: 2000 }});"></div>
      {% if motion == 'sheen' or motion == 'tide' or motion == 'spotlight' %}
        <div class="sec-bg-fx is-{{ motion }}"></div>
      {% endif %}
    </div>
  {% endif %}
{% endif %}

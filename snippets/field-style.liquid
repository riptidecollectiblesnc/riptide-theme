{%- comment -%} color, size, depth, amount, shadow {%- endcomment -%}
{%- liquid
  assign paint = color | default: settings.color_fg
  assign px = size | default: 0
  assign d = depth | default: 'none'
  assign n = amount | default: 0
  assign glow = shadow | default: settings.color_neon | default: paint
  assign fill_2 = fill_2 | default: settings.color_neon
-%}
{%- if font != blank and font != 'inherit' -%}{%- assign safe_font = font | replace: '"', "'" -%}font-family: {{ safe_font }};{%- if font contains 'Bebas' or font contains 'Anton' -%}font-weight: 400;{%- endif -%}{%- endif -%}
{%- if bold -%}font-weight: 700;{%- endif -%}
{%- if italic -%}font-style: italic;{%- endif -%}
{%- if align == 'left' or align == 'center' or align == 'right' -%}text-align: {{ align }};{%- endif -%}
{%- if valign == 'top' -%}margin-top: 0; margin-bottom: auto;{%- elsif valign == 'middle' -%}margin-top: auto; margin-bottom: auto;{%- elsif valign == 'bottom' -%}margin-top: auto; margin-bottom: 0;{%- endif -%}
{%- if fill != blank and fill != 'solid' -%}
  {%- if fill == 'tide' -%}background-image: linear-gradient(90deg, #7af6ff, #ffffff 45%, #00e5ff);
  {%- elsif fill == 'violet' -%}background-image: linear-gradient(100deg, #e4d4ff, #9b6dff 46%, #00e5ff);
  {%- elsif fill == 'foil' -%}background-image: linear-gradient(105deg, #8a6a2f, #fff6d0 42%, #e4c06a 70%, #fff); background-size: 220% 100%; animation: fill-pan 9s linear infinite;
  {%- elsif fill == 'sunset' -%}background-image: linear-gradient(90deg, #ff8fa3, #ffe08a 55%, #fff);
  {%- elsif fill == 'aurora' -%}background-image: linear-gradient(100deg, #7af6ff, #d7c4ff 50%, #00e5ff); background-size: 220% 100%; animation: fill-pan 12s linear infinite;
  {%- elsif fill == 'pulse' -%}background-image: linear-gradient(90deg, #00e5ff, #ffffff, #b388ff); background-size: 220% 100%; animation: fill-pan 6s linear infinite;
  {%- else -%}background-image: linear-gradient(90deg, {{ paint | default: '#f4fbff' }}, {{ fill_2 | default: '#00e5ff' }});
  {%- endif -%}
  -webkit-background-clip: text; background-clip: text; color: transparent; -webkit-text-fill-color: transparent;
{%- elsif paint != blank -%}color: {{ paint }}; -webkit-text-fill-color: {{ paint }}; background-image: none;
{%- endif -%}
{%- if px > 0 -%}font-size: {{ px }}px;{%- endif -%}
{%- if d == 'soft' and n > 0 -%}text-shadow: 0 {{ n | times: 0.4 }}px {{ n }}px {{ glow }};
{%- elsif d == 'hard' and n > 0 -%}text-shadow: {{ n | times: 0.35 }}px {{ n | times: 0.35 }}px 0 {{ glow }};
{%- elsif d == 'neon' and n > 0 -%}text-shadow: 0 0 {{ n | times: 0.45 }}px {{ glow }}, 0 0 {{ n }}px {{ glow }};
{%- elsif d == 'double' and n > 0 -%}text-shadow: 0 0 {{ n | times: 0.3 }}px {{ glow }}, 0 0 {{ n }}px {{ glow }}, 0 0 {{ n | times: 2 }}px {{ glow }};
{%- elsif d == 'long' and n > 0 -%}
  {%- capture chain -%}
    {%- for i in (1..8) -%}
      {%- assign step = n | times: i | divided_by: 4 -%}
      {%- if step < 1 -%}{% assign step = i %}{%- endif -%}
      {{ step }}px {{ step }}px 0 {{ glow }}{%- unless forloop.last -%}, {%- endunless -%}
    {%- endfor -%}
  {%- endcapture -%}
  text-shadow: {{ chain | strip_newlines }};
{%- elsif d == 'echo' and n > 0 -%}text-shadow: {{ n }}px {{ n }}px 0 {{ glow }}, {{ n | times: 2 }}px {{ n | times: 2 }}px 0 {{ glow }};
{%- elsif d == 'lift' and n > 0 -%}text-shadow: 0 1px 0 color-mix(in srgb, {{ glow }} 50%, black), 0 {{ n }}px {{ n | times: 1.6 }}px {{ glow }};
{%- elsif d == 'press' and n > 0 -%}text-shadow: 0 {{ n }}px 0 color-mix(in srgb, white 75%, transparent), 0 -1px 0 color-mix(in srgb, black 55%, transparent);
{%- elsif d == 'emboss' and n > 0 -%}text-shadow: 0 -{{ n }}px 0 color-mix(in srgb, white 70%, transparent), 0 {{ n }}px 0 color-mix(in srgb, black 50%, transparent);
{%- elsif d == 'outline' and n > 0 -%}
  {%- assign stroke = n | divided_by: 8 -%}
  {%- if stroke < 1 -%}{% assign stroke = 1 %}{%- endif -%}
  -webkit-text-stroke: {{ stroke }}px {{ glow }}; paint-order: stroke fill;
{%- elsif d == 'foil' and n > 0 -%}text-shadow: 0 1px 0 #fff6d0, 0 {{ n }}px 0 #e4c06a, 0 {{ n | times: 2 }}px {{ n }}px #8a6a2f;
{%- endif -%}
